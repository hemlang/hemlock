// Hash functions test
import { crc32, adler32, sha1, sha256, sha512, md5 } from "@stdlib/hash";

// CRC32
print(crc32(""));
print(crc32("hello"));
print(crc32("The quick brown fox"));

// Adler32
print(adler32(""));
print(adler32("hello"));
print(adler32("The quick brown fox"));

// SHA1
print(sha1("hello"));
print(sha1(""));
print(sha1("The quick brown fox"));

// SHA256
print(sha256("hello"));
print(sha256(""));
print(sha256("The quick brown fox"));

// SHA512
print(sha512("hello").slice(0, 32));  // First 32 chars to keep output manageable

// MD5
print(md5("hello"));
print(md5(""));
