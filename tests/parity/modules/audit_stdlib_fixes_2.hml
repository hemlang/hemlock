// Regression coverage for stdlib fixes (part 2).
import { resolve, parse as url_parse } from "@stdlib/url";
import { tanh, hypot } from "@stdlib/math";
import { parse as toml_parse } from "@stdlib/toml";
import { from_utc, parse_iso } from "@stdlib/datetime";

let base = "http://a/b/c/d;p?q";
for (r in ["g/", "..", ".", "", "/../g", "./g/.", "g?y#s"]) { print(r + " => " + resolve(base, r)); }
let mail = url_parse("mailto:x@y.com");
print(mail.scheme + "|" + mail.path);

print(tanh(1000.0) == 1.0);
print(hypot(1e200, 1e200) > 1e200);

let t = toml_parse("a = inf\nb = -inf\nc = +3\n[[f]]\nn = 1\n[f.p]\nq = 2\n");
print(t.a > 1e308);
print(t.b < -1e308);
print(t.c);
print(t.f[0].p.q);

print(from_utc(2024, 1, 1).timestamp);
print(parse_iso("2024-01-01T02:00:00+02:00").timestamp);
try { parse_iso("2024-13-45"); } catch (e) { print("bad date rejected"); }
