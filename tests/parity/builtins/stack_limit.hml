// Test: Stack limit control functions
// Tests get_stack_limit() and set_stack_limit()
import { set_stack_limit, get_stack_limit } from "@stdlib/debug";

let initial = get_stack_limit();
print(initial > 0);

set_stack_limit(5000);
let updated = get_stack_limit();
print(updated);

// Restore original
set_stack_limit(initial);
print(get_stack_limit() == initial);
