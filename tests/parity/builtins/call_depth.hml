// Test: Call depth tracking catches infinite recursion
// Verifies stack overflow produces a catchable error in both backends

fn recurse(n: i32): i32 {
    return recurse(n + 1);
}

try {
    recurse(0);
} catch (e) {
    // The interpreter prefixes runtime errors with their source location
    // (file:line plus a snippet); compiled code does not. Compare the message.
    let at = e.find("Maximum call stack depth exceeded");
    print(at >= 0 ? e.substr(at).split("\n")[0] : "unexpected: " + e);
}
