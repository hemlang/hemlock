// Test thread configuration APIs (get/set default stack size)

// Test 1: get_default_stack_size returns the default (16 MB)
let default_size = __get_default_stack_size();
print(default_size);  // 16777216

// Test 2: set_default_stack_size changes the default
__set_default_stack_size(8 * 1024 * 1024);
let new_size = __get_default_stack_size();
print(new_size);  // 8388608

// Test 3: spawn uses the new default (verify it works, not the actual size)
async fn compute(n) {
    let sum = 0;
    for (let i = 0; i < n; i++) {
        sum = sum + i;
    }
    return sum;
}

let task = spawn(compute, 5);
let result = join(task);
print(result);  // 10

// Test 4: Restore original default
__set_default_stack_size(16 * 1024 * 1024);
let restored = __get_default_stack_size();
print(restored);  // 16777216

// Test 5: set with large value (32 MB)
__set_default_stack_size(32 * 1024 * 1024);
print(__get_default_stack_size());  // 33554432

// Restore for clean state
__set_default_stack_size(16 * 1024 * 1024);

print("done");
