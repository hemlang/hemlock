// Test: pointer subtraction (ptr - integer)
let p = alloc(32);
ptr_write_i32(p, 100);
ptr_write_i32(ptr_offset(p, 1, 4), 200);
ptr_write_i32(ptr_offset(p, 2, 4), 300);

// ptr + integer to get offset
let p2 = ptr_offset(p, 2, 4);
print(ptr_deref_i32(p2));

// ptr - integer to go back
let p1 = p2 - 4;
print(ptr_deref_i32(p1));

let p0 = p2 - 8;
print(ptr_deref_i32(p0));

free(p);
