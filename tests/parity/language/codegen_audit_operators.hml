// Regression tests for operator/expression codegen audit fixes:
// - string concat chains must stay left-associative (1 + 2 + "x" is "3x")
// - unsigned shifts must shift logically and keep their type
// - mixed-type ternaries must not collapse to one native type
// - rune-typed lets keep the rune type tag
// - indexing an unindexable type throws (catchable)
// - `i = i + 1` for-counters throw on i32 overflow (unlike `i++`, which wraps)

// Concat chain left-associativity
let a = 1;
let b = 2;
print(a + b + "x");
print(a + b + "x" + a + b);
print("y" + a + b);

fn concat_fn() {
    let c = 3;
    let d = 4;
    print(c + d + "z");
}
concat_fn();

// Unsigned shift semantics
fn shifts() {
    let hi: u64 = 9223372036854775808;
    let one: u64 = 1;
    let r = hi >> one;
    print(r);
    print(typeof(r));
    print(hi >> 1);

    let u: u32 = 2147483648;
    let s: u32 = 1;
    let r2 = u >> s;
    print(r2);
    print(typeof(r2));
}
shifts();

// Ternary with mixed branch types keeps dynamic typing
fn ternary() {
    let c = 1 < 2;
    let x = c ? true : 5;
    print(x);
    print(typeof(x));
}
ternary();

// Rune-typed inference keeps the rune tag
fn runes() {
    let ch = 'A';
    print(ch);
    print(typeof(ch));
}
runes();

// Indexing an unindexable value throws (catchable)
let n = 42;
try {
    print(n[0]);
} catch (e) {
    print("caught index error");
}

// i32 overflow in `i = i + 1` for-loop counters throws; the loop body count
// before the throw must match the interpreter
fn counter_overflow() {
    let count = 0;
    try {
        for (let i = 2147483645; i != -2147483646; i = i + 1) {
            count = count + 1;
        }
    } catch (e) {
        print("caught: " + e);
    }
    print(count);
}
counter_overflow();
