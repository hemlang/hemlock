// Test: nested function calls with inlining don't corrupt variables
// This tests the case where inlined param names shadow outer variables

fn mul(a: f64, b: f64): f64 {
    return a * b;
}

fn add(a: f64, b: f64): f64 {
    return a + b;
}

fn inner(a: ptr, b: ptr, idx: i32): f64 {
    let ax = ptr_deref_f64(ptr_offset(a, idx, 8));
    let bx = ptr_deref_f64(ptr_offset(b, idx, 8));
    return mul(ax, bx);
}

let n = 3;
let a = alloc(n * 8);
let b = alloc(n * 8);

for (let i = 0; i < n; i++) {
    ptr_write_f64(ptr_offset(a, i, 8), i + 1.0);
    ptr_write_f64(ptr_offset(b, i, 8), i + 1.0);
}

// Non-nested (baseline)
let result1: f64 = 0.0;
for (let i = 0; i < n; i++) {
    let val = inner(a, b, i);
    result1 = add(result1, val);
}
print(result1);

// Nested (the bug case: add(result, inner(a, b, i)))
let result2: f64 = 0.0;
for (let i = 0; i < n; i++) {
    result2 = add(result2, inner(a, b, i));
}
print(result2);

free(a);
free(b);
