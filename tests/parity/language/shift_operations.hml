// Parity test: shift operations — signed shifts, oversized shifts

// === Basic shifts ===
print(1 << 0);          // 1
print(1 << 3);          // 8
print(8 >> 1);          // 4
print(8 >> 3);          // 1
print(15 >> 4);         // 0

// === Signed right shift (arithmetic shift — sign extension) ===
let neg: i32 = -1;
print(neg >> 1);        // -1 (sign-extended)
print(neg >> 31);       // -1 (all sign bits)

let neg2: i32 = -128;
print(neg2 >> 3);       // -16 (arithmetic shift)
print(neg2 >> 7);       // -1

// === Unsigned right shift (logical shift — zero fill) ===
let u: u32 = 0xFFFFFFFF;
print(u >> 1);          // 2147483647
print(u >> 31);         // 1

// === Oversized shifts (>= bit width) ===
let x: i32 = 42;
print(x << 32);         // 0
print(x << 100);        // 0
print(x >> 32);         // 0 (non-negative value)
print(x >> 100);        // 0

let neg3: i32 = -42;
print(neg3 >> 32);      // -1 (negative, sign-extended)
print(neg3 >> 100);     // -1

let u2: u32 = 42;
print(u2 << 32);        // 0
print(u2 >> 32);        // 0

// === 64-bit shifts ===
let big: i64 = 1;
print(big << 32);       // 4294967296
print(big << 62);       // 4611686018427387904

let big2: i64 = -1;
print(big2 >> 32);      // -1
print(big2 >> 63);      // -1

// Oversized i64 shifts
print(big << 64);       // 0
print(big << 100);      // 0
print(big2 >> 64);      // -1
print(big2 >> 100);     // -1

// === Left shift of negative signed values ===
let neg4: i32 = -1;
print(neg4 << 1);       // -2
print(neg4 << 16);      // -65536

// === Negative shift amount (error) ===
try {
    let n = -1;
    let bad = 1 << n;
    print("ERROR: should have thrown");
} catch (e) {
    print("caught negative lshift");
}

try {
    let n = -1;
    let bad = 1 >> n;
    print("ERROR: should have thrown");
} catch (e) {
    print("caught negative rshift");
}

// === Shift compound assignment ===
let a: i32 = 1;
a <<= 4;
print(a);               // 16
a >>= 2;
print(a);               // 4

print("done");
