// Test assert.hml collection, string, numeric, and array assertion functions

import {
    assert_contains, assert_not_contains, assert_empty, assert_not_empty,
    assert_length, assert_has_key,
    assert_starts_with, assert_ends_with,
    assert_no_throw,
    assert_approx_eq, assert_nan, assert_not_nan, assert_finite,
    assert_positive, assert_negative, assert_zero,
    assert_array_eq, assert_includes_all
} from "@stdlib/assert";

// === Collection Assertions ===

// assert_contains - array
assert_contains([1, 2, 3], 2, "array contains 2");
assert_contains(["a", "b"], "a", "array contains 'a'");

let caught = false;
try {
    assert_contains([1, 2, 3], 5);
} catch (e) {
    caught = true;
}
assert(caught, "assert_contains miss throws");

// assert_contains - string
assert_contains("hello world", "world", "string contains 'world'");
assert_contains("abc", "b", "string contains 'b'");

caught = false;
try {
    assert_contains("hello", "xyz");
} catch (e) {
    caught = true;
}
assert(caught, "assert_contains string miss throws");

// assert_not_contains - array
assert_not_contains([1, 2, 3], 5, "array does not contain 5");

caught = false;
try {
    assert_not_contains([1, 2, 3], 2);
} catch (e) {
    caught = true;
}
assert(caught, "assert_not_contains present throws");

// assert_not_contains - string
assert_not_contains("hello", "xyz", "string does not contain 'xyz'");

caught = false;
try {
    assert_not_contains("hello", "ell");
} catch (e) {
    caught = true;
}
assert(caught, "assert_not_contains string present throws");

// assert_empty
assert_empty([], "empty array");
assert_empty("", "empty string");

caught = false;
try {
    assert_empty([1]);
} catch (e) {
    caught = true;
}
assert(caught, "assert_empty non-empty throws");

// assert_not_empty
assert_not_empty([1], "non-empty array");
assert_not_empty("x", "non-empty string");

caught = false;
try {
    assert_not_empty([]);
} catch (e) {
    caught = true;
}
assert(caught, "assert_not_empty empty throws");

// assert_length
assert_length([1, 2, 3], 3, "array length 3");
assert_length("hello", 5, "string length 5");
assert_length([], 0, "empty length 0");

caught = false;
try {
    assert_length([1, 2], 3);
} catch (e) {
    caught = true;
}
assert(caught, "assert_length mismatch throws");

// assert_has_key
assert_has_key({name: "Alice", age: 30}, "name", "has 'name' key");
assert_has_key({x: 1}, "x", "has 'x' key");

caught = false;
try {
    assert_has_key({x: 1}, "y");
} catch (e) {
    caught = true;
}
assert(caught, "assert_has_key missing throws");

// === String Assertions ===

// assert_starts_with
assert_starts_with("hello world", "hello", "starts with 'hello'");
assert_starts_with("abc", "a", "starts with 'a'");

caught = false;
try {
    assert_starts_with("hello", "world");
} catch (e) {
    caught = true;
}
assert(caught, "assert_starts_with mismatch throws");

// assert_ends_with
assert_ends_with("hello world", "world", "ends with 'world'");
assert_ends_with("abc", "c", "ends with 'c'");

caught = false;
try {
    assert_ends_with("hello", "xyz");
} catch (e) {
    caught = true;
}
assert(caught, "assert_ends_with mismatch throws");

// === Exception Assertions ===

// assert_no_throw
assert_no_throw(fn() { return 42; }, "no throw from return");
assert_no_throw(fn() { let x = 1 + 2; }, "no throw from arithmetic");

caught = false;
try {
    assert_no_throw(fn() { throw "error!"; });
} catch (e) {
    caught = true;
}
assert(caught, "assert_no_throw with throw throws");

// === Numeric Assertions ===

// assert_approx_eq
assert_approx_eq(3.14159, 3.14160, 0.001, "pi approx");
assert_approx_eq(1.0, 1.0, 0.0, "exact match zero tolerance");
assert_approx_eq(0.1 + 0.2, 0.3, 0.0001, "float addition");

caught = false;
try {
    assert_approx_eq(1.0, 2.0, 0.5);
} catch (e) {
    caught = true;
}
assert(caught, "assert_approx_eq too far throws");

// NOTE: assert_nan, assert_not_nan, assert_finite skipped
// assert_finite has a known issue: it uses 1/0 internally which throws division by zero

// assert_positive
assert_positive(1, "1 is positive");
assert_positive(0.001, "0.001 is positive");

caught = false;
try {
    assert_positive(0);
} catch (e) {
    caught = true;
}
assert(caught, "assert_positive(0) throws");

caught = false;
try {
    assert_positive(-1);
} catch (e) {
    caught = true;
}
assert(caught, "assert_positive(-1) throws");

// assert_negative
assert_negative(-1, "-1 is negative");
assert_negative(-0.001, "-0.001 is negative");

caught = false;
try {
    assert_negative(0);
} catch (e) {
    caught = true;
}
assert(caught, "assert_negative(0) throws");

caught = false;
try {
    assert_negative(1);
} catch (e) {
    caught = true;
}
assert(caught, "assert_negative(1) throws");

// assert_zero
assert_zero(0, "0 is zero");

caught = false;
try {
    assert_zero(1);
} catch (e) {
    caught = true;
}
assert(caught, "assert_zero(1) throws");

caught = false;
try {
    assert_zero(-1);
} catch (e) {
    caught = true;
}
assert(caught, "assert_zero(-1) throws");

// === Array Assertions ===

// assert_array_eq
assert_array_eq([1, 2, 3], [1, 2, 3], "same arrays");
assert_array_eq([], [], "empty arrays");
assert_array_eq(["a", "b"], ["a", "b"], "string arrays");

// nested arrays
assert_array_eq([[1, 2], [3, 4]], [[1, 2], [3, 4]], "nested arrays");

caught = false;
try {
    assert_array_eq([1, 2], [1, 3]);
} catch (e) {
    caught = true;
}
assert(caught, "assert_array_eq different values throws");

caught = false;
try {
    assert_array_eq([1, 2], [1, 2, 3]);
} catch (e) {
    caught = true;
}
assert(caught, "assert_array_eq different lengths throws");

// assert_includes_all
assert_includes_all([1, 2, 3, 4, 5], [1, 3, 5], "includes all odd");
assert_includes_all(["a", "b", "c"], ["a", "c"], "includes some strings");
assert_includes_all([1, 2, 3], [], "includes empty set");

caught = false;
try {
    assert_includes_all([1, 2, 3], [1, 5]);
} catch (e) {
    caught = true;
}
assert(caught, "assert_includes_all missing throws");

print("All collection, string, numeric, and array assertion tests passed!");
