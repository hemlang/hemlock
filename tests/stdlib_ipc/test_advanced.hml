// Test @stdlib/ipc advanced features

import { MessageQueue, Semaphore, Mutex, SharedData, PidFile, Event } from "@stdlib/ipc";
import { exists, remove_file } from "@stdlib/fs";
import { time_ms } from "@stdlib/time";

let ts = time_ms();

// === MessageQueue FIFO order ===
print("=== MessageQueue FIFO order ===");
let mq_path = "/tmp/hemlock_test_mq_fifo_" + ts;
let mq = MessageQueue(mq_path);

// Send multiple messages and verify all are received
mq.send("alpha");
mq.send("beta");
mq.send("gamma");
mq.send("delta");

assert(mq.count() == 4, "queue has 4 messages");
assert(mq.is_empty() == false, "queue not empty");

// Receive all messages - order may vary within same-ms sends
let received: array = [];
received.push(mq.try_recv());
received.push(mq.try_recv());
received.push(mq.try_recv());
received.push(mq.try_recv());

assert(received.contains("alpha"), "received alpha");
assert(received.contains("beta"), "received beta");
assert(received.contains("gamma"), "received gamma");
assert(received.contains("delta"), "received delta");

// Queue should be empty after receiving all
assert(mq.is_empty() == true, "queue empty after recv all");
assert(mq.count() == 0, "queue count 0");

// try_recv on empty queue returns null
let empty_recv = mq.try_recv();
assert(empty_recv == null, "try_recv empty returns null");

// Test clear
mq.send("a");
mq.send("b");
assert(mq.count() == 2, "queue has 2 before clear");
mq.clear();
assert(mq.count() == 0, "queue count 0 after clear");
assert(mq.is_empty() == true, "queue empty after clear");

mq.destroy();
print("MessageQueue FIFO order passed!");

// === SharedData keys and delete ===
print("=== SharedData keys/delete ===");
let data_path = "/tmp/hemlock_test_data_adv_" + ts;
let shared = SharedData(data_path);

shared.set("name", "Alice");
shared.set("age", 30);
shared.set("city", "NYC");

// Test keys()
let keys = shared.keys();
assert(keys.length == 3, "shared has 3 keys");

// Keys should include all set keys
let has_name = false;
let has_age = false;
let has_city = false;
for (k in keys) {
    if (k == "name") { has_name = true; }
    if (k == "age") { has_age = true; }
    if (k == "city") { has_city = true; }
}
assert(has_name, "keys includes 'name'");
assert(has_age, "keys includes 'age'");
assert(has_city, "keys includes 'city'");

// Test delete
shared.delete("age");
assert(shared.get("age") == null, "deleted key is null");
assert(shared.get("name") == "Alice", "non-deleted key intact");

// Keys after delete
let keys_after = shared.keys();
// The key might still exist with null value depending on implementation
// But name and city should still be retrievable
assert(shared.get("city") == "NYC", "city still accessible");

// Test overwriting
shared.set("name", "Bob");
assert(shared.get("name") == "Bob", "overwritten value");

// Clear and verify
shared.clear();
assert(shared.get("name") == null, "cleared name is null");
assert(shared.get("city") == null, "cleared city is null");

// Cleanup
remove_file(data_path);
remove_file(data_path + ".lock");
print("SharedData keys/delete passed!");

// === Semaphore with initial value 1 ===
print("=== Semaphore initial=1 ===");
let sem_path = "/tmp/hemlock_test_sem_adv_" + ts;
let sem = Semaphore(sem_path, 1);

assert(sem.value() == 1, "semaphore initial 1");
assert(sem.try_acquire() == true, "first acquire succeeds");
assert(sem.value() == 0, "value 0 after acquire");
assert(sem.try_acquire() == false, "second acquire fails");

sem.release();
assert(sem.value() == 1, "value 1 after release");

sem.release();
assert(sem.value() == 2, "value 2 after double release");

// Acquire twice now
assert(sem.try_acquire() == true, "acquire from 2");
assert(sem.try_acquire() == true, "acquire from 1");
assert(sem.try_acquire() == false, "acquire from 0 fails");

remove_file(sem_path);
print("Semaphore initial=1 passed!");

// === Mutex lock/unlock cycle ===
print("=== Mutex lock/unlock cycle ===");
let mutex_path = "/tmp/hemlock_test_mutex_adv_" + ts;
let mutex = Mutex(mutex_path);

assert(mutex.is_locked() == false, "mutex initially unlocked");

// Lock
assert(mutex.lock(100) == true, "lock succeeds");
assert(mutex.is_locked() == true, "mutex now locked");

// Try lock should fail
assert(mutex.try_lock() == false, "try_lock fails when locked");

// Unlock
mutex.unlock();
assert(mutex.is_locked() == false, "mutex unlocked");

// Can lock again
assert(mutex.lock(100) == true, "re-lock succeeds");
assert(mutex.is_locked() == true, "mutex locked again");
mutex.unlock();

remove_file(mutex_path);
print("Mutex lock/unlock cycle passed!");

// === Event set/clear/wait ===
print("=== Event set/clear/wait ===");
let event_path = "/tmp/hemlock_test_event_adv_" + ts;
let event = Event(event_path);

// Initially not set
assert(event.is_set() == false, "event initially not set");

// Wait should timeout when not set
let wait_result = event.wait(50);
assert(wait_result == false, "wait timeout returns false");

// Set event
event.set();
assert(event.is_set() == true, "event is set after set()");

// Wait should succeed when set
let wait_result2 = event.wait(50);
assert(wait_result2 == true, "wait returns true when set");

// Clear event
event.clear();
assert(event.is_set() == false, "event cleared");

// Wait should timeout again
let wait_result3 = event.wait(50);
assert(wait_result3 == false, "wait timeout after clear");

// Set and clear cycle
event.set();
assert(event.is_set() == true, "re-set");
event.clear();
assert(event.is_set() == false, "re-clear");

// Cleanup - file may already be removed by clear()
if (exists(event_path)) {
    remove_file(event_path);
}
print("Event set/clear/wait passed!");

// === PidFile ownership ===
print("=== PidFile ownership ===");
let pid_path = "/tmp/hemlock_test_pid_adv_" + ts;
let pf = PidFile(pid_path);

assert(pf.create() == true, "pidfile created");

// Read should return current PID
let read_pid = pf.read();
assert(read_pid > 0, "read pid > 0");

// Is owner should be true for current process
assert(pf.is_owner() == true, "is owner of own pidfile");

// Creating again should fail (process is still running)
assert(pf.create() == false, "duplicate create fails");

// Remove
pf.remove();
assert(exists(pid_path) == false, "pidfile removed");
print("PidFile ownership passed!");

print("\nAll advanced IPC tests passed!");

// === Pipe basic send/recv ===
print("\n=== Pipe basic send/recv ===");
import { Pipe, pipe_create, fd_read, fd_write, fd_close, dup2, STDIN_FD, STDOUT_FD, STDERR_FD } from "@stdlib/ipc";

let p1 = Pipe();
assert(p1.read_fd >= 0, "pipe read_fd is valid");
assert(p1.write_fd >= 0, "pipe write_fd is valid");
assert(p1.read_fd != p1.write_fd, "read_fd != write_fd");

let written = p1.send("Hello, Pipe!");
assert(written == 12, "wrote 12 bytes");

let pipe_data = p1.recv(4096);
assert(pipe_data == "Hello, Pipe!", "received correct data");

p1.close();
print("Pipe basic send/recv passed!");

// === Pipe multiple sends ===
print("=== Pipe multiple sends ===");
let p2 = Pipe();
p2.send("aaa");
p2.send("bbb");
p2.send("ccc");
p2.close_write();

let all = p2.recv(4096);
assert(all == "aaabbbccc", "multiple sends concatenate");
p2.close_read();
print("Pipe multiple sends passed!");

// === Pipe EOF behavior ===
print("=== Pipe EOF behavior ===");
let p3 = Pipe();
p3.send("data");
p3.close_write();

let first_read = p3.recv(4096);
assert(first_read == "data", "first read gets data");

let eof_read = p3.recv(4096);
assert(eof_read == null, "read after EOF returns null");

p3.close_read();
print("Pipe EOF behavior passed!");

// === Pipe close idempotency ===
print("=== Pipe close idempotency ===");
let p4 = Pipe();
p4.close_read();
p4.close_read();  // should not throw
p4.close_write();
p4.close_write();  // should not throw
p4.close();  // should not throw even after individual closes
print("Pipe close idempotency passed!");

// === Low-level pipe_create + fd functions ===
print("=== Low-level fd functions ===");
let fds = pipe_create();
assert(fds.read_fd >= 0, "pipe_create read_fd valid");
assert(fds.write_fd >= 0, "pipe_create write_fd valid");

let w = fd_write(fds.write_fd, "low-level");
assert(w == 9, "fd_write returns byte count");

let r = fd_read(fds.read_fd, 4096);
assert(r == "low-level", "fd_read returns data");

fd_close(fds.write_fd);
fd_close(fds.read_fd);
print("Low-level fd functions passed!");

// === Pipe partial reads ===
print("=== Pipe partial reads ===");
let p5 = Pipe();
p5.send("abcdefghij");  // 10 bytes
let partial = p5.recv(5);  // read only 5
assert(partial == "abcde", "partial read gets first 5 bytes");
let rest = p5.recv(5);
assert(rest == "fghij", "second read gets remaining 5 bytes");
p5.close();
print("Pipe partial reads passed!");

// === FD constants ===
print("=== FD constants ===");
assert(STDIN_FD == 0, "STDIN_FD is 0");
assert(STDOUT_FD == 1, "STDOUT_FD is 1");
assert(STDERR_FD == 2, "STDERR_FD is 2");
print("FD constants passed!");

// === dup2 test ===
print("=== dup2 test ===");
let p6 = Pipe();

// dup2 the write end to a high fd number, then write through it
let new_fd = dup2(p6.write_fd, 99);
assert(new_fd == 99, "dup2 returns new fd");

// Write through the duplicated fd
fd_write(99, "via dup2");
fd_close(99);

let dup_data = p6.recv(4096);
assert(dup_data == "via dup2", "data written through dup2'd fd");
p6.close();
print("dup2 test passed!");

// === Pipe with fork (parent-child IPC) ===
print("=== Pipe fork test ===");
import { fork, wait } from "@stdlib/process";

let p7 = Pipe();
let pid = fork();

if (pid == 0) {
    // Child process: close read end, send message, exit
    p7.close_read();
    p7.send("hello from child");
    p7.close_write();
    __exit(0);
} else {
    // Parent process: close write end, read message, wait for child
    p7.close_write();
    let child_msg = p7.recv(4096);
    assert(child_msg == "hello from child", "parent received child message");
    p7.close_read();
    wait();
    print("Pipe fork test passed!");
}

print("\nAll advanced pipe tests passed!");
