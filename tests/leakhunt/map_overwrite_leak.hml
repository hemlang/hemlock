// Single construct: overwriting the same object key with a fresh
// heap value. The displaced value must be released by the
// assignment codegen; if not, every overwrite leaks the prior
// object + its contents. Only the final value is legitimately live
// at exit (not a leak).
let m = {};
let round = 0;
let sink = 0;
while (round < 3000) {
	m["k"] = { v: "val-" + round, arr: [round, round + 1] };
	sink = sink + round;
	round = round + 1;
}
print("map_overwrite_leak: ok sink=" + sink + " last=" + m["k"].v);
