// Test annotations, const parameters, method signatures, type aliases
@inline
@hot
fn fast_path(x: i32): i32 {
	return x * 2;
}

@optimize("3")
fn optimized(): void {
	print("optimized");
}

fn readonly(const arr: array) {
	print(arr);
}

fn swap(ref a: i32, ref b: i32) {
	let t = a;
	a = b;
	b = t;
}

define Comparable {
	value: i32,
	fn compare(other: Self): i32,
	fn clone?(): Self,
}

type Callback = fn(i32): void;
type Handler = fn(string, i32): bool;