// Test RingBuffer basic functionality

import { RingBuffer, sliding_window, moving_average } from "@stdlib/ring_buffer";

// Test basic operations
let rb = RingBuffer(3);

assert(rb.is_empty() == true, "New buffer should be empty");
assert(rb.capacity() == 3, "Capacity should be 3");
assert(rb.available() == 3, "Available should be 3");

// Write items
rb.write(1);
rb.write(2);
rb.write(3);

assert(rb.is_full() == true, "Buffer should be full");
assert(rb.size == 3, "Size should be 3");
assert(rb.peek() == 1, "Peek should return oldest (1)");
assert(rb.newest() == 3, "Newest should return 3");

print("Basic write tests passed");

// Test overwriting
let overwritten = rb.write(4);  // Should overwrite 1
assert(overwritten == true, "Should have overwritten");
assert(rb.peek() == 2, "Oldest should now be 2");
assert(rb.newest() == 4, "Newest should be 4");

print("Overwrite test passed");

// Test read
let val = rb.read();
assert(val == 2, "Read should return 2");
assert(rb.size == 2, "Size should be 2 after read");

print("Read test passed");

// Test to_array
let arr = rb.to_array();
assert(arr.length == 2, "Array should have 2 elements");
assert(arr[0] == 3, "First should be 3");
assert(arr[1] == 4, "Second should be 4");

print("to_array test passed");

// Test clear
rb.clear();
assert(rb.is_empty() == true, "Buffer should be empty after clear");

print("Clear test passed");

// Test read_all
let rb2 = RingBuffer(5);
rb2.write(10);
rb2.write(20);
rb2.write(30);

let all = rb2.read_all();
assert(all.length == 3, "read_all should return 3 items");
assert(rb2.is_empty() == true, "Buffer should be empty after read_all");

print("read_all test passed");

// Test peek_at
let rb3 = RingBuffer(4);
rb3.write("a");
rb3.write("b");
rb3.write("c");

assert(rb3.peek_at(0) == "a", "peek_at(0) should be 'a'");
assert(rb3.peek_at(1) == "b", "peek_at(1) should be 'b'");
assert(rb3.peek_at(2) == "c", "peek_at(2) should be 'c'");

print("peek_at test passed");

// Test skip
rb3.skip(2);
assert(rb3.size == 1, "Size should be 1 after skip(2)");
assert(rb3.peek() == "c", "Remaining should be 'c'");

print("Skip test passed");

// Test sliding_window
let windows = [];
sliding_window([1, 2, 3, 4, 5], 3, fn(window, idx) {
    windows.push(window);
});

assert(windows.length == 3, "Should have 3 windows");
assert(windows[0][0] == 1, "First window starts with 1");
assert(windows[0][2] == 3, "First window ends with 3");
assert(windows[2][0] == 3, "Last window starts with 3");
assert(windows[2][2] == 5, "Last window ends with 5");

print("sliding_window test passed");

// Test moving_average
let data = [1, 2, 3, 4, 5];
let averages = moving_average(data, 3);

assert(averages.length == 3, "Should have 3 averages");
assert(averages[0] == 2, "First average should be 2");  // (1+2+3)/3
assert(averages[1] == 3, "Second average should be 3"); // (2+3+4)/3
assert(averages[2] == 4, "Third average should be 4");  // (3+4+5)/3

print("moving_average test passed");

print("All ring buffer tests passed!");
