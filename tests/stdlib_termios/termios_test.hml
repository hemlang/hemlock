// Test @stdlib/termios - Terminal I/O constants and utilities
// Note: Raw mode and key reading can't be tested in automated context,
// but we can verify constants and non-interactive functions.

import { KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT } from "@stdlib/termios";
import { KEY_HOME, KEY_END, KEY_INSERT, KEY_DELETE } from "@stdlib/termios";
import { KEY_PAGE_UP, KEY_PAGE_DOWN } from "@stdlib/termios";
import { KEY_F1, KEY_F2, KEY_F3, KEY_F4, KEY_F12 } from "@stdlib/termios";
import { KEY_ESCAPE, KEY_ENTER, KEY_TAB, KEY_BACKSPACE } from "@stdlib/termios";
import { KEY_CTRL_C, KEY_CTRL_D, KEY_CTRL_Z, KEY_NONE } from "@stdlib/termios";
import { is_key, is_printable, is_arrow, key_name } from "@stdlib/termios";

// ============================================================================
// Key Constants
// ============================================================================

assert(KEY_NONE == 0, "KEY_NONE");
assert(KEY_UP == 256, "KEY_UP");
assert(KEY_DOWN == 257, "KEY_DOWN");
assert(KEY_LEFT == 259, "KEY_LEFT");
assert(KEY_RIGHT == 258, "KEY_RIGHT");
assert(KEY_ESCAPE == 27, "KEY_ESCAPE");
assert(KEY_ENTER == 13, "KEY_ENTER");
assert(KEY_TAB == 9, "KEY_TAB");
assert(KEY_BACKSPACE == 127, "KEY_BACKSPACE");
assert(KEY_CTRL_C == 3, "KEY_CTRL_C");
assert(KEY_CTRL_D == 4, "KEY_CTRL_D");

// Function keys are sequential
assert(KEY_F2 == KEY_F1 + 1, "F keys sequential");
assert(KEY_F12 == KEY_F1 + 11, "F12 offset");

print("PASS: key constants");

// ============================================================================
// Key Identification Functions
// ============================================================================

let arrow_key = { code: KEY_UP, char: "" };
let printable_key = { code: 65, char: "A" };
let ctrl_key = { code: KEY_CTRL_C, char: "" };

assert(is_key(arrow_key, KEY_UP) == true, "is_key UP");
assert(is_key(arrow_key, KEY_DOWN) == false, "is_key not DOWN");

assert(is_arrow(arrow_key) == true, "is_arrow true");
assert(is_arrow(printable_key) == false, "is_arrow false");

assert(is_printable(printable_key) == true, "is_printable true");
assert(is_printable(ctrl_key) == false, "is_printable false for ctrl");

print("PASS: key identification");

// ============================================================================
// Key Names
// ============================================================================

// key_name returns the .name field from a key object (as read_key produces)
assert(key_name({ code: KEY_UP, char: "", name: "Up" }) == "Up", "key_name Up");
assert(key_name({ code: KEY_ENTER, char: "\n", name: "Enter" }) == "Enter", "key_name Enter");
assert(key_name({ code: 65, char: "A", name: "A" }) == "A", "key_name printable");

print("PASS: key names");

print("All termios tests passed!");
