// Comprehensive Memory Leak Test for Hemlock Runtime
// =====================================================
//
// This test verifies the runtime is free of memory leaks for core operations.
// Run with: make leak-stress
//
// KNOWN ISSUES (documented, not tested here):
// - Null coalescing with literals: `let x = null ?? "default";` leaks AST nodes
//   Workaround: Use variables instead of literals in ?? expressions

print("═══════════════════════════════════════════════════════════════");
print("       HEMLOCK RUNTIME MEMORY LEAK VERIFICATION");
print("═══════════════════════════════════════════════════════════════");
print("");

// ═══════════════════════════════════════════════════════════════
// SECTION 1: PRIMITIVE TYPES
// ═══════════════════════════════════════════════════════════════
print("▶ Section 1: Primitive Types");

let a: i32 = 42;
let b: i64 = 9223372036854775807;
let c: i8 = -128;
let d: u64 = 18446744073709551615;

let sum = a + 10;
let product = a * 2;
let and_result = a & 0xFF;
let shift_left = a << 2;

let f32_val: f32 = 3.14;
let f64_val: f64 = 2.718281828459045;
let sqrt_val = sqrt(16.0);

let t = true;
let bool_result = t && false || !false;

print("  ✓ All primitive operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 2: STRING OPERATIONS
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 2: String Operations");

let s1 = "Hello";
let s2 = "World";
let s3 = s1 + ", " + s2 + "!";

// Stress test string creation
for (let i = 0; i < 100; i++) {
    let temp = "String " + i;
}

// String methods
let s = "  Hello World  ";
let trimmed = s.trim();
let upper = s.to_upper();
let lower = s.to_lower();
let replaced = s.replace("World", "Hemlock");
let split_result = "a,b,c".split(",");

// Template strings
let name = "Hemlock";
let msg = `Hello ${name}!`;
for (let i = 0; i < 50; i++) {
    let temp = `Iteration ${i}`;
}

// Unicode
let emoji = "🚀 Hello 🌍";
let chinese = "你好世界";

print("  ✓ All string operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 3: ARRAY OPERATIONS
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 3: Array Operations");

let arr = [1, 2, 3, 4, 5];
let nested = [[1, 2], [3, 4]];

// Stress test
for (let i = 0; i < 100; i++) {
    let temp = [i, i+1, i+2];
}

// Array methods
let arr2 = [1, 2, 3];
arr2.push(4);
arr2.pop();
arr2.unshift(0);
arr2.shift();

let sliced = [1, 2, 3, 4, 5].slice(1, 4);
let joined = ["a", "b", "c"].join("-");
let concatted = [1, 2].concat([3, 4]);
let reversed = [1, 2, 3].reverse();

// Functional methods
let nums = [1, 2, 3, 4, 5];
let doubled = nums.map(fn(x) { return x * 2; });
let evens = nums.filter(fn(x) { return x % 2 == 0; });
let total = nums.reduce(fn(acc, x) { return acc + x; }, 0);

// Chained operations stress test
for (let i = 0; i < 20; i++) {
    let result = [1, 2, 3, 4, 5]
        .map(fn(x) { return x * 2; })
        .filter(fn(x) { return x > 5; });
}

print("  ✓ All array operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 4: OBJECT OPERATIONS
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 4: Object Operations");

let obj = { name: "test", value: 42, active: true };
let nested_obj = { user: { name: "Alice", age: 30 } };

// Stress test
for (let i = 0; i < 100; i++) {
    let temp = { index: i, data: "value" + i };
}

// Object shorthand
let obj_name = "test";
let obj_value = 42;
let shorthand_obj = { name: obj_name, value: obj_value };

// Object spread
let defaults = { a: 1, b: 2 };
let extended = { ...defaults, c: 3 };

// Serialization
let ser_obj = { name: "test", values: [1, 2, 3] };
let json = ser_obj.serialize();
let restored = json.deserialize();

print("  ✓ All object operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 5: FUNCTIONS AND CLOSURES
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 5: Functions and Closures");

fn add(x: i32, y: i32): i32 {
    return x + y;
}

fn factorial(n: i32): i32 {
    if (n <= 1) { return 1; }
    return n * factorial(n - 1);
}

let func_sum = add(10, 20);
let fact = factorial(10);

// Closures
fn make_counter(): fn(): i32 {
    let count = 0;
    return fn(): i32 {
        count = count + 1;
        return count;
    };
}

fn make_adder(n: i32): fn(i32): i32 {
    return fn(x: i32): i32 {
        return x + n;
    };
}

let counter = make_counter();
counter();
counter();

// Closure stress test
for (let i = 0; i < 50; i++) {
    let temp_adder = make_adder(i);
    temp_adder(10);
}

// Expression-bodied functions
fn expr_double(x: i32): i32 => x * 2;
let expr_result = expr_double(5);

print("  ✓ All function operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 6: CONTROL FLOW
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 6: Control Flow");

// If/else
let fizzbuzz_results = [];
for (let i = 0; i < 50; i++) {
    if (i % 15 == 0) {
        fizzbuzz_results.push("fizzbuzz");
    } else if (i % 3 == 0) {
        fizzbuzz_results.push("fizz");
    } else {
        fizzbuzz_results.push(i);
    }
}

// Switch
let switch_results = [];
for (let i = 0; i < 10; i++) {
    switch (i % 3) {
        case 0: switch_results.push("zero"); break;
        case 1: switch_results.push("one"); break;
        default: switch_results.push("other"); break;
    }
}

// Loops
let loop_sum = 0;
let loop_i = 0;
while (loop_i < 50) {
    loop_sum = loop_sum + loop_i;
    loop_i = loop_i + 1;
}

for (let j = 0; j < 50; j++) {
    loop_sum = loop_sum + j;
}

for (item in [1, 2, 3, 4, 5]) {
    loop_sum = loop_sum + item;
}

let loop_count = 0;
loop {
    loop_count = loop_count + 1;
    if (loop_count >= 25) { break; }
}

// Labeled loops
outer: for (let i = 0; i < 10; i++) {
    for (let j = 0; j < 10; j++) {
        if (i * j == 42) {
            break outer;
        }
    }
}

// Ternary operator
let ternary_result = true ? 1 : 2;

print("  ✓ All control flow");

// ═══════════════════════════════════════════════════════════════
// SECTION 7: MEMORY MANAGEMENT
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 7: Memory Management");

// Manual alloc/free
for (let i = 0; i < 50; i++) {
    let p = alloc(1024);
    memset(p, 0, 1024);
    free(p);
}

// Buffer operations
for (let i = 0; i < 25; i++) {
    let buf = buffer(256);
    buf[0] = 42;
    let val = buf[0];
    free(buf);
}

// Typed allocation
for (let i = 0; i < 25; i++) {
    let arr_ptr = talloc(i32, 100);
    ptr_write_i32(arr_ptr, 42);
    free(arr_ptr);
}

// Realloc
let realloc_p = alloc(100);
for (let i = 1; i <= 5; i++) {
    realloc_p = realloc(realloc_p, i * 100);
}
free(realloc_p);

// memcpy
let src = alloc(1024);
let dst = alloc(1024);
memset(src, 0xAB, 1024);
memcpy(dst, src, 1024);
free(src);
free(dst);

print("  ✓ All memory operations");

// ═══════════════════════════════════════════════════════════════
// SECTION 8: ERROR HANDLING
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 8: Error Handling");

// Try/catch/finally
let cleanup_count = 0;
for (let i = 0; i < 25; i++) {
    try {
        if (i % 2 == 0) {
            throw "Error " + i;
        }
    } catch (e) {
        // Caught
    } finally {
        cleanup_count = cleanup_count + 1;
    }
}

// Nested exceptions
let exc_count = 0;
try {
    try {
        throw "inner";
    } catch (e) {
        exc_count = exc_count + 1;
        throw "rethrow";
    }
} catch (e) {
    exc_count = exc_count + 1;
}

// Defer
let defer_order = [];
fn test_defer() {
    defer defer_order.push(3);
    defer defer_order.push(2);
    defer_order.push(1);
}
test_defer();

// Defer with exceptions
let deferred_ran = false;
try {
    defer deferred_ran = true;
    throw "test";
} catch (e) {
    // Caught
}

print("  ✓ All error handling");

// ═══════════════════════════════════════════════════════════════
// SECTION 9: SAFE NAVIGATION (works without leaks)
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 9: Safe Navigation");

let nav_obj = { user: { name: "Alice" } };
let nav_name = nav_obj?.user?.name;

// Null coalescing with variables (no leak)
let null_val = null;
let default_val = "default";
let nc_result = null_val ?? default_val;

// Null coalescing assignment (no leak)
let nca_x = null;
nca_x ??= "assigned";

print("  ✓ Safe navigation (using variable workarounds)");

// ═══════════════════════════════════════════════════════════════
// SECTION 10: MISCELLANEOUS
// ═══════════════════════════════════════════════════════════════
print("");
print("▶ Section 10: Miscellaneous");

// Type introspection
let types = [
    typeof(42),
    typeof("hello"),
    typeof([1, 2, 3]),
    typeof({ a: 1 }),
    typeof(true),
    typeof(null)
];

// Numeric literals
let hex = 0xDEADBEEF;
let binary = 0b10101010;
let octal = 0o755;
let separated = 1_000_000;

// Increment/decrement
let inc_x = 10;
++inc_x;
inc_x++;
--inc_x;
inc_x--;

// Compound assignment
let comp_x = 10;
comp_x += 5;
comp_x -= 3;
comp_x *= 2;

print("  ✓ All miscellaneous operations");

