// Test: Detached task results should be properly cleaned up
// Expected: No memory leaks when detached tasks complete
// Note: Detached tasks run in background, cleanup happens when they complete

// Test 1: Joined task returning a string - verifies result ownership
async fn string_returner() {
    return "this string should be properly owned by caller";
}

let task1 = spawn(string_returner);
let result1 = join(task1);
print("Test 1: Join string result = " + result1);

// Test 2: Joined task returning an array
async fn array_returner() {
    return [1, 2, 3, 4, 5];
}

let task2 = spawn(array_returner);
let result2 = join(task2);
print("Test 2: Join array result length = " + result2.length);

// Test 3: Joined task returning an object
async fn object_returner() {
    return { name: "test", value: 42 };
}

let task3 = spawn(object_returner);
let result3 = join(task3);
print("Test 3: Join object result.name = " + result3.name);

// Test 4: Task with computed result
async fn compute(x) {
    return "result: " + x;
}

let task4 = spawn(compute, 42);
let result4 = join(task4);
print("Test 4: Computed result = " + result4);

// Test 5: Multiple sequential tasks
for (let i = 0; i < 3; i = i + 1) {
    let t = spawn(string_returner);
    let r = join(t);
}
print("Test 5: Multiple sequential tasks completed");

print("All task result tests completed");
