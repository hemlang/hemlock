// Test PriorityQueue basic functionality

import { PriorityQueue, MinHeap, MaxHeap, heapify, nlargest, nsmallest } from "@stdlib/priority_queue";

// Test MinHeap (default)
let pq = PriorityQueue();

assert(pq.is_empty() == true, "New queue should be empty");
assert(pq.size == 0, "New queue size should be 0");

// Push items
pq.push(5);
pq.push(3);
pq.push(7);
pq.push(1);
pq.push(9);

assert(pq.size == 5, "Size should be 5 after pushing 5 items");
assert(pq.is_empty() == false, "Queue should not be empty");

// Peek should return smallest (min-heap)
assert(pq.peek() == 1, "Peek should return smallest (1)");

// Pop should return in sorted order for min-heap
assert(pq.pop() == 1, "First pop should be 1");
assert(pq.pop() == 3, "Second pop should be 3");
assert(pq.pop() == 5, "Third pop should be 5");
assert(pq.pop() == 7, "Fourth pop should be 7");
assert(pq.pop() == 9, "Fifth pop should be 9");

assert(pq.is_empty() == true, "Queue should be empty after popping all");

print("MinHeap basic tests passed");

// Test MaxHeap
let maxpq = MaxHeap();

maxpq.push(5);
maxpq.push(3);
maxpq.push(7);
maxpq.push(1);
maxpq.push(9);

assert(maxpq.peek() == 9, "MaxHeap peek should return largest (9)");
assert(maxpq.pop() == 9, "First pop should be 9");
assert(maxpq.pop() == 7, "Second pop should be 7");
assert(maxpq.pop() == 5, "Third pop should be 5");

print("MaxHeap basic tests passed");

// Test heapify
let arr = [4, 2, 6, 1, 3, 5];
let heap = heapify(arr);

assert(heap.pop() == 1, "Heapified should pop 1 first");
assert(heap.pop() == 2, "Heapified should pop 2 second");

print("Heapify test passed");

// Test nlargest
let numbers = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];
let largest = nlargest(3, numbers);

assert(largest.length == 3, "nlargest should return 3 items");
assert(largest[0] == 9, "Largest should be 9");
assert(largest[1] == 6, "Second largest should be 6");
assert(largest[2] == 5, "Third largest should be 5");

print("nlargest test passed");

// Test nsmallest
let smallest = nsmallest(3, numbers);

assert(smallest.length == 3, "nsmallest should return 3 items");
assert(smallest[0] == 1, "Smallest should be 1");
assert(smallest[1] == 1, "Second smallest should be 1");
assert(smallest[2] == 2, "Third smallest should be 2");

print("nsmallest test passed");

// Test clear
let pq2 = MinHeap();
pq2.push(1);
pq2.push(2);
pq2.clear();

assert(pq2.is_empty() == true, "Queue should be empty after clear");

print("Clear test passed");

print("All priority queue tests passed!");
