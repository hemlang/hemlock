// Regression: a throw propagating through INTERMEDIATE frames that
// hold heap locals leaked those frames' locals on every caught
// exception - hml_throw longjmps straight to the nearest try's
// setjmp, skipping every C frame in between, so a frame that
// neither throws nor catches never released its locals. A throw-
// site emit cannot fix this (the throw site doesn't know callers'
// locals); fixed by the unwind-cleanup registry: every owned
// local/temp slot is registered thread-locally, and hml_throw
// releases everything registered after the target handler was
// installed BEFORE its longjmp, while all intermediate frames are
// still alive. See hml_uw_* in runtime/include/hemlock_runtime.h.
//
// Bounded + finite so LeakSanitizer reports at exit; run via
// `run_stress.sh lsan`. Must leak nothing per-iteration.
fn inner(r: i64): i64 {
	if (r >= 0) { throw "x"; }
	return r;
}
fn middle(r: i64): i64 {
	let big = ["a-" + r, "b-" + r, "c-" + r];
	let o = { data: big, tag: "t-" + r };
	let s = "hold-" + r;
	return inner(r) + big.length + o.tag.length + s.length;
}
let round = 0;
let caught = 0;
while (round < 2000) {
	try { let z = middle(round); } catch (e) { caught = caught + 1; }
	round = round + 1;
}
print("throw_indirect_leak: ok caught=" + caught);
