// Test: Closures created in hot loops don't leak
// Exercises: closure env allocation + deallocation at scale

fn run(f) {
    let i = 0;
    while (i < 50000) {
        f();
        i = i + 1;
    }
}

let counter = 0;
run(fn() {
    let obj = { val: counter };
    let arr = [1, 2, 3];
    counter = counter + 1;
});
print("ok");
