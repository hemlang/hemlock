// Test: Parameter reassignment doesn't leak values

fn advance_index(buf, index) {
    let type_id = buf[index];
    index = index + 1;
    let val = buf[index];
    index = index + 1;
    return { type: type_id, value: val, next: index };
}

fn run() {
    let b = buffer(100);
    let j = 0;
    while (j < 100) {
        b.write_u8(j, j);
        j = j + 1;
    }

    let i = 0;
    while (i < 50000) {
        advance_index(b, 0);
        i = i + 1;
    }
}
run();
print("ok");
