// Test: Shared closure environments don't leak
// Exercises: object factories with method closures

fn use_thing(id) {
    let t = {
        id: id,
        get_id: fn() { return self.id; },
        set_id: fn(new_id) { self.id = new_id; },
        describe: fn() { return "Thing #" + self.id; }
    };
    t.set_id(id + 1);
    return t.get_id();
}

fn run() {
    let i = 0;
    while (i < 50000) {
        use_thing(i);
        i = i + 1;
    }
}
run();
print("ok");
