gpu fn math_f64(op: i32, a: gpu_buffer<f64>, b: gpu_buffer<f64>, r: gpu_buffer<f64>) {
    let i: u32 = global_id(0);
    switch (op) {
        case 0: r[i] = sqrt(a[i]); break;
        case 1: r[i] = floor(a[i]); break;
        case 2: r[i] = ceil(a[i]); break;
        case 3: r[i] = exp(a[i]); break;
        case 4: r[i] = log(a[i]); break;
        case 5: r[i] = sin(a[i]); break;
        case 6: r[i] = cos(a[i]); break;
        case 7: r[i] = pow(a[i], b[i]); break;
        case 8: r[i] = abs(a[i]); break;
        case 9: r[i] = min(a[i], b[i]); break;
        case 10: r[i] = max(a[i], b[i]); break;
    }
}
