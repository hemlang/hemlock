        case 2: r[i] = a[i] * b[i]; break;
        case 3: r[i] = a[i] % b[i]; break;
        case 4: d[i] = a[i] / b[i]; break;
        case 5: c[i] = i32(a[i] < b[i]); break;
        case 6: c[i] = i32(a[i] <= b[i]); break;
