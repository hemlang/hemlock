    switch (op) {
        case 0: r[i] = a[i] + b[i]; break;
        case 1: r[i] = a[i] - b[i]; break;
        case 2: r[i] = a[i] * b[i]; break;
        case 3: r[i] = a[i] % b[i]; break;
        case 4: d[i] = a[i] / b[i]; break;
        case 5: c[i] = i32(a[i] < b[i]); break;
        case 6: c[i] = i32(a[i] <= b[i]); break;
        case 7: c[i] = i32(a[i] > b[i]); break;
        case 8: c[i] = i32(a[i] >= b[i]); break;
        case 9: c[i] = i32(a[i] == b[i]); break;
        case 10: c[i] = i32(a[i] != b[i]); break;
        case 11: c[i] = i32(a[i] && b[i]); break;
    }
