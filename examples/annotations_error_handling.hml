// Example: Error Handling with @warn_unused
// Demonstrates @warn_unused annotation for catching ignored return values

// Allocation functions should warn if return value is ignored
fn safe_alloc(size: i32): ptr {
	let p = alloc(size);
	if (p == ptr_null()) {
		panic("Allocation failed");
	}
	return p;
}

// File operations should warn if error checking is skipped
fn try_open(path: string): object {
	try {
		let f = open(path, "r");
		return { success: true, file: f };
	} catch (e) {
		return { success: false, error: e };
	}
}

// Important computations that should not be silently ignored
fn validate_checksum(data: ptr, size: i32): bool {
	let sum = 0;
	for (let i = 0; i < size; i++) {
		sum = sum + ptr_deref_u8(ptr_offset(data, i, 1));
	}
	return sum % 256 == 0;
}

// OK: Return value used
let memory = safe_alloc(1024);
ptr_write_i32(memory, 42);
print(`Allocated and wrote value: ${ptr_deref_i32(memory)}`);

// OK: Return value checked - write a temp file, then try to open it
import { write_file } from "@stdlib/fs";
write_file("/tmp/hml_test_warn_unused.txt", "test data");
let result = try_open("/tmp/hml_test_warn_unused.txt");
if (result.success) {
	print("File opened successfully");
	result.file.close();
} else {
	print(`Failed to open file: ${result.error}`);
}

// OK: Validation result used
let data = alloc(16);
for (let i = 0; i < 16; i++) {
	ptr_write_u8(ptr_offset(data, i, 1), i * 10);
}
let valid = validate_checksum(data, 16);
print(`Checksum valid: ${valid}`);

// WARNING: If you uncomment these, compiler will warn
// safe_alloc(256);              // warning: ignoring return value
// try_open("config.txt");       // warning: ignoring return value
// validate_checksum(data, 16);  // warning: ignoring return value

// Cleanup
free(memory);
free(data);

print("\nDemo complete - @warn_unused helps catch bugs where");
print("important return values (allocations, errors, validations)");
print("are accidentally ignored.");