// Example: Pure Functional Programming
// Demonstrates @const, @pure, and @flatten annotations
import { time_ms } from "@stdlib/time";

// Global state for demonstrating @pure vs @const
let global_multiplier = 2;

// @const: Strictest - no side effects, no global reads
// Result depends ONLY on parameters
fn add(a: i32, b: i32): i32 {
	return a + b;
}
fn multiply(a: i32, b: i32): i32 {
	return a * b;
}
fn square(x: i32): i32 {
	return x * x;
}
// @pure: Can read globals, but no side effects or I/O
// Result is deterministic given same params + global state
fn scale(x: i32): i32 {
	return x * global_multiplier;  // OK: reads global
}

// Regular function: can have side effects
fn log_and_compute(x: i32): i32 {
	print("Computing:", x);  // Side effect!
	return x * 2;
}

// Helper functions for @flatten demo
fn helper1(x: i32): i32 {
	return x + 10;
}
fn helper2(x: i32): i32 {
	return x * 2;
}
fn helper3(x: i32): i32 {
	return x - 5;
}
// @flatten: Inline ALL function calls within this function
// Compiler will inline helper1, helper2, helper3 calls
fn process_pipeline(n: i32): i32 {
	let a = helper1(n);
	let b = helper2(a);
	return helper3(b);
}

// Without @flatten for comparison
fn process_pipeline_normal(n: i32): i32 {
	let a = helper1(n);
	let b = helper2(a);
	return helper3(b);
}

// Complex example: combining annotations
fn distance_squared(x1: i32, y1: i32, x2: i32, y2: i32): i32 {
	let dx = x2 - x1;
	let dy = y2 - y1;
	return add(
		multiply(dx, dx),
		multiply(dy, dy),
	);
}

// @flatten with @const helpers - maximum optimization
fn compute_distances(points: buffer, count: i32): i32 {
	let total = 0;
	for (let i = 0; i < count - 1; i++) {
		let x1 = ptr_read_i32(points, i * 8);
		let y1 = ptr_read_i32(points, i * 8 + 4);
		let x2 = ptr_read_i32(points, (i + 1) * 8);
		let y2 = ptr_read_i32(points, (i + 1) * 8 + 4);
		total = total + distance_squared(x1, y1, x2, y2);
	}
	return total;
}

// Demonstration
print("=== Pure Functional Programming Demo ===\n");

// 1. @const functions - pure computation
print("1. @const Functions (no globals, no side effects)");
print("   add(10, 20) =", add(10, 20));
print("   multiply(5, 7) =", multiply(5, 7));
print("   square(8) =", square(8));
print("   Compiler can optimize: memoize, reorder, eliminate duplicates");
print("");

// 2. @pure functions - can read globals
print("2. @pure Functions (can read globals)");
print("   global_multiplier =", global_multiplier);
print("   scale(10) =", scale(10));
global_multiplier = 3;
print("   global_multiplier =", global_multiplier);
print("   scale(10) =", scale(10), "(different result!)");
print("   Compiler can optimize: eliminate duplicate calls with same args");
print("");

// 3. Regular functions - side effects allowed
print("3. Regular Functions (side effects OK)");
let result = log_and_compute(15);
print("   Result:", result);
print("");

// 4. @flatten - inline all calls
print("4. @flatten Functions (aggressive inlining)");
let pipeline_result = process_pipeline(5);
print("   process_pipeline(5) =", pipeline_result);
print("   Pipeline: 5 -> +10 -> *2 -> -5 = ", pipeline_result);
print("   All helper calls inlined into single function body");
print("");

// 5. Performance comparison: @flatten vs normal
print("5. Performance Benchmark: @flatten vs normal");
let iterations = 100000;

let start = time_ms();
for (let i = 0; i < iterations; i++) {
	process_pipeline(i);
}
let flatten_time = time_ms() - start;

start = time_ms();
for (let i = 0; i < iterations; i++) {
	process_pipeline_normal(i);
}
let normal_time = time_ms() - start;

print("   @flatten version:", flatten_time, "ms");
print("   Normal version:", normal_time, "ms");
if (flatten_time < normal_time) {
	print("   Speedup:", normal_time / flatten_time, "x");
}
print("");

// 6. Complex example: distance computation
print("6. Complex Example: Point Distances");
let points = buffer(32);  // 4 points (x,y pairs)
ptr_write_i32(points, 0, 0);  // point 0: (0, 0)
ptr_write_i32(points, 4, 0);
ptr_write_i32(points, 8, 3);  // point 1: (3, 4)
ptr_write_i32(points, 12, 4);
ptr_write_i32(points, 16, 6);  // point 2: (6, 8)
ptr_write_i32(points, 20, 8);
ptr_write_i32(points, 24, 10);  // point 3: (10, 10)
ptr_write_i32(points, 28, 10);

let total_dist = compute_distances(points, 4);
print("   Total distance squared:", total_dist);
print("   (@flatten + @const: maximum optimization)");
print("");

free(points);

print("=== Annotation Summary ===");
print("@const    - Pure computation (no globals, no I/O)");
print("            Enables: memoization, CSE, reordering");
print("");
print("@pure     - Can read globals, but no side effects");
print("            Enables: duplicate call elimination");
print("");
print("@flatten  - Inline ALL function calls inside");
print("            Reduces call overhead, enables more opts");
print("");
print("Combine annotations for maximum optimization!");