// Memory Management Demo
// 1. sizeof() - Query type sizes
// 1
// 4
// 8
// 8 (on 64-bit systems)
// 2. talloc() - Typed allocation
// allocate 10 i32s (40 bytes)
// Initialize the array using memset
// 3. buffer() - Safe wrapper with bounds checking
// 'H'
// 'e'
// 'l'
// 'l'
// 'o'
// 4. realloc() - Resize allocations
// Clean up
print(sizeof(u8));
print(sizeof(i32));
print(sizeof(f64));
print(sizeof(ptr));
let numbers = talloc(i32, 10);
print(numbers);
let elem_size = sizeof(i32);
let total_bytes = elem_size * 10;
memset(numbers, 0, total_bytes);
let buf = buffer(256);
buf[0] = 72;
buf[1] = 101;
buf[2] = 108;
buf[3] = 108;
buf[4] = 111;
print(buf[0]);
print(buf.length);
let p = alloc(64);
print(p);
p = realloc(p, 128);
print(p);
p = realloc(p, 256);
print(p);
free(numbers);
free(buf);
free(p);
