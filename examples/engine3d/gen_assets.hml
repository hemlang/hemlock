// gen_assets.hml - Generate the demo's texture (.ppm) and model (.obj) assets.
//
// Run this once to populate ./assets:
//     ./hemlock examples/engine3d/gen_assets.hml
//
// Keeping assets as plain PPM/OBJ files lets the demo exercise the real
// texture- and mesh-loading code paths instead of building everything inline.

import { tex_new, tex_save_ppm } from "./texture.hml";
import { rand, seed, floor } from "@stdlib/math";

fn put(tex: object, x: i32, y: i32, r: f64, g: f64, b: f64) {
    let o = (y * tex.w + x) * 3;
    let c = tex.color;
    let ri = clampb(r); let gi = clampb(g); let bi = clampb(b);
    c[o] = ri; c[o + 1] = gi; c[o + 2] = bi;
}

fn clampb(v: f64): i32 {
    let i = i32(v);
    if (i < 0) { i = 0; }
    if (i > 255) { i = 255; }
    return i;
}

// Grass: mottled green with random speckle, like the reference lawn.
fn gen_grass(): object {
    let t = tex_new(64, 64);
    for (let y = 0; y < 64; y++) {
        for (let x = 0; x < 64; x++) {
            let n = (rand() - 0.5) * 60.0;
            put(t, x, y, 60.0 + n * 0.4, 110.0 + n, 45.0 + n * 0.3);
        }
    }
    return t;
}

// White clapboard siding: light horizontal boards with thin shadow gaps.
fn gen_siding(): object {
    let t = tex_new(64, 64);
    for (let y = 0; y < 64; y++) {
        let board = (y % 8);
        let shade = 224.0;
        if (board == 0) { shade = 150.0; }          // shadow line under each board
        else if (board == 1) { shade = 245.0; }     // highlight on board top
        for (let x = 0; x < 64; x++) {
            let n = (rand() - 0.5) * 12.0;
            put(t, x, y, shade + n, shade + n, (shade - 8.0) + n);
        }
    }
    return t;
}

// Asphalt shingle roof: dark grey rows with grainy noise.
fn gen_roof(): object {
    let t = tex_new(64, 64);
    for (let y = 0; y < 64; y++) {
        let row = (y % 6);
        let base = 70.0;
        if (row == 0) { base = 45.0; }
        for (let x = 0; x < 64; x++) {
            let n = (rand() - 0.5) * 24.0;
            // stagger every other row
            let stag = 0.0;
            if (((y / 6) % 2) == 0 && (x % 16) == 0) { stag = -20.0; }
            put(t, x, y, base + n + stag, base + n + stag, (base + 6.0) + n + stag);
        }
    }
    return t;
}

// Red brick: courses of brick with mortar lines (for a chimney / foundation).
fn gen_brick(): object {
    let t = tex_new(64, 64);
    for (let y = 0; y < 64; y++) {
        let course = (y % 16);
        let offset = 0;
        if ((y / 16) % 2 == 1) { offset = 16; }
        for (let x = 0; x < 64; x++) {
            let bx = (x + offset) % 32;
            let mortar = (course < 2) || (bx < 2);
            let n = (rand() - 0.5) * 24.0;
            if (mortar) {
                put(t, x, y, 180.0 + n, 175.0 + n, 165.0 + n);
            } else {
                put(t, x, y, 150.0 + n, 60.0 + n * 0.5, 45.0 + n * 0.5);
            }
        }
    }
    return t;
}

// Wooden crate, used by the OBJ demo cube.
fn gen_crate(): object {
    let t = tex_new(32, 32);
    for (let y = 0; y < 32; y++) {
        for (let x = 0; x < 32; x++) {
            let edge = (x < 2 || x > 29 || y < 2 || y > 29);
            let plank = (x % 8 == 0);
            let n = (rand() - 0.5) * 20.0;
            if (edge) {
                put(t, x, y, 110.0 + n, 70.0 + n, 30.0 + n);
            } else if (plank) {
                put(t, x, y, 130.0 + n, 85.0 + n, 40.0 + n);
            } else {
                put(t, x, y, 170.0 + n, 120.0 + n, 60.0 + n);
            }
        }
    }
    return t;
}

// Write a textured unit-cube OBJ so the demo can exercise load_obj().
fn write_cube_obj(path: string) {
    let s = "# unit cube generated by gen_assets.hml\n";
    s = s + "v -1 -1 -1\nv 1 -1 -1\nv 1 1 -1\nv -1 1 -1\n";
    s = s + "v -1 -1 1\nv 1 -1 1\nv 1 1 1\nv -1 1 1\n";
    s = s + "vt 0 0\nvt 1 0\nvt 1 1\nvt 0 1\n";
    // faces (CCW), v/vt
    s = s + "f 5/1 6/2 7/3\nf 5/1 7/3 8/4\n"; // front +z
    s = s + "f 2/1 1/2 4/3\nf 2/1 4/3 3/4\n"; // back -z
    s = s + "f 1/1 5/2 8/3\nf 1/1 8/3 4/4\n"; // left -x
    s = s + "f 6/1 2/2 3/3\nf 6/1 3/3 7/4\n"; // right +x
    s = s + "f 8/1 7/2 3/3\nf 8/1 3/3 4/4\n"; // top +y
    s = s + "f 1/1 2/2 6/3\nf 1/1 6/3 5/4\n"; // bottom -y
    __write_file(path, s);
}

fn main() {
    seed(1337);
    let dir = "examples/engine3d/assets/";
    tex_save_ppm(gen_grass(),  dir + "grass.ppm");
    tex_save_ppm(gen_siding(), dir + "siding.ppm");
    tex_save_ppm(gen_roof(),   dir + "roof.ppm");
    tex_save_ppm(gen_brick(),  dir + "brick.ppm");
    tex_save_ppm(gen_crate(),  dir + "crate.ppm");
    write_cube_obj(dir + "cube.obj");
    print("assets written to " + dir);
}

main();
