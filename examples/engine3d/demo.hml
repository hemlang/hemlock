// demo.hml - A retro suburban scene rendered with the Hemlock 3D engine.
//
//     ./hemlock examples/engine3d/gen_assets.hml   # once, to build assets
//     ./hemlock examples/engine3d/demo.hml         # render scene.png
//
// House body + gable roof + brick chimney + a tree and a loaded-from-OBJ crate,
// sitting on a grass plane under a dithered sky. Everything is software
// rendered with affine texture mapping for that PlayStation-era wobble.

import { renderer_new, renderer_look_at, render_mesh } from "./engine.hml";
import { fb_new, fb_clear_gradient, fb_save_png } from "./framebuffer.hml";
import { make_cube, make_plane, make_roof, load_obj } from "./mesh.hml";
import { tex_checker, tex_solid, tex_load_ppm } from "./texture.hml";
import { apply_retro } from "./postfx.hml";
import { mat4_mul, mat4_translate, mat4_scale, mat4_rotate_y, vec3 } from "./vec.hml";

const RES_W = 480;
const RES_H = 360;

// Compose a model matrix: translate * rotateY * scale.
fn model(tx: f64, ty: f64, tz: f64, sx: f64, sy: f64, sz: f64, ry: f64): array {
    return mat4_mul(mat4_translate(tx, ty, tz),
                    mat4_mul(mat4_rotate_y(ry), mat4_scale(sx, sy, sz)));
}

fn main() {
    let r = renderer_new(RES_W, RES_H, 0.95, 0.1, 200.0);
    renderer_look_at(r, vec3(6.5, 2.6, 11.5), vec3(0.0, 1.2, 0.0), vec3(0.0, 1.0, 0.0));
    r.cull = 1;
    r.jitter = 0.0;

    let fb = fb_new(RES_W, RES_H);
    fb_clear_gradient(fb, vec3(45.0, 95.0, 185.0), vec3(150.0, 195.0, 235.0));

    // --- Load assets (textures from PPM, crate mesh from OBJ) ---
    let grass  = tex_load_ppm("examples/engine3d/assets/grass.ppm");
    let siding = tex_load_ppm("examples/engine3d/assets/siding.ppm");
    let roof   = tex_load_ppm("examples/engine3d/assets/roof.ppm");
    let brick  = tex_load_ppm("examples/engine3d/assets/brick.ppm");
    let crate_tex = tex_load_ppm("examples/engine3d/assets/crate.ppm");
    let leaves = tex_checker(16, 16, 4, vec3(40.0, 110.0, 45.0), vec3(60.0, 140.0, 55.0));
    let bark   = tex_solid(4, 4, vec3(90.0, 60.0, 35.0));

    let box  = make_cube();
    let plane = make_plane(24.0);
    let roof_mesh = make_roof();
    let crate = load_obj("examples/engine3d/assets/cube.obj");

    print("rendering " + RES_W + "x" + RES_H + " ...");

    // Ground (double-sided so it shows regardless of viewing angle)
    r.cull = 0;
    render_mesh(fb, r, plane, model(0.0, 0.0, 0.0, 60.0, 1.0, 60.0, 0.0), grass);
    r.cull = 1;

    // Main house body: 4 wide, 3 tall, 3.5 deep
    render_mesh(fb, r, box, model(0.0, 1.5, 0.0, 2.0, 1.5, 1.75, 0.0), siding);
    // Main roof
    render_mesh(fb, r, roof_mesh, model(0.0, 3.0, 0.0, 4.2, 1.4, 3.7, 0.0), roof);
    // Brick chimney
    render_mesh(fb, r, box, model(1.1, 3.6, -0.6, 0.3, 0.7, 0.3, 0.0), brick);

    // Attached garage wing (to the right)
    render_mesh(fb, r, box, model(3.5, 0.95, 0.6, 1.4, 0.95, 1.5, 0.0), siding);
    render_mesh(fb, r, roof_mesh, model(3.5, 1.9, 0.6, 3.0, 0.9, 3.2, 0.0), roof);

    // A tree on the left
    render_mesh(fb, r, box, model(-5.0, 1.0, 1.5, 0.3, 1.0, 0.3, 0.0), bark);
    render_mesh(fb, r, box, model(-5.0, 2.7, 1.5, 1.5, 1.4, 1.5, 0.4), leaves);

    // A crate (loaded from OBJ) on the lawn
    render_mesh(fb, r, crate, model(2.6, 0.6, 3.5, 0.6, 0.6, 0.6, 0.5), crate_tex);

    // Retro color crunch: 32 shades/channel (5-bit) + ordered dithering.
    apply_retro(fb, 32, true);

    fb_save_png(fb, "examples/engine3d/scene.png");
    print("wrote examples/engine3d/scene.png");
}

main();
