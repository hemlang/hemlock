// Hemlock Standard Library: File System Operations
// This module provides high-level file and directory operations

// ========== FILE OPERATIONS ==========
export let open = __open;
export let open_fd = __open_fd;
export let fileno = __fileno;
export let exists = __exists;
export let read_file = __read_file;
export let write_file = __write_file;
export let append_file = __append_file;
export let remove_file = __remove_file;
