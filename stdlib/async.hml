// Hemlock Standard Library: Async Utilities
// This module provides ThreadPool for efficient task execution
// ========== THREAD POOL ==========
// A fixed-size thread pool for executing async tasks
// Uses a work queue with worker threads for efficient task distribution
// Work queue (channel of tasks)
// Buffer up to 1000 pending tasks
// Array of result channels for futures
// Worker function - pulls tasks from queue and executes them
// Get next task from queue (blocking)
// Check for shutdown signal (null task)
// Execute the task
// Call function with args using apply()
// Start worker threads
// Submit a task to the pool
// Returns a Future object with get() method
// Collect remaining arguments
// Note: In Hemlock, we can't easily access variadic args
// So we'll just support submit(fn) for now
// Send task to queue
// Return a Future object
// Block until result is available
// Check if result is ready (non-blocking)
// Not ready yet
// Submit with one argument
// Submit with two arguments
// Shutdown the pool gracefully
// Already shutdown
// Send shutdown signals to all workers
// null = shutdown signal
// Wait for all workers to finish
// Return the pool object
// ========== PARALLEL MAP ==========
// Map a function over an array using thread pool
// Submit all tasks
// Collect results
export fn ThreadPool(num_workers: i32) {
	if (num_workers <= 0) {
		panic("ThreadPool requires at least 1 worker");
	}
	let work_queue = channel(1000);
	let result_channels = [];
	let next_task_id = 0;
	let shutdown_flag = false;
	let workers = [];
	async fn worker_loop(queue, id) {
		loop {
			let task = queue.recv();
			if (task == null) {
				break;
			}
			let task_fn = task.func;
			let task_args = task.args;
			let result_ch = task.result_ch;
			try {
				let result = apply(task_fn, task_args);
				result_ch.send({ success: true, value: result });
			} catch (e) {
				result_ch.send({ success: false, error: e });
			}
		}
		return null;
	}
	for (let i = 0; i < num_workers; i++) {
		let w = spawn(worker_loop, work_queue, i);
		workers.push(w);
	}
	fn submit(task_fn) {
		if (shutdown_flag) {
			panic("ThreadPool is shutdown");
		}
		let args_arr = [];
		let result_ch = channel(1);
		let task_id = next_task_id++;
		work_queue.send({ id: task_id, func: task_fn, args: args_arr, result_ch });
		return { id: task_id, get: fn() {
			let result = result_ch.recv();
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
, get_timeout: fn(timeout_ms) {
			let result = result_ch.recv_timeout(timeout_ms);
			if (result == null) {
				return null;
			}
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
 };
	}
	fn submit1(task_fn, arg1) {
		if (shutdown_flag) {
			panic("ThreadPool is shutdown");
		}
		let result_ch = channel(1);
		let task_id = next_task_id++;
		work_queue.send({ id: task_id, func: task_fn, args: [arg1], result_ch });
		return { id: task_id, get: fn() {
			let result = result_ch.recv();
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
, get_timeout: fn(timeout_ms) {
			let result = result_ch.recv_timeout(timeout_ms);
			if (result == null) {
				return null;
			}
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
 };
	}
	fn submit2(task_fn, arg1, arg2) {
		if (shutdown_flag) {
			panic("ThreadPool is shutdown");
		}
		let result_ch = channel(1);
		let task_id = next_task_id++;
		work_queue.send({ id: task_id, func: task_fn, args: [arg1, arg2], result_ch });
		return { id: task_id, get: fn() {
			let result = result_ch.recv();
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
, get_timeout: fn(timeout_ms) {
			let result = result_ch.recv_timeout(timeout_ms);
			if (result == null) {
				return null;
			}
			result_ch.close();
			if (result.success) {
				return result.value;
			} else {
				throw result.error;
			}
		}
 };
	}
	fn shutdown() {
		if (shutdown_flag) {
			return;
		}
		shutdown_flag = true;
		for (let i = 0; i < num_workers; i++) {
			work_queue.send(null);
		}
		for (worker in workers) {
			join(worker);
		}
		work_queue.close();
	}
	return {
		submit,
		submit1,
		submit2,
		shutdown,
		num_workers,
	};
}
export fn parallel_map(arr, map_fn, num_workers?: 4) {
	let pool = ThreadPool(num_workers);
	let futures = [];
	for (item in arr) {
		futures.push(pool.submit1(map_fn, item));
	}
	let results = [];
	for (future in futures) {
		results.push(future.get());
	}
	pool.shutdown();
	return results;
}
