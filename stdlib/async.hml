// Hemlock Standard Library: Async Utilities
// Thread configuration and a fixed-size ThreadPool built on channels.

// ========== THREAD CONFIGURATION ==========

// Get the current default stack size for spawned threads (in bytes)
export fn get_default_stack_size(): i64 {
	return __get_default_stack_size();
}

// Set the default stack size for all subsequent spawn() calls (in bytes)
// Does not affect already-spawned threads.
export fn set_default_stack_size(size: i64) {
	__set_default_stack_size(size);
}

// ========== THREAD POOL ==========
//
// Queueing model
//   submit() pushes a job onto a bounded work channel (back-pressure: submit
//   blocks while the queue is full). Each worker is one spawned task that
//   loops on recv(); recv() blocks while the queue is empty, so idle workers
//   cost nothing. Every job carries its own one-slot result channel; the
//   Future returned by submit() receives from it exactly once and memoizes
//   the outcome, so get() may be called any number of times.
//
// Shutdown
//   shutdown() closes the work channel. Workers keep draining jobs that are
//   already queued; once the channel is empty, recv() returns null and each
//   worker exits. shutdown() then joins every worker, so when it returns all
//   accepted jobs have run and all threads are gone.

// Maximum number of jobs waiting in the pool's queue before submit() blocks
let POOL_QUEUE_CAPACITY = 1000;

// A fixed-size thread pool for executing async tasks
export fn ThreadPool(num_workers: i32) {
	if (num_workers <= 0) {
		panic("ThreadPool requires at least 1 worker");
	}

	let work_queue = channel(POOL_QUEUE_CAPACITY);
	let workers = [];
	let next_job_id = 0;
	let is_shutdown = false;

	// Worker: run queued jobs until the queue is closed and drained.
	async fn worker_loop(queue) {
		loop {
			let job = queue.recv();
			if (job == null) {
				break;
			}
			let outcome = null;
			try {
				outcome = { ok: true, value: apply(job.func, job.args) };
			} catch (e) {
				outcome = { ok: false, error: e };
			}
			job.result_ch.send(outcome);
		}
		return null;
	}

	for (let i = 0; i < num_workers; i++) {
		workers.push(spawn(worker_loop, work_queue));
	}

	// Future: a memoized one-shot receive from the job's result channel.
	fn make_future(id, result_ch) {
		let outcome = null;

		fn settle(received) {
			outcome = received;
			result_ch.close();
		}

		fn unwrap() {
			if (outcome.ok) {
				return outcome.value;
			}
			throw outcome.error;
		}

		return {
			id,
			// Block until the job has run, then return its result or rethrow its error.
			get: fn() {
				if (outcome == null) {
					settle(result_ch.recv());
				}
				return unwrap();
			},
			// Like get(), but returns null if the job has not finished within timeout_ms.
			get_timeout: fn(timeout_ms) {
				if (outcome == null) {
					let received = result_ch.recv_timeout(timeout_ms);
					if (received == null) {
						return null;
					}
					settle(received);
				}
				return unwrap();
			},
		};
	}

	// Queue task_fn(...args) for execution. Returns a Future.
	// (Rest parameters are avoided here: the compiler does not yet support
	// them in nested functions, so the fixed-arity entry points build the
	// argument array themselves.)
	fn enqueue(task_fn, args) {
		if (is_shutdown) {
			panic("ThreadPool is shutdown");
		}
		let result_ch = channel(1);
		let id = next_job_id++;
		work_queue.send({ func: task_fn, args: args, result_ch: result_ch });
		return make_future(id, result_ch);
	}

	fn submit(task_fn) {
		return enqueue(task_fn, []);
	}

	fn submit1(task_fn, arg1) {
		return enqueue(task_fn, [arg1]);
	}

	fn submit2(task_fn, arg1, arg2) {
		return enqueue(task_fn, [arg1, arg2]);
	}

	// Stop accepting jobs, run everything already queued, join all workers.
	fn shutdown() {
		if (is_shutdown) {
			return;
		}
		is_shutdown = true;
		work_queue.close();
		for (worker in workers) {
			join(worker);
		}
	}

	return {
		submit,
		submit1,
		submit2,
		shutdown,
		num_workers,
	};
}

// ========== PARALLEL MAP ==========
// Map a function over an array using a temporary thread pool.
// Results are returned in input order.

export fn parallel_map(arr, map_fn, num_workers?: 4) {
	let pool = ThreadPool(num_workers);
	let futures = [];
	for (item in arr) {
		futures.push(pool.submit1(map_fn, item));
	}

	let results = [];
	for (future in futures) {
		results.push(future.get());
	}

	pool.shutdown();
	return results;
}
