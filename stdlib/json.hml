// Export Note
// ============================================================================
// All functions are automatically exported when imported with:
// import { function_name } from "@stdlib/json";
fn parse(json_str: string) {
	if (typeof(json_str) != "string") {
		throw "parse() requires string argument";
	}
	return json_str.deserialize();
}
fn stringify(value) {
	let t = typeof(value);
	if (t == "null") {
		return "null";
	}
	if (t == "bool") {
		if (value) {
			return "true";
		} else {
			return "false";
		}
	}
	if (t == "string") {
		return escape_json_string(value);
	}
	if (t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "integer" || t == "number") {
		return format_number(value);
	}
	if (t == "array" || t == "object") {
		try {
			return value.serialize();
		} catch (e) {
			throw "JSON stringify error: " + e;
		}
	}
	throw "Cannot stringify value of type: " + t;
}
fn format_number(value) {
	return "" + value;
}
fn parse_file(path: string) {
	let f = open(path, "r");
	defer f.close();
	let content = f.read();
	return parse(content);
}
fn stringify_file(path: string, value) {
	let json = stringify(value);
	let f = open(path, "w");
	defer f.close();
	f.write(json);
	return null;
}
fn format_value(value, depth: i32, indent_str: string): string {
	let value_type = typeof(value);
	if (value_type == "null") {
		return "null";
	}
	if (value_type == "bool") {
		if (value) {
			return "true";
		} else {
			return "false";
		}
	}
	if (value_type == "string") {
		return escape_json_string(value);
	}
	if (value_type == "i8" || value_type == "i16" || value_type == "i32" || value_type == "i64" || value_type == "u8" || value_type == "u16" || value_type == "u32" || value_type == "u64" || value_type == "f32" || value_type == "f64" || value_type == "integer" || value_type == "number") {
		return stringify(value);
	}
	if (value_type == "array") {
		return format_array(value, depth, indent_str);
	}
	if (value_type == "object") {
		return format_object(value, depth, indent_str);
	}
	throw "Cannot format value of type: " + value_type;
}
fn format_array(arr: array, depth: i32, indent_str: string): string {
	if (arr.length == 0) {
		return "[]";
	}
	let result = "[";
	let newline = "\n";
	let current_indent = repeat_string(indent_str, depth + 1);
	let closing_indent = repeat_string(indent_str, depth);
	for (let i = 0; i < arr.length; i++) {
		result = result + (newline + current_indent);
		result = result + format_value(arr[i], depth + 1, indent_str);
		if (i < arr.length - 1) {
			result = result + ",";
		}
	}
	result = result + (newline + closing_indent + "]");
	return result;
}
fn format_object(obj, depth: i32, indent_str: string): string {
	let keys = object_keys(obj);
	if (keys.length == 0) {
		return "{}";
	}
	let result = "{";
	let newline = "\n";
	let current_indent = repeat_string(indent_str, depth + 1);
	let closing_indent = repeat_string(indent_str, depth);
	for (let i = 0; i < keys.length; i++) {
		let key = keys[i];
		let value = obj[key];
		result = result + (newline + current_indent);
		result = result + (escape_json_string(key) + ": ");
		result = result + format_value(value, depth + 1, indent_str);
		if (i < keys.length - 1) {
			result = result + ",";
		}
	}
	result = result + (newline + closing_indent + "}");
	return result;
}
fn escape_json_string(s: string): string {
	let result = "\"";
	for (let i = 0; i < s.length; i++) {
		let ch = s[i];
		if (ch == '"') {
			result = result + "\\\"";
		} else if (ch == '\\') {
	result = result + "\\\\";
} else if (ch == '\n') {
	result = result + "\\n";
} else if (ch == '\r') {
	result = result + "\\r";
} else if (ch == '\t') {
	result = result + "\\t";
} else {
	result = result + ("" + ch);
}
}
result = result + "\"";
return result;
}
fn repeat_string(s: string, count: i32): string {
let result = "";
for (let i = 0; i < count; i++) {
result = result + s;
}
return result;
}
fn object_keys(obj) {
return obj.keys();
}
fn pretty(value, indent?: null) {
let indent_str = "  ";
if (indent != null) {
if (typeof(indent) == "i32" || typeof(indent) == "integer") {
	indent_str = repeat_string(" ", indent);
} else if (typeof(indent) == "string") {
	indent_str = indent;
} else {
	throw "indent must be i32 (spaces) or string";
}
}
return format_value(value, 0, indent_str);
}
fn pretty_file(path: string, value, indent?: null) {
let formatted = pretty(value, indent);
let f = open(path, "w");
defer f.close();
f.write(formatted);
return null;
}
fn is_numeric(s: string): bool {
if (s.length == 0) {
return false;
}
for (let i = 0; i < s.length; i++) {
let ch = s[i];
if (ch < '0' || ch > '9') {
	return false;
}
}
return true;
}
fn parse_int(s: string): i32 {
return i32(s);
}
fn get(obj, path: string, default_val?: null) {
if (path.length == 0) {
return obj;
}
let parts = path.split(".");
let current = obj;
for (let i = 0; i < parts.length; i++) {
if (current == null) {
	return default_val ?? null;
}
let part = parts[i];
if (is_numeric(part)) {
	if (typeof(current) != "array") {
		return default_val ?? null;
	}
	let idx = parse_int(part);
	if (idx < 0 || idx >= current.length) {
		return default_val ?? null;
	}
	current = current[idx];
} else {
	if (typeof(current) != "object") {
		return default_val ?? null;
	}
	current = current[part];
}
}
return current ?? default_val ?? null;
}
fn set(obj, path: string, value) {
if (path.length == 0) {
throw "Cannot set empty path";
}
let parts = path.split(".");
let current = obj;
for (let i = 0; i < parts.length - 1; i++) {
let part = parts[i];
if (is_numeric(part)) {
	let idx = parse_int(part);
	current = current[idx];
} else {
	current = current[part];
}
if (current == null) {
	throw "Path does not exist: " + path;
}
}
let last_part = parts[parts.length - 1];
if (is_numeric(last_part)) {
let idx = parse_int(last_part);
current[idx] = value;
} else {
current[last_part] = value;
}
return null;
}
fn has(obj, path: string): bool {
let sentinel = {};
let result = get(obj, path, sentinel);
return result != sentinel;
}
fn delete(obj, path: string): bool {
if (path.length == 0) {
return false;
}
let parts = path.split(".");
let current = obj;
for (let i = 0; i < parts.length - 1; i++) {
if (current == null) {
	return false;
}
let part = parts[i];
if (is_numeric(part)) {
	if (typeof(current) != "array") {
		return false;
	}
	let idx = parse_int(part);
	if (idx < 0 || idx >= current.length) {
		return false;
	}
	current = current[idx];
} else {
	if (typeof(current) != "object") {
		return false;
	}
	current = current[part];
}
}
let last_part = parts[parts.length - 1];
if (is_numeric(last_part)) {
if (typeof(current) != "array") {
	return false;
}
let idx = parse_int(last_part);
if (idx < 0 || idx >= current.length) {
	return false;
}
current.remove(idx);
return true;
} else {
if (typeof(current) != "object") {
	return false;
}
return current.delete(last_part);
}
}
fn is_valid(json_str: string): bool {
try {
parse(json_str);
return true;
} catch (e) {
return false;
}
}
fn validate(json_str: string) {
try {
parse(json_str);
return { valid: true, message: "Valid JSON", line: 0 };
} catch (e) {
return { valid: false, message: typeof(e), line: -1 };
}
}
fn is_object(value): bool {
let t = typeof(value);
return t == "object";
}
fn is_array(value): bool {
return typeof(value) == "array";
}
fn is_string(value): bool {
return typeof(value) == "string";
}
fn is_number(value): bool {
let t = typeof(value);
return t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "u8" || t == "u16" || t == "u32" || t == "u64" || t == "f32" || t == "f64" || t == "integer" || t == "number";
}
fn is_bool(value): bool {
return typeof(value) == "bool";
}
fn is_null(value): bool {
return typeof(value) == "null";
}
fn type_of(value): string {
let t = typeof(value);
if (is_number(value)) {
return "number";
}
return t;
}
fn clone(value) {
return parse(stringify(value));
}
fn merge(base, update) {
if (!is_object(base) || !is_object(update)) {
return update;
}
let result = clone(base);
throw "merge() requires object iteration support";
return result;
}
fn patch(base, update) {
if (!is_object(base) || !is_object(update)) {
return update;
}
throw "patch() requires object iteration support";
}
fn equals(a, b): bool {
let type_a = typeof(a);
let type_b = typeof(b);
if (type_a != type_b) {
return false;
}
if (type_a == "null" || type_a == "bool" || type_a == "string" || is_number(a)) {
return a == b;
}
if (type_a == "array") {
if (a.length != b.length) {
	return false;
}
for (let i = 0; i < a.length; i++) {
	if (!equals(a[i], b[i])) {
		return false;
	}
}
return true;
}
if (type_a == "object") {
throw "equals() for objects requires object iteration support";
}
return false;
}
