// Hemlock Standard Library: Levenshtein Distance
// Edit distance and fuzzy string matching utilities

// ========== EDIT DISTANCE ==========

// distance(a: string, b: string) -> i32
// Compute Levenshtein distance between two strings
// Returns minimum number of single-character edits (insertions, deletions, substitutions)
export fn distance(a: string, b: string): i32 {
    let m = a.length;
    let n = b.length;

    // Handle edge cases
    if (m == 0) {
        return n;
    }
    if (n == 0) {
        return m;
    }

    // Use two rows instead of full matrix for memory efficiency
    let prev_row = [];
    let curr_row = [];

    // Initialize first row
    for (let j = 0; j <= n; j++) {
        prev_row.push(j);
        curr_row.push(0);
    }

    // Fill matrix
    for (let i = 1; i <= m; i++) {
        curr_row[0] = i;

        for (let j = 1; j <= n; j++) {
            let cost = 0;
            if (a.char_at(i - 1) != b.char_at(j - 1)) {
                cost = 1;
            }

            // Minimum of insert, delete, substitute
            let insert_cost = curr_row[j - 1] + 1;
            let delete_cost = prev_row[j] + 1;
            let subst_cost = prev_row[j - 1] + cost;

            let min_cost = insert_cost;
            if (delete_cost < min_cost) {
                min_cost = delete_cost;
            }
            if (subst_cost < min_cost) {
                min_cost = subst_cost;
            }

            curr_row[j] = min_cost;
        }

        // Swap rows
        let temp = prev_row;
        prev_row = curr_row;
        curr_row = temp;
    }

    return prev_row[n];
}

// ========== SIMILARITY METRICS ==========

// ratio(a: string, b: string) -> f64
// Compute similarity ratio (0.0 to 1.0)
// 1.0 means identical, 0.0 means completely different
export fn ratio(a: string, b: string): f64 {
    if (a.length == 0 && b.length == 0) {
        return 1.0;
    }

    let dist = distance(a, b);
    let max_len = a.length;
    if (b.length > max_len) {
        max_len = b.length;
    }

    return 1.0 - (dist / max_len);
}

// percentage(a: string, b: string) -> i32
// Compute similarity as percentage (0 to 100)
export fn percentage(a: string, b: string): i32 {
    let r = ratio(a, b);
    let result: i32 = r * 100;
    return result;
}

// ========== DAMERAU-LEVENSHTEIN ==========

// damerau_distance(a: string, b: string) -> i32
// Compute Damerau-Levenshtein distance
// Like Levenshtein but also allows transposition of adjacent characters
export fn damerau_distance(a: string, b: string): i32 {
    let m = a.length;
    let n = b.length;

    // Handle edge cases
    if (m == 0) {
        return n;
    }
    if (n == 0) {
        return m;
    }

    // Full matrix needed for transposition
    let d = [];
    for (let i = 0; i <= m; i++) {
        let row = [];
        for (let j = 0; j <= n; j++) {
            row.push(0);
        }
        d.push(row);
    }

    // Initialize
    for (let i = 0; i <= m; i++) {
        d[i][0] = i;
    }
    for (let j = 0; j <= n; j++) {
        d[0][j] = j;
    }

    // Fill matrix
    for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
            let cost = 0;
            if (a.char_at(i - 1) != b.char_at(j - 1)) {
                cost = 1;
            }

            let del = d[i - 1][j] + 1;
            let ins = d[i][j - 1] + 1;
            let sub = d[i - 1][j - 1] + cost;

            let min_val = del;
            if (ins < min_val) {
                min_val = ins;
            }
            if (sub < min_val) {
                min_val = sub;
            }

            // Check for transposition
            if (i > 1 && j > 1 &&
                a.char_at(i - 1) == b.char_at(j - 2) &&
                a.char_at(i - 2) == b.char_at(j - 1)) {
                let trans = d[i - 2][j - 2] + cost;
                if (trans < min_val) {
                    min_val = trans;
                }
            }

            d[i][j] = min_val;
        }
    }

    return d[m][n];
}

// ========== FUZZY MATCHING ==========

// is_similar(a: string, b: string, threshold?: f64) -> bool
// Check if two strings are similar within threshold
export fn is_similar(a: string, b: string, threshold?: 0.8): bool {
    return ratio(a, b) >= threshold;
}

// find_closest(target: string, candidates: array) -> string | null
// Find the most similar string from candidates
export fn find_closest(target: string, candidates: array) {
    if (candidates.length == 0) {
        return null;
    }

    let best_match = candidates[0];
    let best_distance = distance(target, candidates[0]);

    for (let i = 1; i < candidates.length; i++) {
        let d = distance(target, candidates[i]);
        if (d < best_distance) {
            best_distance = d;
            best_match = candidates[i];
        }
    }

    return best_match;
}

// find_closest_n(target: string, candidates: array, n: i32) -> array
// Find the n most similar strings from candidates
export fn find_closest_n(target: string, candidates: array, n: i32): array {
    // Calculate distances for all candidates
    let scored = [];
    for (candidate in candidates) {
        scored.push({
            value: candidate,
            distance: distance(target, candidate),
        });
    }

    // Sort by distance (bubble sort for simplicity)
    for (let i = 0; i < scored.length - 1; i++) {
        for (let j = 0; j < scored.length - i - 1; j++) {
            if (scored[j].distance > scored[j + 1].distance) {
                let temp = scored[j];
                scored[j] = scored[j + 1];
                scored[j + 1] = temp;
            }
        }
    }

    // Take top n
    let result = [];
    let count = n;
    if (count > scored.length) {
        count = scored.length;
    }

    for (let i = 0; i < count; i++) {
        result.push(scored[i].value);
    }

    return result;
}

// find_matches(target: string, candidates: array, max_distance: i32) -> array
// Find all strings within max_distance edits
export fn find_matches(target: string, candidates: array, max_distance: i32): array {
    let matches = [];

    for (candidate in candidates) {
        if (distance(target, candidate) <= max_distance) {
            matches.push(candidate);
        }
    }

    return matches;
}

// find_similar(target: string, candidates: array, min_ratio?: f64) -> array
// Find all strings with similarity above threshold
export fn find_similar(target: string, candidates: array, min_ratio?: 0.6): array {
    let matches = [];

    for (candidate in candidates) {
        if (ratio(target, candidate) >= min_ratio) {
            matches.push(candidate);
        }
    }

    return matches;
}

// ========== EDIT OPERATIONS ==========

// Edit operation types
export let OP_MATCH = 0;     // Characters match (no edit)
export let OP_INSERT = 1;    // Insert character
export let OP_DELETE = 2;    // Delete character
export let OP_SUBSTITUTE = 3; // Substitute character

// get_edits(a: string, b: string) -> array
// Get sequence of edit operations to transform a into b
export fn get_edits(a: string, b: string): array {
    let m = a.length;
    let n = b.length;

    // Build full matrix to trace back
    let d = [];
    for (let i = 0; i <= m; i++) {
        let row = [];
        for (let j = 0; j <= n; j++) {
            row.push(0);
        }
        d.push(row);
    }

    // Initialize
    for (let i = 0; i <= m; i++) {
        d[i][0] = i;
    }
    for (let j = 0; j <= n; j++) {
        d[0][j] = j;
    }

    // Fill matrix
    for (let i = 1; i <= m; i++) {
        for (let j = 1; j <= n; j++) {
            let cost = 0;
            if (a.char_at(i - 1) != b.char_at(j - 1)) {
                cost = 1;
            }

            let del = d[i - 1][j] + 1;
            let ins = d[i][j - 1] + 1;
            let sub = d[i - 1][j - 1] + cost;

            let min_val = del;
            if (ins < min_val) {
                min_val = ins;
            }
            if (sub < min_val) {
                min_val = sub;
            }

            d[i][j] = min_val;
        }
    }

    // Trace back to get operations
    let ops = [];
    let i = m;
    let j = n;

    while (i > 0 || j > 0) {
        if (i > 0 && j > 0 && a.char_at(i - 1) == b.char_at(j - 1)) {
            // Match
            ops.push({ op: OP_MATCH, char: a.char_at(i - 1), pos: i - 1 });
            i = i - 1;
            j = j - 1;
        } else if (i > 0 && j > 0 && d[i][j] == d[i - 1][j - 1] + 1) {
            // Substitution
            ops.push({ op: OP_SUBSTITUTE, from: a.char_at(i - 1), to: b.char_at(j - 1), pos: i - 1 });
            i = i - 1;
            j = j - 1;
        } else if (j > 0 && d[i][j] == d[i][j - 1] + 1) {
            // Insertion
            ops.push({ op: OP_INSERT, char: b.char_at(j - 1), pos: i });
            j = j - 1;
        } else if (i > 0) {
            // Deletion
            ops.push({ op: OP_DELETE, char: a.char_at(i - 1), pos: i - 1 });
            i = i - 1;
        }
    }

    // Reverse to get forward order
    ops.reverse();
    return ops;
}

// ========== STRING COMPARISON UTILITIES ==========

// common_prefix_length(a: string, b: string) -> i32
// Find length of common prefix
export fn common_prefix_length(a: string, b: string): i32 {
    let len = a.length;
    if (b.length < len) {
        len = b.length;
    }

    let i = 0;
    while (i < len && a.char_at(i) == b.char_at(i)) {
        i = i + 1;
    }

    return i;
}

// common_suffix_length(a: string, b: string) -> i32
// Find length of common suffix
export fn common_suffix_length(a: string, b: string): i32 {
    let len = a.length;
    if (b.length < len) {
        len = b.length;
    }

    let i = 0;
    while (i < len && a.char_at(a.length - 1 - i) == b.char_at(b.length - 1 - i)) {
        i = i + 1;
    }

    return i;
}

// common_prefix(a: string, b: string) -> string
// Get common prefix of two strings
export fn common_prefix(a: string, b: string): string {
    let len = common_prefix_length(a, b);
    return a.substr(0, len);
}

// common_suffix(a: string, b: string) -> string
// Get common suffix of two strings
export fn common_suffix(a: string, b: string): string {
    let len = common_suffix_length(a, b);
    if (len == 0) {
        return "";
    }
    return a.substr(a.length - len, len);
}

// ========== SPELL CHECKING HELPERS ==========

// suggest_corrections(word: string, dictionary: array, max_suggestions?: i32) -> array
// Suggest spelling corrections from dictionary
export fn suggest_corrections(word: string, dictionary: array, max_suggestions?: 5): array {
    return find_closest_n(word, dictionary, max_suggestions);
}

// is_misspelling(word: string, dictionary: array, threshold?: i32) -> bool
// Check if word appears to be a misspelling (not in dictionary but close to something)
export fn is_misspelling(word: string, dictionary: array, threshold?: 2): bool {
    // Check if exact match exists
    for (dict_word in dictionary) {
        if (word == dict_word) {
            return false;  // Not a misspelling
        }
    }

    // Check if close to something
    let matches = find_matches(word, dictionary, threshold);
    return matches.length > 0;
}

// ========== CASE-INSENSITIVE VARIANTS ==========

// distance_ignore_case(a: string, b: string) -> i32
// Case-insensitive Levenshtein distance
export fn distance_ignore_case(a: string, b: string): i32 {
    return distance(a.to_lower(), b.to_lower());
}

// ratio_ignore_case(a: string, b: string) -> f64
// Case-insensitive similarity ratio
export fn ratio_ignore_case(a: string, b: string): f64 {
    return ratio(a.to_lower(), b.to_lower());
}

// find_closest_ignore_case(target: string, candidates: array) -> string | null
// Case-insensitive closest match
export fn find_closest_ignore_case(target: string, candidates: array) {
    let lower_target = target.to_lower();
    let best_match = null;
    let best_distance = -1;

    for (candidate in candidates) {
        let d = distance(lower_target, candidate.to_lower());
        if (best_distance < 0 || d < best_distance) {
            best_distance = d;
            best_match = candidate;
        }
    }

    return best_match;
}
