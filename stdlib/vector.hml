// ============================================================================
// Index Configuration (Runtime Tuning)
// ============================================================================

// Set expansion factor for insertion (ef_construction)
// Higher values = better recall but slower insertion
export fn set_expansion_add(idx: VectorIndex, expansion: i64): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_change_expansion_add(idx._handle, expansion, err);
	_check_err(err);
	return null;
}

// Set expansion factor for search (ef)
// Higher values = better recall but slower search
export fn set_expansion_search(idx: VectorIndex, expansion: i64): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_change_expansion_search(idx._handle, expansion, err);
	_check_err(err);
	return null;
}

// Set number of threads for parallel insertion
export fn set_threads_add(idx: VectorIndex, threads: i64): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_change_threads_add(idx._handle, threads, err);
	_check_err(err);
	return null;
}

// Set number of threads for parallel search
export fn set_threads_search(idx: VectorIndex, threads: i64): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_change_threads_search(idx._handle, threads, err);
	_check_err(err);
	return null;
}

// Change the distance metric to a built-in metric kind
export fn set_metric(idx: VectorIndex, metric: i32): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_change_metric_kind(idx._handle, metric, err);
	_check_err(err);
	return null;
}

// Set a user-defined distance metric function
// The function receives two raw pointers to vector data and must return a f32 distance.
// The pointers point to contiguous float data (f32 by default) with idx.dimensions() elements.
//
// metric_fn: Function(a: ptr, b: ptr): f32 — compute distance between two vectors
// metric_kind: Metric kind hint for USearch internals (default: METRIC_UNKNOWN)
// Returns: The callback pointer — caller MUST keep this alive and call free_custom_metric()
//          when done, or when setting a different metric
export fn set_custom_metric(idx: VectorIndex, metric_fn, metric_kind?: 0): ptr {
	_check_alive(idx);
	let metric_cb = __callback(metric_fn, ["ptr", "ptr"], "f32");
	let err = _make_err_holder();
	usearch_change_metric(idx._handle, metric_cb, ptr_null(), metric_kind, err);
	_check_err(err);
	return metric_cb;
}

// Free a custom metric callback created by set_custom_metric()
export fn free_custom_metric(metric_cb: ptr): null {
	__callback_free(metric_cb);
	return null;
}

// Pre-allocate capacity for a known number of vectors
// Avoids repeated internal reallocations during bulk insertion
export fn reserve(idx: VectorIndex, cap: i64): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_reserve(idx._handle, cap, err);
	_check_err(err);
	return null;
}

// Remove all vectors from the index
export fn clear(idx: VectorIndex): null {
	_check_alive(idx);
	let err = _make_err_holder();
	usearch_clear(idx._handle, err);
	_check_err(err);
	return null;
}

// ============================================================================
// Standalone Distance Computation
// ============================================================================

// Compute the distance between two vectors without an index
//
// a: First vector (array of numbers)
// b: Second vector (array of numbers, same length as a)
// metric: Distance metric (default: METRIC_COSINE)
// scalar: Scalar type of input data (default: SCALAR_F32)
// Returns: Distance as f32
export fn distance(a: array, b: array, metric?: 1, scalar?: 1): f32 {
	if (a.length != b.length) {
		throw "vector lengths must match: " + a.length + " vs " + b.length;
	}

	let dims = a.length;
	let a_buf = _pack_vector(a, dims, scalar);
	let b_buf = _pack_vector(b, dims, scalar);

	let err = _make_err_holder();
	let dist = usearch_distance(a_buf, b_buf, scalar, dims, metric, err);
	free(a_buf);
	free(b_buf);
	_check_err(err);
	return dist;
}

// ============================================================================
// Exact Brute-Force Search
// ============================================================================

// Perform exact (brute-force) k-NN search over a dataset without building an index
// Useful for small datasets or when 100% recall is required
//
// dataset: Array of vectors (array of arrays)
// queries: Array of query vectors
// k: Number of nearest neighbors per query (default: 10)
// metric: Distance metric (default: METRIC_COSINE)
// threads: Number of threads for parallel search (default: 1)
// scalar: Scalar type (default: SCALAR_F32)
// Returns: Array of result arrays, each containing { key, distance } objects
//          Keys are 0-based indices into the dataset array
export fn exact_search(dataset: array, queries: array, k?: 10,
	metric?: 1, threads?: 1, scalar?: 1): array {
	if (dataset.length == 0) {
		let empty = [];
		let q = 0;
		while (q < queries.length) {
			empty.push([]);
			q = q + 1;
		}
		return empty;
	}

	let dims = dataset[0].length;
	let n_data = dataset.length;
	let n_queries = queries.length;
	let elem_size = SIZEOF_F32;
	if (scalar == SCALAR_F64) {
		elem_size = SIZEOF_F64;
	}
	let stride = dims * elem_size;

	// Pack dataset into contiguous memory
	let data_buf = alloc(n_data * stride);
	let i = 0;
	while (i < n_data) {
		let vec = dataset[i];
		let j = 0;
		while (j < dims) {
			if (scalar == SCALAR_F64) {
				let val: f64 = vec[j];
				ptr_write_f64(data_buf + i * stride + j * elem_size, val);
			} else {
				let val: f32 = vec[j];
				ptr_write_f32(data_buf + i * stride + j * elem_size, val);
			}
			j = j + 1;
		}
		i = i + 1;
	}

	// Pack queries
	let query_buf = alloc(n_queries * stride);
	i = 0;
	while (i < n_queries) {
		let vec = queries[i];
		let j = 0;
		while (j < dims) {
			if (scalar == SCALAR_F64) {
				let val: f64 = vec[j];
				ptr_write_f64(query_buf + i * stride + j * elem_size, val);
			} else {
				let val: f32 = vec[j];
				ptr_write_f32(query_buf + i * stride + j * elem_size, val);
			}
			j = j + 1;
		}
		i = i + 1;
	}

	// Allocate output buffers
	let keys_stride = k * SIZEOF_U64;
	let dists_stride = k * SIZEOF_F32;
	let keys_buf = alloc(n_queries * keys_stride);
	let dists_buf = alloc(n_queries * dists_stride);

	let err = _make_err_holder();
	usearch_exact_search(
		data_buf, n_data, stride,
		query_buf, n_queries, stride,
		scalar, dims, metric, k, threads,
		keys_buf, keys_stride,
		dists_buf, dists_stride,
		err);

	free(data_buf);
	free(query_buf);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(keys_buf);
		free(dists_buf);
		throw "usearch error: " + msg;
	}
	free(err);

	// Unpack results
	let all_results = [];
	let q = 0;
	while (q < n_queries) {
		let results = [];
		let r = 0;
		while (r < k) {
			let key = ptr_read_u64(keys_buf + q * keys_stride + r * SIZEOF_U64);
			let dist = ptr_read_f32(dists_buf + q * dists_stride + r * SIZEOF_F32);
			results.push({ key: key, distance: dist });
			r = r + 1;
		}
		all_results.push(results);
		q = q + 1;
	}

	free(keys_buf);
	free(dists_buf);
	return all_results;
}
