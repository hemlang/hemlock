//                           usearch_scalar_kind_t, size_t, usearch_metric_kind_t, size_t, size_t,
//                           usearch_key_t*, size_t, usearch_distance_t*, size_t, usearch_error_t*)
extern fn usearch_exact_search(
	dataset: ptr, dataset_size: i64, dataset_stride: i64,
	queries: ptr, queries_size: i64, queries_stride: i64,
	kind: i32, dims: i64, metric: i32, count: i64, threads: i64,
	keys: ptr, keys_stride: i64,
	distances: ptr, distances_stride: i64,
	error: ptr): void;

// ============================================================================
// Internal Helpers
// ============================================================================

// Create and initialize error holder (pointer to char*)
fn _make_err_holder(): ptr {
	let err = alloc(SIZEOF_PTR);
	ptr_write_ptr(err, ptr_null());
	return err;
}

// Check error holder and throw if error occurred, then free holder
fn _check_err(err_holder: ptr): null {
	let err_ptr = ptr_read_ptr(err_holder);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err_holder);
		throw "usearch error: " + msg;
	}
	free(err_holder);
	return null;
}

// Check error holder, throw if error, and free an additional pointer on error
fn _check_err_with_cleanup(err_holder: ptr, cleanup_ptr: ptr): null {
	let err_ptr = ptr_read_ptr(err_holder);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err_holder);
		free(cleanup_ptr);
		throw "usearch error: " + msg;
	}
	free(err_holder);
	return null;
}

// Pack a Hemlock array of numbers into contiguous f32 memory
// Returns: ptr to allocated f32 buffer (caller must free)
fn _pack_f32(arr: array, dims: i64): ptr {
	let buf = alloc(dims * SIZEOF_F32);
	let i = 0;
	while (i < dims) {
		let val: f32 = arr[i];
		ptr_write_f32(buf + i * SIZEOF_F32, val);
		i = i + 1;
	}
	return buf;
}

// Pack a Hemlock array of numbers into contiguous f64 memory
// Returns: ptr to allocated f64 buffer (caller must free)
fn _pack_f64(arr: array, dims: i64): ptr {
	let buf = alloc(dims * SIZEOF_F64);
	let i = 0;
	while (i < dims) {
		let val: f64 = arr[i];
		ptr_write_f64(buf + i * SIZEOF_F64, val);
		i = i + 1;
	}
	return buf;
}

// Pack a Hemlock array into contiguous memory using the appropriate scalar type
fn _pack_vector(arr: array, dims: i64, scalar: i32): ptr {
	if (scalar == 2) {
		return _pack_f64(arr, dims);
	}
	return _pack_f32(arr, dims);
}

// Build usearch_init_options_t struct in memory
fn _build_options(dimensions: i64, metric: i32, quantization: i32,
	connectivity: i64, expansion_add: i64, expansion_search: i64, multi: bool): ptr {
	let opts = alloc(OPTIONS_SIZE);
	memset(opts, 0, OPTIONS_SIZE);
	ptr_write_i32(opts + OPTIONS_METRIC_KIND, metric);
	// opts + OPTIONS_METRIC left as NULL (use built-in metric)
	ptr_write_i32(opts + OPTIONS_QUANTIZATION, quantization);
	ptr_write_i64(opts + OPTIONS_DIMENSIONS, dimensions);
	ptr_write_i64(opts + OPTIONS_CONNECTIVITY, connectivity);
	ptr_write_i64(opts + OPTIONS_EXPANSION_ADD, expansion_add);
	ptr_write_i64(opts + OPTIONS_EXPANSION_SEARCH, expansion_search);
	if (multi) {
		ptr_write_u8(opts + OPTIONS_MULTI, 1);
	}
	return opts;
}

// ============================================================================
// VectorIndex Type
// ============================================================================

define VectorIndex {
	_handle: ptr,
	_dims: i64,
	_freed: bool,
}

// Ensure index is not freed
fn _check_alive(idx: VectorIndex): null {
	if (idx._freed) {
		throw "VectorIndex has been freed";
	}
	return null;
}

// ============================================================================
// Library Info
// ============================================================================

// Get USearch library version string
export fn version(): string {
	let ver_ptr = usearch_version();
	return __cstr_to_string(ver_ptr);
}

// ============================================================================
// Index Lifecycle
// ============================================================================

// Create a new vector index
//
// dimensions: Number of dimensions per vector (required)
// metric: Distance metric (default: METRIC_COSINE)
// quantization: Scalar type for storage quantization (default: SCALAR_F32)
// connectivity: HNSW graph connectivity M (default: 0 = library default, typically 16)
// expansion_add: HNSW expansion factor for insertion ef_construction (default: 0 = library default, typically 128)
// expansion_search: HNSW expansion factor for search ef (default: 0 = library default, typically 64)
// multi: Allow multiple vectors per key (default: false)
export fn create_index(dimensions: i64, metric?: 1, quantization?: 1,
	connectivity?: 0, expansion_add?: 0, expansion_search?: 0, multi?: false): VectorIndex {
	if (dimensions <= 0) {
		throw "dimensions must be positive, got " + dimensions;
	}

	let opts = _build_options(dimensions, metric, quantization,
		connectivity, expansion_add, expansion_search, multi);
	let err = _make_err_holder();

	let handle = usearch_init(opts, err);
	free(opts);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		throw "usearch error: " + msg;
	}
	free(err);

	if (handle == ptr_null()) {
		throw "usearch_init returned null handle";
	}

	// USearch requires reserve() before add() to allocate internal buffers
	let reserve_err = _make_err_holder();
	usearch_reserve(handle, 16, reserve_err);
	_check_err(reserve_err);

	let idx: VectorIndex = { _handle: handle, _dims: dimensions, _freed: false };
	return idx;
}

// Load a previously saved index from disk
//
// path: Path to the saved index file
// dimensions: Override dimensions (default: 0 = read from file metadata)
// metric: Override metric (default: 0 = read from file metadata)
// quantization: Override quantization (default: 0 = read from file metadata)
export fn load_index(path: string, dimensions?: 0, metric?: 0, quantization?: 0): VectorIndex {
	let path_cstr = __string_to_cstr(path);

	// Read metadata from file to get dimensions if not specified
	let actual_dims = dimensions;
	let actual_metric = metric;
	let actual_quant = quantization;

	if (actual_dims == 0 || actual_metric == 0 || actual_quant == 0) {
		let meta_opts = alloc(OPTIONS_SIZE);
		memset(meta_opts, 0, OPTIONS_SIZE);
		let err = _make_err_holder();
		usearch_metadata(path_cstr, meta_opts, err);
		let err_ptr = ptr_read_ptr(err);
		if (err_ptr != ptr_null()) {
			let msg = __cstr_to_string(err_ptr);
			free(err);
			free(meta_opts);
			free(path_cstr);
			throw "usearch error: " + msg;
		}
		free(err);
		if (actual_dims == 0) {
			actual_dims = ptr_read_i64(meta_opts + OPTIONS_DIMENSIONS);
		}
		if (actual_metric == 0) {
			actual_metric = ptr_read_i32(meta_opts + OPTIONS_METRIC_KIND);
		}
		if (actual_quant == 0) {
			actual_quant = ptr_read_i32(meta_opts + OPTIONS_QUANTIZATION);
		}
		free(meta_opts);
	}

	// Create index with discovered/specified options
	let opts = _build_options(actual_dims, actual_metric, actual_quant, 0, 0, 0, false);
	let err = _make_err_holder();
	let handle = usearch_init(opts, err);
	free(opts);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(path_cstr);
		throw "usearch error: " + msg;
	}
	free(err);

	// Load the data
	let err2 = _make_err_holder();
	usearch_load(handle, path_cstr, err2);
	free(path_cstr);

	let err_ptr2 = ptr_read_ptr(err2);
	if (err_ptr2 != ptr_null()) {
		let msg = __cstr_to_string(err_ptr2);
		free(err2);
		let err3 = _make_err_holder();
		usearch_free(handle, err3);
		free(err3);
		throw "usearch error: " + msg;
	}
	free(err2);

	let idx: VectorIndex = { _handle: handle, _dims: actual_dims, _freed: false };
	return idx;
}

// Open a memory-mapped read-only view of an index file
// More memory-efficient than load_index for large indexes
//
// path: Path to the saved index file
// dimensions: Override dimensions (default: 0 = read from file metadata)
// metric: Override metric (default: 0 = read from file metadata)
// quantization: Override quantization (default: 0 = read from file metadata)
export fn view_index(path: string, dimensions?: 0, metric?: 0, quantization?: 0): VectorIndex {
	let path_cstr = __string_to_cstr(path);

	let actual_dims = dimensions;
	let actual_metric = metric;
	let actual_quant = quantization;

	if (actual_dims == 0 || actual_metric == 0 || actual_quant == 0) {
		let meta_opts = alloc(OPTIONS_SIZE);
		memset(meta_opts, 0, OPTIONS_SIZE);
		let err = _make_err_holder();
		usearch_metadata(path_cstr, meta_opts, err);
		let err_ptr = ptr_read_ptr(err);
		if (err_ptr != ptr_null()) {
			let msg = __cstr_to_string(err_ptr);
			free(err);
			free(meta_opts);
			free(path_cstr);
			throw "usearch error: " + msg;
		}
		free(err);
		if (actual_dims == 0) {
			actual_dims = ptr_read_i64(meta_opts + OPTIONS_DIMENSIONS);
		}
		if (actual_metric == 0) {
			actual_metric = ptr_read_i32(meta_opts + OPTIONS_METRIC_KIND);
		}
		if (actual_quant == 0) {
			actual_quant = ptr_read_i32(meta_opts + OPTIONS_QUANTIZATION);
		}
		free(meta_opts);
	}

	let opts = _build_options(actual_dims, actual_metric, actual_quant, 0, 0, 0, false);
	let err = _make_err_holder();
	let handle = usearch_init(opts, err);
	free(opts);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(path_cstr);
		throw "usearch error: " + msg;
	}
	free(err);

	let err2 = _make_err_holder();
	usearch_view(handle, path_cstr, err2);
	free(path_cstr);

	let err_ptr2 = ptr_read_ptr(err2);
	if (err_ptr2 != ptr_null()) {
		let msg = __cstr_to_string(err_ptr2);
		free(err2);
		let err3 = _make_err_holder();
		usearch_free(handle, err3);
		free(err3);
		throw "usearch error: " + msg;
	}
	free(err2);

	let idx: VectorIndex = { _handle: handle, _dims: actual_dims, _freed: false };
	return idx;
}

// Read index metadata from a file without loading the full index
// Returns: { dimensions, metric, quantization }
export fn index_metadata(path: string): object {
	let path_cstr = __string_to_cstr(path);
	let meta_opts = alloc(OPTIONS_SIZE);
	memset(meta_opts, 0, OPTIONS_SIZE);

	let err = _make_err_holder();
	usearch_metadata(path_cstr, meta_opts, err);
	free(path_cstr);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(meta_opts);
		throw "usearch error: " + msg;
	}
	free(err);

	let result = {
		dimensions: ptr_read_i64(meta_opts + OPTIONS_DIMENSIONS),
		metric: ptr_read_i32(meta_opts + OPTIONS_METRIC_KIND),
		quantization: ptr_read_i32(meta_opts + OPTIONS_QUANTIZATION),
		connectivity: ptr_read_i64(meta_opts + OPTIONS_CONNECTIVITY),
	};
	free(meta_opts);
	return result;
}

// Free index resources
// Always call this when done with an index
export fn free_index(idx: VectorIndex): null {
	if (idx._freed) {
		return null;
	}
	let err = _make_err_holder();
	usearch_free(idx._handle, err);
	idx._freed = true;
	// Best-effort free — don't throw on cleanup
	free(err);
	return null;
}

// ============================================================================
// Data Operations
// ============================================================================

// Add a vector to the index
//
// idx: VectorIndex
// key: Unique integer key (u64) identifying this vector
// vector: Array of numbers (length must match index dimensions)
// scalar: Scalar type of input data (default: SCALAR_F32)
export fn add(idx: VectorIndex, key: i64, vector: array, scalar?: 1): null {
	_check_alive(idx);
	if (vector.length != idx._dims) {
		throw "vector length " + vector.length + " does not match index dimensions " + idx._dims;
	}

	let vec_buf = _pack_vector(vector, idx._dims, scalar);

	let err = _make_err_holder();
	usearch_add(idx._handle, key, vec_buf, scalar, err);
	free(vec_buf);
	_check_err(err);
	return null;
}

// Add multiple vectors in batch
//
// idx: VectorIndex
// keys: Array of integer keys
// vectors: Array of arrays (each inner array is a vector)
// scalar: Scalar type of input data (default: SCALAR_F32)
export fn add_batch(idx: VectorIndex, keys: array, vectors: array, scalar?: 1): null {
	_check_alive(idx);
	if (keys.length != vectors.length) {
		throw "keys length " + keys.length + " does not match vectors length " + vectors.length;
	}

	let n = keys.length;
	let i = 0;
	while (i < n) {
		let vec = vectors[i];
		if (vec.length != idx._dims) {
			throw "vector at index " + i + " has length " + vec.length +
				" but index expects " + idx._dims;
		}

		let vec_buf = _pack_vector(vec, idx._dims, scalar);

		let err = _make_err_holder();
		usearch_add(idx._handle, keys[i], vec_buf, scalar, err);
		free(vec_buf);
		_check_err(err);
		i = i + 1;
	}
	return null;
}

// Search for k nearest neighbors
//
// idx: VectorIndex
// query: Query vector (array of numbers, length must match dimensions)
// k: Number of nearest neighbors to return (default: 10)
// scalar: Scalar type of query data (default: SCALAR_F32)
// Returns: Array of { key, distance } objects, sorted by distance ascending
export fn search(idx: VectorIndex, query: array, k?: 10, scalar?: 1): array {
	_check_alive(idx);
	if (query.length != idx._dims) {
		throw "query length " + query.length + " does not match index dimensions " + idx._dims;
	}
	if (k <= 0) {
		throw "k must be positive, got " + k;
	}

	let query_buf = _pack_vector(query, idx._dims, scalar);

	// Allocate output buffers
	let keys_buf = alloc(k * SIZEOF_U64);
	let dists_buf = alloc(k * SIZEOF_F32);

	let err = _make_err_holder();
	let found = usearch_search(idx._handle, query_buf, scalar, k, keys_buf, dists_buf, err);
	free(query_buf);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(keys_buf);
		free(dists_buf);
		throw "usearch error: " + msg;
	}
	free(err);

	// Unpack results
	let results = [];
	let i = 0;
	while (i < found) {
		let key = ptr_read_u64(keys_buf + i * SIZEOF_U64);
		let dist = ptr_read_f32(dists_buf + i * SIZEOF_F32);
		results.push({ key: key, distance: dist });
		i = i + 1;
	}

	free(keys_buf);
	free(dists_buf);
	return results;
}

// Search for k nearest neighbors with a filter predicate
// Only vectors whose keys pass the filter function are considered
//
// idx: VectorIndex
// query: Query vector (array of numbers, length must match dimensions)
// k: Number of nearest neighbors to return (default: 10)
// filter: Function(key: i64): bool — return true to include, false to skip
// scalar: Scalar type of query data (default: SCALAR_F32)
// Returns: Array of { key, distance } objects, sorted by distance ascending
export fn search_filtered(idx: VectorIndex, query: array, k: i64, filter, scalar?: 1): array {
	_check_alive(idx);
	if (query.length != idx._dims) {
		throw "query length " + query.length + " does not match index dimensions " + idx._dims;
	}
	if (k <= 0) {
		throw "k must be positive, got " + k;
	}

	let query_buf = _pack_vector(query, idx._dims, scalar);

	// Wrap the user's filter (key) -> bool into the C signature (key, state) -> i32
	let filter_wrapper = fn(key: i64, state: ptr): i32 {
		if (filter(key)) {
			return 1;
		}
		return 0;
	};
	let filter_cb = __callback(filter_wrapper, ["i64", "ptr"], "i32");

	// Allocate output buffers
	let keys_buf = alloc(k * SIZEOF_U64);
	let dists_buf = alloc(k * SIZEOF_F32);

	let err = _make_err_holder();
	let found = usearch_filtered_search(idx._handle, query_buf, scalar, k,
		filter_cb, ptr_null(), keys_buf, dists_buf, err);
	free(query_buf);
	__callback_free(filter_cb);

	let err_ptr = ptr_read_ptr(err);
	if (err_ptr != ptr_null()) {
		let msg = __cstr_to_string(err_ptr);
		free(err);
		free(keys_buf);
		free(dists_buf);
		throw "usearch error: " + msg;
	}
	free(err);

	// Unpack results
	let results = [];
	let i = 0;
	while (i < found) {
		let key = ptr_read_u64(keys_buf + i * SIZEOF_U64);
		let dist = ptr_read_f32(dists_buf + i * SIZEOF_F32);
		results.push({ key: key, distance: dist });
		i = i + 1;
	}

	free(keys_buf);
	free(dists_buf);
	return results;
}

// Batch search for k nearest neighbors of multiple queries
//
// idx: VectorIndex
// queries: Array of query vectors
// k: Number of nearest neighbors per query (default: 10)
// scalar: Scalar type of query data (default: SCALAR_F32)
// Returns: Array of result arrays (one per query), each containing { key, distance } objects
export fn search_batch(idx: VectorIndex, queries: array, k?: 10, scalar?: 1): array {
	_check_alive(idx);
	if (k <= 0) {
		throw "k must be positive, got " + k;
	}

	let all_results = [];
	let q = 0;
	while (q < queries.length) {
		let result = search(idx, queries[q], k: k, scalar: scalar);
		all_results.push(result);
		q = q + 1;
	}
	return all_results;
}

// Remove a vector by key
// Returns: number of vectors removed (0 if key not found)
export fn remove(idx: VectorIndex, key: i64): i64 {
	_check_alive(idx);
	let err = _make_err_holder();
	let removed = usearch_remove(idx._handle, key, err);
	_check_err(err);
	return removed;
}

// Rename a vector's key
// Returns: number of vectors renamed
export fn rename(idx: VectorIndex, from_key: i64, to_key: i64): i64 {
	_check_alive(idx);
	let err = _make_err_holder();
	let renamed = usearch_rename(idx._handle, from_key, to_key, err);
	_check_err(err);
	return renamed;
}

// Check if a key exists in the index
export fn contains(idx: VectorIndex, key: i64): bool {
	_check_alive(idx);
	let err = _make_err_holder();
	let result = usearch_contains(idx._handle, key, err);
	_check_err(err);
	return result;
}

// Count vectors for a key (useful for multi-indexes where multiple vectors share a key)
export fn count(idx: VectorIndex, key: i64): i64 {
	_check_alive(idx);
	let err = _make_err_holder();
	let result = usearch_count(idx._handle, key, err);
	_check_err(err);
	return result;
}

// Retrieve a stored vector by key
// Returns the vector as an array of f32 values, or null if not found
//
// idx: VectorIndex
// key: Key to look up
// scalar: Scalar type to retrieve as (default: SCALAR_F32)
export fn get(idx: VectorIndex, key: i64, scalar?: 1) {
	_check_alive(idx);

	let elem_size = SIZEOF_F32;
	if (scalar == SCALAR_F64) {
		elem_size = SIZEOF_F64;
	}

	let vec_buf = alloc(idx._dims * elem_size);
	let err = _make_err_holder();
	let found = usearch_get(idx._handle, key, 1, vec_buf, scalar, err);
	_check_err(err);

	if (found == 0) {
		free(vec_buf);
		return null;
	}

	// Unpack vector
	let result = [];
	let i = 0;
	while (i < idx._dims) {
		if (scalar == SCALAR_F64) {
			result.push(ptr_read_f64(vec_buf + i * SIZEOF_F64));
		} else {
			result.push(ptr_read_f32(vec_buf + i * SIZEOF_F32));
		}
		i = i + 1;
	}

	free(vec_buf);
	return result;
}

// ============================================================================
// Persistence
// ============================================================================

// Save index to disk
export fn save(idx: VectorIndex, path: string): null {
	_check_alive(idx);
	let path_cstr = __string_to_cstr(path);
	let err = _make_err_holder();
	usearch_save(idx._handle, path_cstr, err);
	free(path_cstr);
	_check_err(err);
	return null;
}

