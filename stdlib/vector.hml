// @stdlib/vector - Vector similarity search via USearch FFI
//
// Provides high-performance approximate nearest neighbor (ANN) search:
// - Index creation with configurable HNSW parameters
// - Add, search, remove, and retrieve vectors
// - Batch operations for bulk add/search
// - Persistence (save/load/memory-mapped view)
// - Multiple distance metrics (cosine, L2, inner product, etc.)
// - Multiple scalar types (f32, f64, f16, i8, b1)
//
// System Requirements:
// - USearch C library (libusearch_c.so)
// - Install: https://github.com/unum-cloud/usearch
// - On Debian/Ubuntu: sudo apt install libusearch-dev
// - From source: cmake -B build && cmake --build build && sudo cmake --install build
//
// Usage:
// import { create_index, search, add, save, free_index } from "@stdlib/vector";
//
// let idx = create_index(384);
// add(idx, 1, [0.1, 0.2, 0.3, ...]);
// let results = search(idx, [0.15, 0.25, 0.35, ...], k: 10);
// save(idx, "embeddings.usearch");
// free_index(idx);

// Import USearch C library
import "libusearch_c.so";

// ============================================================================
// Distance Metric Constants
// ============================================================================

export let METRIC_UNKNOWN = 0;
export let METRIC_COSINE = 1;
export let METRIC_IP = 2;         // Inner product (dot product)
export let METRIC_L2SQ = 3;       // Euclidean (L2 squared)
export let METRIC_HAVERSINE = 4;  // Geographic distance
export let METRIC_DIVERGENCE = 5; // Jensen-Shannon divergence
export let METRIC_PEARSON = 6;    // Pearson correlation
export let METRIC_JACCARD = 7;    // Jaccard similarity
export let METRIC_HAMMING = 8;    // Hamming distance
export let METRIC_TANIMOTO = 9;   // Tanimoto coefficient
export let METRIC_SORENSEN = 10;  // Sorensen-Dice coefficient

// ============================================================================
// Scalar Type Constants
// ============================================================================

export let SCALAR_UNKNOWN = 0;
export let SCALAR_F32 = 1;
export let SCALAR_F64 = 2;
export let SCALAR_F16 = 3;
export let SCALAR_I8 = 4;
export let SCALAR_B1 = 5;        // Binary (1-bit)
export let SCALAR_BF16 = 6;      // Brain float 16

// ============================================================================
// Struct Layout Constants (usearch_init_options_t on x86_64)
// ============================================================================

// struct usearch_init_options_t {
//     usearch_metric_kind_t metric_kind;   // i32, offset 0
//     /* 4 bytes padding */
//     usearch_metric_t metric;             // ptr, offset 8
//     usearch_scalar_kind_t quantization;  // i32, offset 16
//     /* 4 bytes padding */
//     size_t dimensions;                   // i64, offset 24
//     size_t connectivity;                 // i64, offset 32
//     size_t expansion_add;                // i64, offset 40
//     size_t expansion_search;             // i64, offset 48
//     bool multi;                          // u8, offset 56
//     /* 7 bytes padding */
// };
// Total: 64 bytes

let OPTIONS_SIZE = 64;
let OPTIONS_METRIC_KIND = 0;
let OPTIONS_METRIC = 8;
let OPTIONS_QUANTIZATION = 16;
let OPTIONS_DIMENSIONS = 24;
let OPTIONS_CONNECTIVITY = 32;
let OPTIONS_EXPANSION_ADD = 40;
let OPTIONS_EXPANSION_SEARCH = 48;
let OPTIONS_MULTI = 56;

// Sizes for array element packing
let SIZEOF_F32 = 4;
let SIZEOF_F64 = 8;
let SIZEOF_U64 = 8;
let SIZEOF_PTR = 8;

// ============================================================================
// USearch FFI Bindings
// ============================================================================

