// @stdlib/jinja - Jinja-style template rendering
//
// Provides Jinja2-compatible template syntax for string interpolation,
// control flow, and filters.
//
// Usage:
// import { render, escape } from "@stdlib/jinja";
// let result = render("Hello, {{ name }}!", { name: "World" });
// print(result);  // "Hello, World!"
//
// Supported syntax:
// - Variables: {{ variable }}, {{ object.property }}, {{ array[0] }}
// - Filters: {{ value|upper }}, {{ value|lower }}, {{ value|trim }}
// - Conditionals: {% if cond %}...{% elif cond %}...{% else %}...{% endif %}
// - Loops: {% for item in items %}...{% endfor %}
// - Loop variables: {{ loop.index }}, {{ loop.first }}, {{ loop.last }}
// - Comments: {# this is a comment #}
// - Default values: {{ value|default("fallback") }}

// ============================================================================
// Main API
// ============================================================================

// Render a Jinja-style template with the given context
// Parameters:
// template: string - Template string with Jinja syntax
// context: object - Object containing variables for substitution
// Returns: string - Rendered template
// Throws: On syntax errors or undefined variables
export fn render(template, context): string {
	if (typeof(template) != "string") {
		throw "render() requires string template";
	}
	if (context == null) {
		context = {};
	}
	if (typeof(context) != "object") {
		throw "render() context must be an object";
	}

	return render_template(template, context);
}

// Escape HTML special characters
// Parameters:
// str: string - String to escape
// Returns: string - Escaped string safe for HTML output
export fn escape(str): string {
	if (typeof(str) != "string") {
		str = "" + str;
	}

	let result = "";
	let i = 0;
	while (i < str.length) {
		let c = str.char_at(i);
		if (c == '&') {
			result = result + "&amp;";
		} else if (c == '<') {
			result = result + "&lt;";
		} else if (c == '>') {
			result = result + "&gt;";
		} else if (c == '"') {
			result = result + "&quot;";
		} else if (c == '\'') {
			result = result + "&#39;";
		} else {
			result = result + c;
		}
		i = i + 1;
	}
	return result;
}

// ============================================================================
// Template Parser & Renderer
// ============================================================================

// Token types for the template parser
let TOKEN_TEXT = 0;
let TOKEN_VAR = 1;       // {{ ... }}
let TOKEN_BLOCK = 2;     // {% ... %}
let TOKEN_COMMENT = 3;   // {# ... #}

// Parse template into tokens
fn tokenize(template): array {
	let tokens: array = [];
	let i = 0;
	let text_start = 0;

	while (i < template.length) {
		// Check for special sequences
		if (i + 1 < template.length) {
			let two = template.substr(i, 2);

			// Variable: {{ ... }}
			if (two == "{{") {
				// Save preceding text
				if (i > text_start) {
					tokens.push({ type: TOKEN_TEXT, value: template.slice(text_start, i) });
				}

				let end = find_closing(template, i + 2, "}}");
				if (end < 0) {
					throw "Unclosed variable tag starting at position " + i;
				}

				let content = template.slice(i + 2, end).trim();
				tokens.push({ type: TOKEN_VAR, value: content });
				i = end + 2;
				text_start = i;
				continue;
			}

			// Block: {% ... %}
			if (two == "{%") {
				// Save preceding text
				if (i > text_start) {
					tokens.push({ type: TOKEN_TEXT, value: template.slice(text_start, i) });
				}

				let end = find_closing(template, i + 2, "%}");
				if (end < 0) {
					throw "Unclosed block tag starting at position " + i;
				}

				let content = template.slice(i + 2, end).trim();
				tokens.push({ type: TOKEN_BLOCK, value: content });
				i = end + 2;
				text_start = i;
				continue;
			}

			// Comment: {# ... #}
			if (two == "{#") {
				// Save preceding text
				if (i > text_start) {
					tokens.push({ type: TOKEN_TEXT, value: template.slice(text_start, i) });
				}

				let end = find_closing(template, i + 2, "#}");
				if (end < 0) {
					throw "Unclosed comment tag starting at position " + i;
				}

				// Comments are discarded
				i = end + 2;
				text_start = i;
				continue;
			}
		}

		i = i + 1;
	}

	// Save remaining text
	if (text_start < template.length) {
		tokens.push({ type: TOKEN_TEXT, value: template.slice(text_start, template.length) });
	}

	return tokens;
}

// Find closing delimiter
fn find_closing(template, start, delim): i32 {
	let i = start;
	while (i + delim.length <= template.length) {
		if (template.substr(i, delim.length) == delim) {
			return i;
		}
		i = i + 1;
	}
	return -1;
}

// Render tokenized template
fn render_template(template, context): string {
	let tokens = tokenize(template);
	return render_tokens(tokens, context, 0, tokens.length);
}

// Render a range of tokens
fn render_tokens(tokens, context, start, end): string {
	let result = "";
	let i = start;

	while (i < end) {
		let token = tokens[i];

		if (token.type == TOKEN_TEXT) {
			result = result + token.value;
			i = i + 1;
		} else if (token.type == TOKEN_VAR) {
			result = result + render_variable(token.value, context);
			i = i + 1;
		} else if (token.type == TOKEN_BLOCK) {
			let block_result = render_block(tokens, context, i, end);
			result = result + block_result.output;
			i = block_result.next_index;
		} else {
			i = i + 1;
		}
	}

	return result;
}

// ============================================================================
// Variable Rendering
// ============================================================================

// Render a variable expression with optional filters
fn render_variable(expr, context): string {
	// Split by | for filters
	let parts = split_filters(expr);
	let var_expr = parts[0].trim();

	// Evaluate the variable
	let value = evaluate_expr(var_expr, context);

	// Apply filters
	let i = 1;
	while (i < parts.length) {
		let filter_expr = parts[i].trim();
		value = apply_filter(value, filter_expr, context);
		i = i + 1;
	}

	// Convert to string
	if (value == null) {
		return "";
	}
	return "" + value;
}

// Split expression by | but not inside parentheses
fn split_filters(expr): array {
	let parts: array = [];
	let current = "";
	let paren_depth = 0;
	let i = 0;

	while (i < expr.length) {
		let c = expr.char_at(i);

		if (c == '(') {
			paren_depth = paren_depth + 1;
			current = current + c;
		} else if (c == ')') {
			paren_depth = paren_depth - 1;
			current = current + c;
		} else if (c == '|' && paren_depth == 0) {
			parts.push(current);
			current = "";
		} else {
			current = current + c;
		}

		i = i + 1;
	}

	if (current.length > 0) {
		parts.push(current);
	}

	return parts;
}

// Evaluate a variable expression (supports dot notation and array access)
fn evaluate_expr(expr, context) {
	let trimmed = expr.trim();

	// Check for string literal
	if (trimmed.length >= 2) {
		let first = trimmed.char_at(0);
		let last = trimmed.char_at(trimmed.length - 1);
		if ((first == '"' && last == '"') || (first == '\'' && last == '\'')) {
			return trimmed.slice(1, trimmed.length - 1);
		}
	}

	// Check for number literal
	if (is_number_literal(trimmed)) {
		return parse_number(trimmed);
	}

	// Check for boolean literals
	if (trimmed == "true") {
		return true;
	}
	if (trimmed == "false") {
		return false;
	}
	if (trimmed == "null") {
		return null;
	}

	// Parse path (e.g., "user.name" or "items[0]")
	let parts = parse_path(trimmed);
	let value = context;

	for (part in parts) {
		if (value == null) {
			return null;
		}

		if (part.type == "property") {
			if (typeof(value) == "object") {
				value = get_property(value, part.name);
			} else {
				return null;
			}
		} else if (part.type == "index") {
			if (typeof(value) == "array") {
				let idx: i32 = part.index;
				if (idx >= 0 && idx < value.length) {
					value = value[idx];
				} else {
					return null;
				}
			} else {
				return null;
			}
		}
	}

	return value;
}

// Get property from object using dynamic property access
fn get_property(obj, name) {
	// Hemlock supports obj[name] for dynamic property access
	return obj[name];
}

// Parse a path like "user.name" or "items[0].value"
fn parse_path(path): array {
	let parts: array = [];
	let current = "";
	let i = 0;

	while (i < path.length) {
		let c = path.char_at(i);

		if (c == '.') {
			if (current.length > 0) {
				parts.push({ type: "property", name: current });
				current = "";
			}
		} else if (c == '[') {
			if (current.length > 0) {
				parts.push({ type: "property", name: current });
				current = "";
			}
			// Find closing bracket
			let bracket_end = i + 1;
			while (bracket_end < path.length && path.char_at(bracket_end) != ']') {
				bracket_end = bracket_end + 1;
			}
			let index_str = path.slice(i + 1, bracket_end);
			let idx = parse_int_simple(index_str);
			parts.push({ type: "index", index: idx });
			i = bracket_end;
		} else {
			current = current + c;
		}

		i = i + 1;
	}

	if (current.length > 0) {
		parts.push({ type: "property", name: current });
	}

	return parts;
}

// Check if string is a number literal
fn is_number_literal(s): bool {
	if (s.length == 0) {
		return false;
	}

	let i = 0;
	if (s.char_at(0) == '-') {
		i = 1;
	}

	if (i >= s.length) {
		return false;
	}

	let has_digit = false;
	let has_dot = false;

	while (i < s.length) {
		let c = s.char_at(i);
		let code: i32 = c;

		if (code >= 48 && code <= 57) {
			has_digit = true;
		} else if (c == '.' && !has_dot) {
			has_dot = true;
		} else {
			return false;
		}

		i = i + 1;
	}

	return has_digit;
}

// Parse number from string
fn parse_number(s) {
	let has_dot = s.contains(".");
	if (has_dot) {
		return parse_float_simple(s);
	}
	return parse_int_simple(s);
}

// Simple integer parser
fn parse_int_simple(s): i32 {
	let result: i32 = 0;
	let negative = false;
	let i = 0;

	let trimmed = s.trim();
	if (trimmed.length > 0 && trimmed.char_at(0) == '-') {
		negative = true;
		i = 1;
	}

	while (i < trimmed.length) {
		let c = trimmed.char_at(i);
		let code: i32 = c;
		if (code >= 48 && code <= 57) {
			result = result * 10 + (code - 48);
		}
		i = i + 1;
	}

	if (negative) {
		return -result;
	}
	return result;
}

// Simple float parser
fn parse_float_simple(s): f64 {
	let result: f64 = 0;
	let negative = false;
	let i = 0;
	let decimal_place = 0;
	let in_decimal = false;

	let trimmed = s.trim();
	if (trimmed.length > 0 && trimmed.char_at(0) == '-') {
		negative = true;
		i = 1;
	}

	while (i < trimmed.length) {
		let c = trimmed.char_at(i);
		let code: i32 = c;

		if (c == '.') {
			in_decimal = true;
		} else if (code >= 48 && code <= 57) {
			if (in_decimal) {
				decimal_place = decimal_place + 1;
				let digit: f64 = code - 48;
				let divisor: f64 = 1;
				let j = 0;
				while (j < decimal_place) {
					divisor = divisor * 10;
					j = j + 1;
				}
				result = result + digit / divisor;
			} else {
				result = result * 10 + (code - 48);
			}
		}
		i = i + 1;
	}

	if (negative) {
		return -result;
	}
	return result;
}

// ============================================================================
// Filters
// ============================================================================

// Apply a filter to a value
fn apply_filter(value, filter_expr, context) {
	// Parse filter name and arguments
	let paren_idx = filter_expr.find("(");
	let filter_name = filter_expr;
	let filter_args: array = [];

	if (paren_idx >= 0) {
		filter_name = filter_expr.slice(0, paren_idx);
		let args_str = filter_expr.slice(paren_idx + 1, filter_expr.length - 1);
		filter_args = parse_filter_args(args_str, context);
	}

	filter_name = filter_name.trim();

	// Apply built-in filters
	if (filter_name == "upper") {
		if (typeof(value) == "string") {
			return value.to_upper();
		}
		return "" + value;
	}

	if (filter_name == "lower") {
		if (typeof(value) == "string") {
			return value.to_lower();
		}
		return "" + value;
	}

	if (filter_name == "trim") {
		if (typeof(value) == "string") {
			return value.trim();
		}
		return "" + value;
	}

	if (filter_name == "capitalize") {
		if (typeof(value) == "string" && value.length > 0) {
			let first = value.char_at(0);
			let code: i32 = first;
			if (code >= 97 && code <= 122) {
				let upper: rune = code - 32;
				return upper + value.slice(1, value.length);
			}
		}
		return value;
	}

	if (filter_name == "title") {
		if (typeof(value) == "string") {
			return title_case(value);
		}
		return value;
	}

	if (filter_name == "length") {
		if (typeof(value) == "string") {
			return value.length;
		}
		if (typeof(value) == "array") {
			return value.length;
		}
		return 0;
	}

	if (filter_name == "default") {
		if (value == null || value == "") {
			if (filter_args.length > 0) {
				return filter_args[0];
			}
			return "";
		}
		return value;
	}

	if (filter_name == "first") {
		if (typeof(value) == "array" && value.length > 0) {
			return value[0];
		}
		if (typeof(value) == "string" && value.length > 0) {
			return value.char_at(0);
		}
		return null;
	}

	if (filter_name == "last") {
		if (typeof(value) == "array" && value.length > 0) {
			return value[value.length - 1];
		}
		if (typeof(value) == "string" && value.length > 0) {
			return value.char_at(value.length - 1);
		}
		return null;
	}

	if (filter_name == "join") {
		if (typeof(value) == "array") {
			let sep = "";
			if (filter_args.length > 0) {
				sep = "" + filter_args[0];
			}
			return value.join(sep);
		}
		return "" + value;
	}

	if (filter_name == "reverse") {
		if (typeof(value) == "array") {
			let reversed: array = [];
			let i = value.length - 1;
			while (i >= 0) {
				reversed.push(value[i]);
				i = i - 1;
			}
			return reversed;
		}
		if (typeof(value) == "string") {
			let result = "";
			let i = value.length - 1;
			while (i >= 0) {
				result = result + value.char_at(i);
				i = i - 1;
			}
			return result;
		}
		return value;
	}

	if (filter_name == "sort") {
		if (typeof(value) == "array") {
			return simple_sort(value);
		}
		return value;
	}

	if (filter_name == "escape" || filter_name == "e") {
		return escape("" + value);
	}

	if (filter_name == "replace") {
		if (typeof(value) == "string" && filter_args.length >= 2) {
			let old_str = "" + filter_args[0];
			let new_str = "" + filter_args[1];
			return value.replace_all(old_str, new_str);
		}
		return value;
	}

	if (filter_name == "truncate") {
		if (typeof(value) == "string" && filter_args.length > 0) {
			let max_len: i32 = filter_args[0];
			let suffix = "...";
			if (filter_args.length > 1) {
				suffix = "" + filter_args[1];
			}
			if (value.length > max_len) {
				let cut_len = max_len - suffix.length;
				if (cut_len < 0) {
					cut_len = 0;
				}
				return value.slice(0, cut_len) + suffix;
			}
		}
		return value;
	}

	if (filter_name == "int") {
		return parse_int_simple("" + value);
	}

	if (filter_name == "float") {
		return parse_float_simple("" + value);
	}

	if (filter_name == "string") {
		return "" + value;
	}

	if (filter_name == "abs") {
		if (value < 0) {
			return -value;
		}
		return value;
	}

	if (filter_name == "round") {
		let num: f64 = value;
		let int_part: i64 = num;
		let frac = num - int_part;
		if (frac >= 0.5) {
			return int_part + 1;
		}
		if (frac <= -0.5) {
			return int_part - 1;
		}
		return int_part;
	}

	// Unknown filter - return value unchanged
	return value;
}

// Parse filter arguments
fn parse_filter_args(args_str, context): array {
	let args: array = [];
	let current = "";
	let in_string = false;
	let string_char = ' ';
	let i = 0;

	while (i < args_str.length) {
		let c = args_str.char_at(i);

		if (in_string) {
			if (c == string_char) {
				in_string = false;
				args.push(current);
				current = "";
			} else {
				current = current + c;
			}
		} else if (c == '"' || c == '\'') {
			in_string = true;
			string_char = c;
		} else if (c == ',') {
			if (current.trim().length > 0) {
				args.push(evaluate_expr(current.trim(), context));
			}
			current = "";
		} else {
			current = current + c;
		}

		i = i + 1;
	}

	if (current.trim().length > 0) {
		args.push(evaluate_expr(current.trim(), context));
	}

	return args;
}

// Title case helper
fn title_case(s): string {
	let result = "";
	let capitalize_next = true;
	let i = 0;

	while (i < s.length) {
		let c = s.char_at(i);
		let code: i32 = c;

		if (c == ' ' || c == '\t' || c == '\n') {
			capitalize_next = true;
			result = result + c;
		} else if (capitalize_next && code >= 97 && code <= 122) {
			let upper: rune = code - 32;
			result = result + upper;
			capitalize_next = false;
		} else {
			result = result + c;
			capitalize_next = false;
		}

		i = i + 1;
	}

	return result;
}

// Simple bubble sort for array of strings/numbers
fn simple_sort(arr): array {
	let result: array = [];
	for (item in arr) {
		result.push(item);
	}

	let n = result.length;
	let i = 0;
	while (i < n - 1) {
		let j = 0;
		while (j < n - i - 1) {
			let a = "" + result[j];
			let b = "" + result[j + 1];
			if (a > b) {
				let temp = result[j];
				result[j] = result[j + 1];
				result[j + 1] = temp;
			}
			j = j + 1;
		}
		i = i + 1;
	}

	return result;
}

// ============================================================================
// Block Rendering (if, for, etc.)
// ============================================================================

// Render a block tag and return result with next index
fn render_block(tokens, context, start, end): object {
	let token = tokens[start];
	let block_content = token.value;

	// Parse the block type
	let parts = split_words(block_content);
	if (parts.length == 0) {
		return { output: "", next_index: start + 1 };
	}

	let block_type = parts[0];

	if (block_type == "if") {
		return render_if_block(tokens, context, start, end, parts);
	}

	if (block_type == "for") {
		return render_for_block(tokens, context, start, end, parts);
	}

	// Unknown block type - skip
	return { output: "", next_index: start + 1 };
}

// Split string into words
fn split_words(s): array {
	let words: array = [];
	let current = "";
	let in_string = false;
	let string_char = ' ';
	let i = 0;

	while (i < s.length) {
		let c = s.char_at(i);

		if (in_string) {
			current = current + c;
			if (c == string_char) {
				in_string = false;
			}
		} else if (c == '"' || c == '\'') {
			current = current + c;
			in_string = true;
			string_char = c;
		} else if (c == ' ' || c == '\t') {
			if (current.length > 0) {
				words.push(current);
				current = "";
			}
		} else {
			current = current + c;
		}

		i = i + 1;
	}

	if (current.length > 0) {
		words.push(current);
	}

	return words;
}

// Find matching end block
fn find_end_block(tokens, start, end, end_tag): i32 {
	let depth = 1;
	let i = start + 1;

	// Determine the matching start tag
	let start_tag = "";
	if (end_tag == "endif") {
		start_tag = "if";
	} else if (end_tag == "endfor") {
		start_tag = "for";
	}

	while (i < end) {
		let token = tokens[i];
		if (token.type == TOKEN_BLOCK) {
			let parts = split_words(token.value);
			if (parts.length > 0) {
				if (parts[0] == start_tag) {
					depth = depth + 1;
				} else if (parts[0] == end_tag) {
					depth = depth - 1;
					if (depth == 0) {
						return i;
					}
				}
			}
		}
		i = i + 1;
	}

	return -1;
}

// Find else/elif block at current depth
fn find_else_block(tokens, start, end_idx): object {
	let depth = 1;
	let i = start + 1;

	while (i < end_idx) {
		let token = tokens[i];
		if (token.type == TOKEN_BLOCK) {
			let parts = split_words(token.value);
			if (parts.length > 0) {
				if (parts[0] == "if") {
					depth = depth + 1;
				} else if (parts[0] == "endif") {
					depth = depth - 1;
				} else if (depth == 1 && (parts[0] == "else" || parts[0] == "elif")) {
					return { found: true, index: i, type: parts[0], parts: parts };
				}
			}
		}
		i = i + 1;
	}

	return { found: false, index: -1, type: "", parts: [] };
}

// Render if block
fn render_if_block(tokens, context, start, end, parts): object {
	// Find endif
	let endif_idx = find_end_block(tokens, start, end, "endif");
	if (endif_idx < 0) {
		throw "Missing {% endif %} for {% if %} at position " + start;
	}

	// Extract condition
	let condition_str = "";
	let j = 1;
	while (j < parts.length) {
		if (j > 1) {
			condition_str = condition_str + " ";
		}
		condition_str = condition_str + parts[j];
		j = j + 1;
	}

	// Evaluate condition
	let condition_result = evaluate_condition(condition_str, context);

	if (condition_result) {
		// Find else/elif
		let else_info = find_else_block(tokens, start, endif_idx);
		let body_end = endif_idx;
		if (else_info.found) {
			body_end = else_info.index;
		}

		let output = render_tokens(tokens, context, start + 1, body_end);
		return { output: output, next_index: endif_idx + 1 };
	} else {
		// Look for elif/else
		let else_info = find_else_block(tokens, start, endif_idx);

		if (else_info.found) {
			if (else_info.type == "elif") {
				// Recursively handle elif as new if
				return render_if_block(tokens, context, else_info.index, end, else_info.parts);
			} else {
				// else block
				let output = render_tokens(tokens, context, else_info.index + 1, endif_idx);
				return { output: output, next_index: endif_idx + 1 };
			}
		}

		// No else, return empty
		return { output: "", next_index: endif_idx + 1 };
	}
}

// Evaluate a condition expression
fn evaluate_condition(expr, context): bool {
	let trimmed = expr.trim();

	// Handle "not" prefix
	if (trimmed.starts_with("not ")) {
		let inner = trimmed.slice(4, trimmed.length);
		return !evaluate_condition(inner, context);
	}

	// Handle "and"
	let and_idx = find_operator(trimmed, " and ");
	if (and_idx >= 0) {
		let left = trimmed.slice(0, and_idx);
		let right = trimmed.slice(and_idx + 5, trimmed.length);
		return evaluate_condition(left, context) && evaluate_condition(right, context);
	}

	// Handle "or"
	let or_idx = find_operator(trimmed, " or ");
	if (or_idx >= 0) {
		let left = trimmed.slice(0, or_idx);
		let right = trimmed.slice(or_idx + 4, trimmed.length);
		return evaluate_condition(left, context) || evaluate_condition(right, context);
	}

	// Handle comparisons
	let eq_idx = find_operator(trimmed, "==");
	if (eq_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, eq_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(eq_idx + 2, trimmed.length).trim(), context);
		return left == right;
	}

	let ne_idx = find_operator(trimmed, "!=");
	if (ne_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, ne_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(ne_idx + 2, trimmed.length).trim(), context);
		return left != right;
	}

	let gte_idx = find_operator(trimmed, ">=");
	if (gte_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, gte_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(gte_idx + 2, trimmed.length).trim(), context);
		return left >= right;
	}

	let lte_idx = find_operator(trimmed, "<=");
	if (lte_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, lte_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(lte_idx + 2, trimmed.length).trim(), context);
		return left <= right;
	}

	let gt_idx = find_operator(trimmed, ">");
	if (gt_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, gt_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(gt_idx + 1, trimmed.length).trim(), context);
		return left > right;
	}

	let lt_idx = find_operator(trimmed, "<");
	if (lt_idx >= 0) {
		let left = evaluate_expr(trimmed.slice(0, lt_idx).trim(), context);
		let right = evaluate_expr(trimmed.slice(lt_idx + 1, trimmed.length).trim(), context);
		return left < right;
	}

	// Handle "in" operator
	let in_idx = find_operator(trimmed, " in ");
	if (in_idx >= 0) {
		let needle = evaluate_expr(trimmed.slice(0, in_idx).trim(), context);
		let haystack = evaluate_expr(trimmed.slice(in_idx + 4, trimmed.length).trim(), context);

		if (typeof(haystack) == "array") {
			for (item in haystack) {
				if (item == needle) {
					return true;
				}
			}
			return false;
		}
		if (typeof(haystack) == "string" && typeof(needle) == "string") {
			return haystack.contains(needle);
		}
		return false;
	}

	// Simple truthiness check
	let value = evaluate_expr(trimmed, context);
	return is_truthy(value);
}

// Find operator not inside strings
fn find_operator(s, op): i32 {
	let in_string = false;
	let string_char = ' ';
	let i = 0;

	while (i + op.length <= s.length) {
		let c = s.char_at(i);

		if (in_string) {
			if (c == string_char) {
				in_string = false;
			}
		} else if (c == '"' || c == '\'') {
			in_string = true;
			string_char = c;
		} else {
			if (s.substr(i, op.length) == op) {
				return i;
			}
		}

		i = i + 1;
	}

	return -1;
}

// Check if value is truthy
fn is_truthy(value): bool {
	if (value == null) {
		return false;
	}
	if (value == false) {
		return false;
	}
	if (value == 0) {
		return false;
	}
	if (value == "") {
		return false;
	}
	if (typeof(value) == "array" && value.length == 0) {
		return false;
	}
	return true;
}

// Render for loop block
fn render_for_block(tokens, context, start, end, parts): object {
	// Expected: for item in items
	if (parts.length < 4 || parts[2] != "in") {
		throw "Invalid for loop syntax. Expected: {% for item in items %}";
	}

	let var_name = parts[1];
	let iter_expr = "";
	let k = 3;
	while (k < parts.length) {
		if (k > 3) {
			iter_expr = iter_expr + " ";
		}
		iter_expr = iter_expr + parts[k];
		k = k + 1;
	}

	// Find endfor
	let endfor_idx = find_end_block(tokens, start, end, "endfor");
	if (endfor_idx < 0) {
		throw "Missing {% endfor %} for {% for %} at position " + start;
	}

	// Evaluate iterable
	let iterable = evaluate_expr(iter_expr, context);

	if (iterable == null) {
		return { output: "", next_index: endfor_idx + 1 };
	}

	// Convert to array if needed
	let items: array = [];
	if (typeof(iterable) == "array") {
		items = iterable;
	} else if (typeof(iterable) == "string") {
		// Iterate over characters
		let i = 0;
		while (i < iterable.length) {
			items.push(iterable.char_at(i));
			i = i + 1;
		}
	} else {
		// Single item
		items.push(iterable);
	}

	// Render loop body for each item
	let output = "";
	let idx = 0;
	let total = items.length;

	for (item in items) {
		// Create loop context
		let loop_ctx = create_context_copy(context);
		loop_ctx[var_name] = item;

		// Add loop variable
		loop_ctx["loop"] = {
			index: idx + 1,
			index0: idx,
			first: idx == 0,
			last: idx == total - 1,
			length: total
		};

		output = output + render_tokens(tokens, loop_ctx, start + 1, endfor_idx);
		idx = idx + 1;
	}

	return { output: output, next_index: endfor_idx + 1 };
}

// Create a shallow copy of the context
fn create_context_copy(ctx): object {
	let copy = {};
	let keys = ctx.keys();
	for (key in keys) {
		copy[key] = ctx[key];
	}
	return copy;
}
