// Hemlock Standard Library: Process Management

// Process identification
export let get_pid = __get_pid;
export let get_ppid = __getppid;
export let get_uid = __getuid;
export let get_euid = __geteuid;
export let get_gid = __getgid;
export let get_egid = __getegid;

// Legacy C-style aliases (deprecated, use snake_case versions above)
export let getppid = __getppid;
export let getuid = __getuid;
export let geteuid = __geteuid;
export let getgid = __getgid;
export let getegid = __getegid;

// Process control
export let exit = __exit;
export let kill = __kill;
export let abort = __abort;

// Process creation
export let fork = __fork;
export let wait = __wait;
export let waitpid = __waitpid;

// Command execution
// exec(command) - run shell command
// exec(command, args) - run command with args array (no shell, safe)
export fn exec(cmd, args?: null) {
    if (args == null) {
        return __exec(cmd);
    }
    return __exec(cmd, args);
}

// Safe command execution (no shell, captures stderr)
// Takes array of strings: ["command", "arg1", "arg2", ...]
// Returns: { output: string, stderr: string, exit_code: i32 }
export let exec_argv = __exec_argv;

// Detached spawn primitive backed by posix_spawn(3).
// Unlike exec_argv() which forks, captures stdout/stderr, and waits for the
// child, spawn() returns immediately after the child is created. The caller
// owns the pid and must reap it via waitpid() (or arrange SIGCHLD handling).
//
// argv: array of strings; argv[0] is the program (PATH-resolved unless it
//       contains '/').
// opts (optional object):
//   env:    array of "KEY=value" strings (default: inherit parent environ)
//   stdin:  i32 fd to dup2 onto STDIN_FILENO  in child (default: inherit)
//   stdout: i32 fd to dup2 onto STDOUT_FILENO in child (default: inherit)
//   stderr: i32 fd to dup2 onto STDERR_FILENO in child (default: inherit)
//   cwd:    string; chdir before exec (requires glibc 2.29+ / macOS 10.15+)
//   setsid: bool; child becomes session leader, detaching from the
//           controlling terminal. Requires POSIX_SPAWN_SETSID.
//
// Returns: { pid: i32 }
//
// Exported as `posix_spawn` (not `spawn`) so it does not collide with the
// language-level task `spawn(fn, args...)` builtin in the compiler backend.
export fn posix_spawn(argv, opts?: null) {
    if (opts == null) {
        return __posix_spawn(argv);
    }
    return __posix_spawn(argv, opts);
}