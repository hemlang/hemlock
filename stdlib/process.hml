// Hemlock Standard Library: Process Management

// Process identification
export let get_pid = __get_pid;
export let getppid = __getppid;
export let getuid = __getuid;
export let geteuid = __geteuid;
export let getgid = __getgid;
export let getegid = __getegid;

// Process control
export let exit = __exit;
export let kill = __kill;
export let abort = __abort;

// Process creation
export let fork = __fork;
export let wait = __wait;
export let waitpid = __waitpid;

// Command execution
// exec(command) - run shell command
// exec(command, args) - run command with args array (no shell, safe)
export fn exec(cmd, args?: null) {
    if (args == null) {
        return __exec(cmd);
    }
    return __exec(cmd, args);
}

// Safe command execution (no shell, captures stderr)
// Takes array of strings: ["command", "arg1", "arg2", ...]
// Returns: { output: string, stderr: string, exit_code: i32 }
export let exec_argv = __exec_argv;