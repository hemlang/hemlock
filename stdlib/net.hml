fn parse_address(addr_str: string) {
	let colon_pos = addr_str.find(":");
	if (colon_pos == -1) {
		return null;
	}
	let host = addr_str.substr(0, colon_pos);
	let port_str = addr_str.substr(colon_pos + 1, addr_str.length - colon_pos - 1);
	return { host, port: 8080 };
}
