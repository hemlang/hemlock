// Hemlock Standard Library: Environment Variables
// This module provides environment variable access.
// For process control (exit, get_pid, fork, etc.), use @stdlib/process.

// ========== ENVIRONMENT VARIABLES ==========
export let getenv = __getenv;  // Get environment variable (returns null if not found)
export let setenv = __setenv;  // Set environment variable
export let unsetenv = __unsetenv;  // Unset environment variable

// ========== PROCESS UTILITIES (also available from @stdlib/process) ==========

export let exit = __exit;
export let get_pid = __get_pid;