// Hemlock Standard Library: Mathematical Operations
// This module provides comprehensive math functions and constants

// ========== CONSTANTS ==========
export let PI = __PI;
export let E = __E;
export let TAU = __TAU;
export let INF = __INF;
export let NAN = __NAN;

// ========== TRIGONOMETRIC FUNCTIONS ==========

export let sin = __sin;
export let cos = __cos;
export let tan = __tan;
export let asin = __asin;
export let acos = __acos;
export let atan = __atan;
export let atan2 = __atan2;

// ========== EXPONENTIAL & LOGARITHMIC FUNCTIONS ==========

export let sqrt = __sqrt;
export let pow = __pow;
export let exp = __exp;
export let log = __log;  // Natural logarithm (ln)
export let log10 = __log10;  // Base-10 logarithm
export let log2 = __log2;  // Base-2 logarithm

// ========== DIVISION FUNCTIONS ==========

export let div = __div;    // Float division (same as / operator)
export let divi = __divi;  // Integer division (truncates toward zero)

// ========== ROUNDING FUNCTIONS ==========

export let floor = __floor;
export let ceil = __ceil;
export let round = __round;
export let trunc = __trunc;

// Integer-returning rounding variants
export let floori = __floori;
export let ceili = __ceili;
export let roundi = __roundi;
export let trunci = __trunci;

// ========== UTILITY FUNCTIONS ==========

export let abs = __abs;
export let min = __min;
export let max = __max;
export let clamp = __clamp;

// ========== SIGN & SPECIAL FUNCTIONS ==========

// Return -1, 0, or 1 based on sign of value
export fn sign(x): i32 {
	if (x > 0) { return 1; }
	if (x < 0) { return -1; }
	return 0;
}

// Cube root
export fn cbrt(x): f64 {
	if (x == 0) { return 0.0; }
	if (x < 0) { return -__pow(-x, 1.0 / 3.0); }
	return __pow(x, 1.0 / 3.0);
}

// Hypotenuse: sqrt(x² + y²) without overflow
export fn hypot(x, y): f64 {
	return __sqrt(x * x + y * y);
}

// Greatest common divisor
export fn gcd(a, b): i64 {
	let x: i64 = __abs(a);
	let y: i64 = __abs(b);
	while (y != 0) {
		let t = y;
		y = x % y;
		x = t;
	}
	return x;
}

// Least common multiple
export fn lcm(a, b): i64 {
	if (a == 0 || b == 0) { return 0; }
	let x: i64 = __abs(a);
	let y: i64 = __abs(b);
	return __divi(x, gcd(x, y)) * y;
}

// ========== HYPERBOLIC FUNCTIONS ==========

export fn sinh(x): f64 {
	return (__exp(x) - __exp(-x)) / 2.0;
}

export fn cosh(x): f64 {
	return (__exp(x) + __exp(-x)) / 2.0;
}

export fn tanh(x): f64 {
	let ex = __exp(2.0 * x);
	return (ex - 1.0) / (ex + 1.0);
}

// ========== RANDOM FUNCTIONS ==========

export let rand = __rand;  // Random float [0.0, 1.0)
export let rand_range = __rand_range;  // Random float [min, max)
export let seed = __seed;  // Seed random number generator