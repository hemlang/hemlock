// Hemlock Standard Library: Date & Time Operations
// This module provides date/time formatting, parsing, and arithmetic

// ========== CORE DATE/TIME FUNCTIONS ==========

// Export low-level builtins for direct use
export let localtime = __localtime;  // Convert Unix timestamp to local time components
export let gmtime = __gmtime;  // Convert Unix timestamp to UTC components
export let mktime = __mktime;  // Convert time components to Unix timestamp
export let strftime = __strftime;  // Format date/time with strftime format string

// ========== DATETIME CLASS ==========

// DateTime constructor - creates from Unix timestamp
export fn DateTime(timestamp?: null) {
	let ts = timestamp;
	if (ts == null) {
		ts = __now();
	}

	let components = __localtime(ts);

	return {
		timestamp: ts,
		year: components.year,
		month: components.month,
		day: components.day,
		hour: components.hour,
		minute: components.minute,
		second: components.second,
		weekday: components.weekday,
		yearday: components.yearday,
		isdst: components.isdst,
		format: fn(fmt: string): string {

			// Format using strftime format string
			return __strftime(fmt, self);
		},
		to_string: fn(): string {

			// Common format methods
			return self.format("%Y-%m-%d %H:%M:%S");
		},
		to_date_string: fn(): string {

			return self.format("%Y-%m-%d");
		},
		to_time_string: fn(): string {

			return self.format("%H:%M:%S");
		},
		to_iso_string: fn(): string {

			let utc_components = __gmtime(self.timestamp);
			return __strftime("%Y-%m-%dT%H:%M:%SZ", utc_components);
		},
		add_days: fn(days: i32) {

			// Date arithmetic - add days
			let seconds_per_day = 86400;
			let new_ts = self.timestamp + days * seconds_per_day;
			return DateTime(new_ts);
		},
		add_hours: fn(hours: i32) {

			// Date arithmetic - add hours
			let seconds_per_hour = 3600;
			let new_ts = self.timestamp + hours * seconds_per_hour;
			return DateTime(new_ts);
		},
		add_minutes: fn(minutes: i32) {

			// Date arithmetic - add minutes
			let new_ts = self.timestamp + minutes * 60;
			return DateTime(new_ts);
		},
		add_seconds: fn(seconds: i32) {

			// Date arithmetic - add seconds
			let new_ts = self.timestamp + seconds;
			return DateTime(new_ts);
		},
		diff_days: fn(other) {

			// Get difference in days
			let diff_seconds = self.timestamp - other.timestamp;
			return diff_seconds / 86400;
		},
		diff_hours: fn(other) {

			// Get difference in hours
			let diff_seconds = self.timestamp - other.timestamp;
			return diff_seconds / 3600;
		},
		diff_minutes: fn(other) {

			// Get difference in minutes
			let diff_seconds = self.timestamp - other.timestamp;
			return diff_seconds / 60;
		},
		diff_seconds: fn(other) {

			// Get difference in seconds
			return self.timestamp - other.timestamp;
		},
		is_after: fn(other) {

			// Comparison methods
			return self.timestamp > other.timestamp;
		},
		is_before: fn(other) {

			return self.timestamp < other.timestamp;
		},
		is_equal: fn(other) {

			return self.timestamp == other.timestamp;
		},
		weekday_name: fn(): string {

			// Get weekday name
			let names = [
				"Sunday",
				"Monday",
				"Tuesday",
				"Wednesday",
				"Thursday",
				"Friday",
				"Saturday",
			];
			return names[self.weekday];
		},
		month_name: fn(): string {

			// Get month name
			let names = [
				"",
				"January",
				"February",
				"March",
				"April",
				"May",
				"June",
				"July",
				"August",
				"September",
				"October",
				"November",
				"December",
			];
			return names[self.month];
		},
	};
}

// ========== CONVENIENCE CONSTRUCTORS ==========

// Create DateTime from current time
export fn now() {
	return DateTime(__now());
}

// Create DateTime from date components (local time)
export fn from_date(
	year: i32,
	month: i32,
	day: i32,
	hour?: 0,
	minute?: 0,
	second?: 0,
) {
	let components = {
		year,
		month,
		day,
		hour,
		minute,
		second,
	};
	let timestamp = __mktime(components);
	return DateTime(timestamp);
}

// Unix timestamp for a UTC civil date/time (proleptic Gregorian), using
// Howard Hinnant's days_from_civil. Unlike __mktime this does not depend
// on the process time zone.
fn utc_timestamp(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32): i64 {
	let y: i64 = year;
	if (month <= 2) {
		y = y - 1;
	}
	let era_base: i64 = y;
	if (y < 0) {
		era_base = y - 399;
	}
	let era: i64 = __divi(era_base, 400);
	let yoe: i64 = y - era * 400;
	let mp: i64 = (month + 9) % 12;
	let doy: i64 = __divi(153 * mp + 2, 5) + day - 1;
	let doe: i64 = yoe * 365 + __divi(yoe, 4) - __divi(yoe, 100) + doy;
	let days: i64 = era * 146097 + doe - 719468;
	let h: i64 = hour;
	let mi: i64 = minute;
	let se: i64 = second;
	return days * 86400 + h * 3600 + mi * 60 + se;
}

// Reject out-of-range date/time components instead of letting them roll
// over (2024-13-45 must not become a date in 2025).
fn validate_components(year: i32, month: i32, day: i32, hour: i32, minute: i32, second: i32) {
	if (month < 1 || month > 12) {
		throw "Invalid month: " + month;
	}
	if (day < 1 || day > days_in_month(year, month)) {
		throw "Invalid day: " + day;
	}
	if (hour < 0 || hour > 23) {
		throw "Invalid hour: " + hour;
	}
	if (minute < 0 || minute > 59) {
		throw "Invalid minute: " + minute;
	}
	if (second < 0 || second > 60) {
		throw "Invalid second: " + second;
	}
}

// Create DateTime from UTC date components
export fn from_utc(year: i32, month: i32, day: i32, hour?: 0, minute?: 0, second?: 0) {
	validate_components(year, month, day, hour, minute, second);
	return DateTime(utc_timestamp(year, month, day, hour, minute, second));
}

// ========== PARSING FUNCTIONS ==========

// Parse ISO 8601 date string (YYYY-MM-DD, YYYY-MM-DDTHH:MM:SS, optional Z or +HH:MM)
// Without a zone designator the time is local; Z / +HH:MM / -HH:MM give UTC
// (offset) times. Out-of-range components throw instead of rolling over.
export fn parse_iso(date_str: string) {
	let date_part = date_str;
	let time_part = null;
	if (date_str.contains("T")) {
		let parts = date_str.split("T");
		if (parts.length != 2) {
			throw "Invalid ISO 8601 date: " + date_str;
		}
		date_part = parts[0];
		time_part = parts[1];
	}

	let date_parts = date_part.split("-");
	if (date_parts.length != 3) {
		throw "Invalid ISO 8601 date: " + date_str;
	}
	let year = i32(date_parts[0]);
	let month = i32(date_parts[1]);
	let day = i32(date_parts[2]);

	if (time_part == null) {
		validate_components(year, month, day, 0, 0, 0);
		return from_date(year, month, day, 0, 0, 0);
	}

	// Split off a zone designator: Z, +HH:MM or -HH:MM
	let utc = false;
	let offset_seconds: i64 = 0;
	if (time_part.ends_with("Z")) {
		utc = true;
		time_part = time_part.slice(0, time_part.length - 1);
	} else if (time_part.length > 8) {
		let sign_ch = time_part.char_at(8);
		if (sign_ch == '+' || sign_ch == '-') {
			let zone = time_part.substr(9).split(":");
			if (zone.length != 2) {
				throw "Invalid ISO 8601 offset: " + date_str;
			}
			let zh = i32(zone[0]);
			let zm = i32(zone[1]);
			if (zh < 0 || zh > 23 || zm < 0 || zm > 59) {
				throw "Invalid ISO 8601 offset: " + date_str;
			}
			offset_seconds = zh * 3600 + zm * 60;
			if (sign_ch == '-') {
				offset_seconds = -offset_seconds;
			}
			utc = true;
			time_part = time_part.substr(0, 8);
		}
	}

	let time_parts = time_part.split(":");
	if (time_parts.length != 3) {
		throw "Invalid ISO 8601 time: " + date_str;
	}
	let hour = i32(time_parts[0]);
	let minute = i32(time_parts[1]);
	let second = i32(time_parts[2]);
	validate_components(year, month, day, hour, minute, second);

	if (utc) {
		// Local time = UTC + offset, so UTC = local time - offset
		return DateTime(utc_timestamp(year, month, day, hour, minute, second) - offset_seconds);
	}
	return from_date(year, month, day, hour, minute, second);
}

// ========== UTILITY FUNCTIONS ==========

// Check if a year is a leap year
// Parameters:
// year: i32 - Year to check
// Returns: bool
export fn is_leap_year(year: i32): bool {
	if (year % 4 != 0) { return false; }
	if (year % 100 != 0) { return true; }
	if (year % 400 != 0) { return false; }
	return true;
}

// Get the number of days in a given month
// Parameters:
// year: i32 - Year (needed for February in leap years)
// month: i32 - Month (1-12)
// Returns: i32 - Number of days
export fn days_in_month(year: i32, month: i32): i32 {
	if (month < 1 || month > 12) {
		throw "days_in_month() month must be 1-12, got " + month;
	}

	let days = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
	if (month == 2 && is_leap_year(year)) {
		return 29;
	}
	return days[month];
}

// Get the number of days in a given year
// Parameters:
// year: i32 - Year
// Returns: i32 - 365 or 366
export fn days_in_year(year: i32): i32 {
	if (is_leap_year(year)) { return 366; }
	return 365;
}

// Validate date components
// Parameters:
// year: i32, month: i32, day: i32
// Returns: bool - True if valid
export fn is_valid_date(year: i32, month: i32, day: i32): bool {
	if (month < 1 || month > 12) { return false; }
	if (day < 1) { return false; }
	if (day > days_in_month(year, month)) { return false; }
	return true;
}

// Validate time components
// Parameters:
// hour: i32, minute: i32, second: i32
// Returns: bool - True if valid
export fn is_valid_time(hour: i32, minute: i32, second: i32): bool {
	if (hour < 0 || hour > 23) { return false; }
	if (minute < 0 || minute > 59) { return false; }
	if (second < 0 || second > 59) { return false; }
	return true;
}

// ========== FORMAT STRING REFERENCE ==========
// Supported strftime format codes:
// %Y - 4-digit year (e.g., 2025)
// %y - 2-digit year (e.g., 25)
// %m - Month as number (01-12)
// %B - Full month name (e.g., January)
// %b - Abbreviated month name (e.g., Jan)
// %d - Day of month (01-31)
// %H - Hour (00-23)
// %I - Hour (01-12)
// %M - Minute (00-59)
// %S - Second (00-59)
// %p - AM/PM
// %A - Full weekday name (e.g., Monday)
// %a - Abbreviated weekday name (e.g., Mon)
// %w - Weekday as number (0-6, 0=Sunday)
// %j - Day of year (001-366)
// %% - Literal %