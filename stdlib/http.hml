// @stdlib/http - HTTP client using libwebsockets (statically linked)
// Production-ready HTTP/HTTPS client
// Requires: libwebsockets-dev package (sudo apt-get install libwebsockets-dev)

// Note: libwebsockets functions are now built into hemlock as __lws_* builtins
// No FFI import needed - functions are available directly

// ========== HTTP CLIENT IMPLEMENTATION ==========
fn http_request(method, url, body, headers) {
	return http_request_with_redirects(
		method,
		url,
		body,
		headers,
		0,
	);
}

fn resolve_redirect_url(url, redirect_url) {
	// If redirect URL is relative, make it absolute using the original URL.
	if (redirect_url.starts_with("/")) {
		let scheme_end = url.index_of("://");
		if (scheme_end >= 0) {
			let host_start = scheme_end + 3;
			let host_end = url.index_of("/", host_start);
			if (host_end < 0) {
				host_end = url.length;
			}
			let base = url.substr(0, host_end);
			return base + redirect_url;
		}
	}

	return redirect_url;
}

fn is_redirect_response_status(status) {
	// libwebsockets can report 618 for some redirect handoffs while still exposing Location.
	return status >= 300 && status < 400 || status == 618;
}

fn http_request_with_redirects(method, url, body, headers, redirect_count) {
	// Limit redirects to prevent infinite loops
	if (redirect_count > 10) {
		throw "Too many redirects: " + url;
	}

	let resp_ptr = null;

	// Determine content type from headers or use default
	let content_type = "application/x-www-form-urlencoded";
	if (headers != null && headers.length > 0) {
		for (header in headers) {
			if (header.starts_with("Content-Type:")) {
				content_type = header.substr(14, header.length - 14).trim();
			}
		}
	}

	let has_headers = headers != null && headers.length > 0;

	if (method == "GET") {
		if (has_headers) {
			resp_ptr = __lws_http_get(url, headers);
		} else {
			resp_ptr = __lws_http_get(url);
		}
	} else if (method == "POST") {
		if (has_headers) {
			resp_ptr = __lws_http_post(url, body, content_type, headers);
		} else {
			resp_ptr = __lws_http_post(url, body, content_type);
		}
	} else if (method == "PUT" || method == "DELETE" || method == "PATCH" || method == "HEAD" ||
		method == "OPTIONS") {
		// Use generic request function for other HTTP methods
		if (has_headers) {
			resp_ptr = __lws_http_request(method, url, body, content_type, headers);
		} else {
			resp_ptr = __lws_http_request(method, url, body, content_type);
		}
	} else {
		throw "HTTP method not supported: " + method;
	}

	if (resp_ptr == null) {
		throw "HTTP request failed: " + method + " " + url;
	}

	// Extract response data
	let status = __lws_response_status(resp_ptr);
	let redirect_url = __lws_response_redirect(resp_ptr);
	let response_body = __lws_response_body(resp_ptr);
	let response_headers = __lws_response_headers(resp_ptr);

	// Free C response structure
	__lws_response_free(resp_ptr);

	// Handle redirects
	if (is_redirect_response_status(status) && redirect_url != null) {
		redirect_url = resolve_redirect_url(url, redirect_url);
		// Follow redirect (use GET for 301/302/303)
		return http_request_with_redirects(
			"GET",
			redirect_url,
			"",
			headers,
			redirect_count + 1,
		);
	}

	return { status_code: status, headers: response_headers, body: response_body };
}

// ========== BINARY HTTP REQUEST (for file downloads) ==========

fn http_request_binary(method, url, headers) {
	return http_request_binary_with_redirects(
		method,
		url,
		headers,
		0,
	);
}

fn http_request_binary_with_redirects(method, url, headers, redirect_count) {
	// Limit redirects to prevent infinite loops
	if (redirect_count > 10) {
		throw "Too many redirects: " + url;
	}

	let resp_ptr = null;

	if (method == "GET") {
		if (headers != null && headers.length > 0) {
			resp_ptr = __lws_http_get(url, headers);
		} else {
			resp_ptr = __lws_http_get(url);
		}
	} else {
		throw "Binary download only supports GET method";
	}

	if (resp_ptr == null) {
		throw "HTTP request failed: " + method + " " + url;
	}

	// Extract response data
	let status = __lws_response_status(resp_ptr);
	let redirect_url = __lws_response_redirect(resp_ptr);

	// Handle redirects before getting body
	if (is_redirect_response_status(status) && redirect_url != null) {
		// Free response before following redirect
		__lws_response_free(resp_ptr);

		redirect_url = resolve_redirect_url(url, redirect_url);
		// Follow redirect
		return http_request_binary_with_redirects(
			"GET",
			redirect_url,
			headers,
			redirect_count + 1,
		);
	}

	// Get body as binary buffer (preserves null bytes)
	let response_body = __lws_response_body_binary(resp_ptr);
	let response_headers = __lws_response_headers(resp_ptr);

	// Free C response structure
	__lws_response_free(resp_ptr);

	return { status_code: status, headers: response_headers, body: response_body };
}

// ========== PUBLIC API ==========

export fn get(url, headers) {
	headers = headers ?? [];
	return http_request("GET", url, "", headers);
}

// Get binary data (for file downloads - returns buffer instead of string)
export fn get_binary(url, headers) {
	headers = headers ?? [];
	return http_request_binary("GET", url, headers);
}

export fn post(url, body, headers) {
	body = body ?? "";
	headers = headers ?? [];
	return http_request("POST", url, body, headers);
}

export fn put(url, body, headers) {
	body = body ?? "";
	headers = headers ?? [];
	return http_request("PUT", url, body, headers);
}

export fn delete(url, headers) {
	headers = headers ?? [];
	return http_request("DELETE", url, "", headers);
}

export fn request(method, url, body, headers) {
	body = body ?? "";
	headers = headers ?? [];
	return http_request(method, url, body, headers);
}

// ========== CONVENIENCE FUNCTIONS ==========

export fn fetch(url) {
	let response = get(url, null);
	return response.body;
}

export fn post_json(url, data) {
	let json = data.serialize();
	let headers = ["Content-Type: application/json"];
	return post(url, json, headers);
}

export fn get_json(url) {
	let response = get(url, null);
	return response.body.deserialize();
}

// Buffered download — fetches the whole body into memory then writes
// it to disk in one shot. Fine for small/medium files (HTML, JSON,
// modest binaries). For large artifacts (>100MB), prefer
// download_streaming below to keep memory bounded.
export fn download(url, output_path) {
	let response = get_binary(url, null);

	if (response.status_code < 200 || response.status_code >= 300) {
		throw "download() failed with status " + response.status_code;
	}

	// __open + write_bytes for binary content. f.write only accepts
	// string and would silently no-op (compiled) or throw (interpreter)
	// on a buffer; the analogous compression.hml pipeline uses the same
	// __open pattern.
	let f = __open(output_path, "w");
	f.write_bytes(response.body);
	f.close();

	return true;
}

// Streaming download — opens an HTTP stream, writes binary chunks to
// disk as they arrive. Memory usage is bounded by chunk size, not
// file size. The right API for multi-GB artifacts (model weights,
// archives, etc.).
//
// Returns { status_code, bytes_written } on success. Throws on
// non-2xx status. Writes to <output_path>.partial first and renames
// on completion so a crashed download doesn't leave a half-file
// masquerading as a complete one.
export fn download_streaming(url, output_path) {
	let s = stream("GET", url, "", null, 600000);
	if (s.status_code < 200 || s.status_code >= 300) {
		s.close();
		throw "download_streaming() failed with status " + s.status_code;
	}

	let partial = output_path + ".partial";
	let out = __open(partial, "w");
	let bytes_written: i64 = 0;
	try {
		while (!s.done) {
			let chunk = s.read_binary(60000);
			if (chunk == null) { break; }
			if (chunk.length == 0) { continue; }
			out.write_bytes(chunk);
			bytes_written = bytes_written + chunk.length;
		}
	} catch (e) {
		out.close();
		s.close();
		throw "download_streaming() error mid-transfer: " + e;
	}
	out.close();
	s.close();
	__rename(partial, output_path);

	return { status_code: s.status_code, bytes_written: bytes_written };
}

// ========== STATUS CODE HELPERS ==========

export fn is_success(status_code) {
	return status_code >= 200 && status_code < 300;
}

export fn is_redirect(status_code) {
	return status_code >= 300 && status_code < 400;
}

export fn is_client_error(status_code) {
	return status_code >= 400 && status_code < 500;
}

export fn is_server_error(status_code) {
	return status_code >= 500 && status_code < 600;
}

// ========== URL HELPERS ==========

export fn url_encode(str) {
	let hex_chars = "0123456789ABCDEF";
	let bytes = str.bytes();
	let result = "";

	let i = 0;
	while (i < bytes.length) {
		let b = bytes[i];
		let code: i32 = b;

		// Unreserved characters per RFC 3986: A-Z, a-z, 0-9, -, _, ., ~
		if (code >= 65 && code <= 90 || code >= 97 && code <= 122 ||
			code >= 48 && code <= 57 ||
			code == 45 || code == 95 || code == 46 || code == 126) {
			let ch: rune = b;
			result = result + ch;
		} else {
			let hi = b >> 4 & 15;
			let lo = b & 15;
			result = result + "%" + hex_chars.substr(hi, 1) + hex_chars.substr(lo, 1);
		}
		i = i + 1;
	}
	return result;
}

// ========== TIMEOUT VERSIONS ==========
// These functions allow specifying a custom timeout in milliseconds
// Default timeout is 30000ms (30 seconds)

// Internal: HTTP request with custom timeout
fn http_request_timeout(method, url, body, headers, timeout_ms) {
	return http_request_timeout_with_redirects(method, url, body, headers, 0, timeout_ms);
}

fn http_request_timeout_with_redirects(method, url, body, headers, redirect_count, timeout_ms) {
	// Limit redirects to prevent infinite loops
	if (redirect_count > 10) {
		throw "Too many redirects: " + url;
	}

	let resp_ptr = null;

	// Determine content type from headers or use default
	let content_type = "application/x-www-form-urlencoded";
	if (headers != null && headers.length > 0) {
		for (header in headers) {
			if (header.starts_with("Content-Type:")) {
				content_type = header.substr(14, header.length - 14).trim();
			}
		}
	}

	let has_headers = headers != null && headers.length > 0;

	if (method == "GET") {
		if (has_headers) {
			resp_ptr = __lws_http_get_timeout(url, timeout_ms, headers);
		} else {
			resp_ptr = __lws_http_get_timeout(url, timeout_ms);
		}
	} else if (method == "POST") {
		if (has_headers) {
			resp_ptr = __lws_http_post_timeout(url, body, content_type, timeout_ms, headers);
		} else {
			resp_ptr = __lws_http_post_timeout(url, body, content_type, timeout_ms);
		}
	} else if (method == "PUT" || method == "DELETE" || method == "PATCH" || method == "HEAD" ||
		method == "OPTIONS") {
		if (has_headers) {
			resp_ptr = __lws_http_request_timeout(method, url, body, content_type, timeout_ms, headers);
		} else {
			resp_ptr = __lws_http_request_timeout(method, url, body, content_type, timeout_ms);
		}
	} else {
		throw "HTTP method not supported: " + method;
	}

	if (resp_ptr == null) {
		throw "HTTP request failed: " + method + " " + url;
	}

	// Extract response data
	let status = __lws_response_status(resp_ptr);
	let redirect_url = __lws_response_redirect(resp_ptr);
	let response_body = __lws_response_body(resp_ptr);
	let response_headers = __lws_response_headers(resp_ptr);

	// Free C response structure
	__lws_response_free(resp_ptr);

	// Handle redirects
	if (is_redirect_response_status(status) && redirect_url != null) {
		redirect_url = resolve_redirect_url(url, redirect_url);
		return http_request_timeout_with_redirects("GET", redirect_url, "", headers, redirect_count + 1, timeout_ms);
	}

	return { status_code: status, headers: response_headers, body: response_body };
}

// GET request with custom timeout
// Parameters:
//   url: string - URL to request
//   headers: array<string> - Optional headers (e.g., ["Authorization: Bearer token"])
//   timeout_ms: i32 - Timeout in milliseconds (default 30000)
// Returns: { status_code: i32, headers: string, body: string }
export fn get_timeout(url, headers, timeout_ms) {
	headers = headers ?? [];
	timeout_ms = timeout_ms ?? 30000;
	return http_request_timeout("GET", url, "", headers, timeout_ms);
}

// POST request with custom timeout
export fn post_timeout(url, body, headers, timeout_ms) {
	body = body ?? "";
	headers = headers ?? [];
	timeout_ms = timeout_ms ?? 30000;
	return http_request_timeout("POST", url, body, headers, timeout_ms);
}

// PUT request with custom timeout
export fn put_timeout(url, body, headers, timeout_ms) {
	body = body ?? "";
	headers = headers ?? [];
	timeout_ms = timeout_ms ?? 30000;
	return http_request_timeout("PUT", url, body, headers, timeout_ms);
}

// DELETE request with custom timeout
export fn delete_timeout(url, headers, timeout_ms) {
	headers = headers ?? [];
	timeout_ms = timeout_ms ?? 30000;
	return http_request_timeout("DELETE", url, "", headers, timeout_ms);
}

// Generic request with custom timeout
// Example:
//   let resp = request_timeout("POST", "https://api.example.com/v1/chat", body, headers, 60000);
export fn request_timeout(method, url, body, headers, timeout_ms) {
	body = body ?? "";
	headers = headers ?? [];
	timeout_ms = timeout_ms ?? 30000;
	return http_request_timeout(method, url, body, headers, timeout_ms);
}

// POST JSON with custom timeout (useful for LLM APIs)
// Example:
//   let resp = post_json_timeout("https://api.openai.com/v1/chat/completions", payload, 60000);
export fn post_json_timeout(url, data, timeout_ms) {
	timeout_ms = timeout_ms ?? 30000;
	let json = data.serialize();
	let headers = ["Content-Type: application/json"];
	return http_request_timeout("POST", url, json, headers, timeout_ms);
}

// ========== STREAMING HTTP ==========
// For chunked/SSE responses (e.g., streaming LLM output)

// Open a streaming HTTP connection that returns data incrementally.
// Returns a stream object with .read(), .close(), .status_code, .headers, .done
//
// Usage:
//   let s = stream("POST", url, body, headers, 120000);
//   while (!s.done) {
//       let chunk = s.read(30000);
//       if (chunk != null) { print(chunk); }
//   }
//   s.close();
export fn stream(method, url, body, headers, timeout_ms) {
	method = method ?? "GET";
	body = body ?? "";
	timeout_ms = timeout_ms ?? 120000;

	// Determine content type from headers
	let content_type = "application/x-www-form-urlencoded";
	if (headers != null && headers.length > 0) {
		for (header in headers) {
			if (header.starts_with("Content-Type:")) {
				content_type = header.substr(14, header.length - 14).trim();
			}
		}
	}

	let stream_ptr = __lws_http_stream_start(method, url, body, content_type, timeout_ms);
	let status = __lws_http_stream_status(stream_ptr);
	let hdrs = __lws_http_stream_headers(stream_ptr);
	let is_done = false;

	return {
		status_code: status,
		headers: hdrs,
		done: is_done,
		_ptr: stream_ptr,
		read: fn(read_timeout_ms) {
			read_timeout_ms = read_timeout_ms ?? 30000;
			if (self.done) { return null; }
			let chunk = __lws_http_stream_read(self._ptr, read_timeout_ms);
			if (chunk == null) {
				self.done = true;
			}
			return chunk;
		},
		// Same as read() but returns a buffer (preserves null bytes in
		// binary payloads). Use for downloading non-text content over a
		// streamed connection — text read() goes through val_string
		// which strlen-truncates.
		read_binary: fn(read_timeout_ms) {
			read_timeout_ms = read_timeout_ms ?? 30000;
			if (self.done) { return null; }
			let chunk = __lws_http_stream_read_binary(self._ptr, read_timeout_ms);
			if (chunk == null) {
				self.done = true;
			}
			return chunk;
		},
		close: fn() {
			if (self._ptr != null) {
				__lws_http_stream_close(self._ptr);
				self._ptr = null;
				self.done = true;
			}
		},
	};
}

// Stream a GET request
// Example: let s = stream_get("https://example.com/events", null, 60000);
export fn stream_get(url, headers, timeout_ms) {
	return stream("GET", url, "", headers, timeout_ms);
}

// Stream a POST request (useful for LLM APIs)
// Example: let s = stream_post("https://api.openai.com/v1/chat/completions", body, headers, 120000);
export fn stream_post(url, body, headers, timeout_ms) {
	return stream("POST", url, body, headers, timeout_ms);
}

// POST JSON and stream the response (convenience for LLM APIs)
// Automatically serializes data and sets Content-Type: application/json
//
// Example:
//   let s = post_json_stream("https://api.openai.com/v1/chat/completions", {
//       model: "gpt-4",
//       messages: [{ role: "user", content: "Hello" }],
//       stream: true
//   }, 120000);
//   while (!s.done) {
//       let chunk = s.read(30000);
//       if (chunk != null) { print(chunk); }
//   }
//   s.close();
export fn post_json_stream(url, data, timeout_ms) {
	timeout_ms = timeout_ms ?? 120000;
	let json = data.serialize();
	let headers = ["Content-Type: application/json"];
	return stream("POST", url, json, headers, timeout_ms);
}

// Stream Server-Sent Events (SSE)
// Returns a stream object with .next_event() that parses SSE protocol
// Each event is returned as { event: string, data: string, id: string }
//
// SSE format:
//   event: message\n
//   data: {"text":"hello"}\n
//   id: 123\n
//   \n
//
// Example:
//   let sse = stream_sse("https://api.example.com/events", null, 120000);
//   while (!sse.done) {
//       let event = sse.next_event();
//       if (event != null) {
//           print("Event: " + event.event + " Data: " + event.data);
//       }
//   }
//   sse.close();
export fn stream_sse(url, headers, timeout_ms) {
	timeout_ms = timeout_ms ?? 120000;
	headers = headers ?? [];

	// Ensure Accept: text/event-stream is set
	let has_accept = false;
	for (header in headers) {
		if (header.starts_with("Accept:")) { has_accept = true; }
	}
	if (!has_accept) {
		headers.push("Accept: text/event-stream");
	}

	let base_stream = stream("GET", url, "", headers, timeout_ms);
	let buffer = "";

	return {
		status_code: base_stream.status_code,
		headers: base_stream.headers,
		done: base_stream.done,
		_stream: base_stream,
		_buffer: buffer,
		next_event: fn(read_timeout_ms) {
			read_timeout_ms = read_timeout_ms ?? 30000;

			// Keep reading until we have a complete event (double newline)
			while (true) {
				// Check if buffer contains a complete event
				let event_end = self._buffer.find("\n\n");
				if (event_end < 0) {
					// Also check \r\n\r\n
					event_end = self._buffer.find("\r\n\r\n");
					if (event_end >= 0) {
						event_end = event_end;  // adjust for \r\n\r\n
					}
				}

				if (event_end >= 0) {
					let event_str = self._buffer.substr(0, event_end);
					// Skip past the double newline
					let skip = event_end + 2;
					if (self._buffer.find("\r\n\r\n") == event_end) {
						skip = event_end + 4;
					}
					self._buffer = self._buffer.substr(skip, self._buffer.length - skip);

					// Parse SSE event
					let event_type = "message";
					let data_parts = [];
					let event_id = "";

					let lines = event_str.split("\n");
					for (line in lines) {
						// Strip \r if present
						if (line.length > 0 && line.ends_with("\r")) {
							line = line.substr(0, line.length - 1);
						}

						if (line.starts_with("data: ")) {
							data_parts.push(line.substr(6, line.length - 6));
						} else if (line.starts_with("data:")) {
							data_parts.push(line.substr(5, line.length - 5));
						} else if (line.starts_with("event: ")) {
							event_type = line.substr(7, line.length - 7);
						} else if (line.starts_with("event:")) {
							event_type = line.substr(6, line.length - 6);
						} else if (line.starts_with("id: ")) {
							event_id = line.substr(4, line.length - 4);
						} else if (line.starts_with("id:")) {
							event_id = line.substr(3, line.length - 3);
						}
						// Lines starting with : are comments, skip
					}

					let data = data_parts.join("\n");

					// Skip empty events
					if (data.length == 0 && event_type == "message") {
						continue;  // Try to get the next event
					}

					return { event: event_type, data, id: event_id };
				}

				// No complete event in buffer, read more data
				if (self._stream.done) {
					self.done = true;
					return null;
				}

				let chunk = self._stream.read(read_timeout_ms);
				if (chunk == null) {
					self.done = true;
					return null;
				}
				self._buffer = self._buffer + chunk;
			}
		},
		close: fn() {
			self._stream.close();
			self.done = true;
		},
	};
}

// ========== HTTP SERVER ==========

import { TcpListener } from "@stdlib/net";

// HttpServer - Simple HTTP server for handling requests
// Usage:
// let server = HttpServer("127.0.0.1", 8080);
// server.route("GET", "/", fn(req) { return { status: 200, body: "Hello!" }; });
// server.route("POST", "/api", fn(req) { return { status: 200, body: req.body }; });
// server.serve(10);  // Handle 10 requests then stop
// server.close();
export fn HttpServer(host: string, port: i32) {
	let listener = TcpListener(host, port);
	let routes = [];

	return {
		host,
		port,
		_listener: listener,
		_routes: routes,
		route: fn(method: string, path: string, handler) {

			// Register a route handler
			// handler(req) should return { status: i32, body: string, content_type?: string }
			self._routes.push({ method, path, handler });
		},
		handle_one: fn() {

			// Handle a single request and return
			let stream = self._listener.accept();
			defer stream.close();

			// Read the request
			let request_buf = stream.read(8192);
			let request_str = request_buf.to_string();

			// Parse request
			let req = self._parse_request(request_str);

			// Find matching route
			let response = self._handle_request(req);

			// Send response
			let response_str = self._build_response(response);
			stream.write(response_str);
		},
		serve: fn(count: i32) {

			// Serve requests until count is reached (0 = infinite)
			let handled = 0;
			while (count == 0 || handled < count) {
				self.handle_one();
				handled++;
			}
		},
		serve_async: fn(count: i32) {

			// Serve requests in background (async)
			let srv = self;
			return spawn(fn() {
				srv.serve(count);
			}
);
		},
		close: fn() {

			// Close the server
			self._listener.close();
		},
		_parse_request: fn(request_str: string) {

			// Internal: Parse HTTP request string into object
			let lines = request_str.split("\r\n");
			let first_line = lines[0];
			let parts = first_line.split(" ");

			let method = parts[0];
			let path = parts[1];
			let version = "HTTP/1.1";
			if (parts.length > 2) {
				version = parts[2];
			}

			// Parse headers
			let headers = {};
			let body_start = -1;
			for (let i = 1; i < lines.length; i++) {
				let line = lines[i];
				if (line == "") {
					body_start = i + 1;
					break;
				}
				let colon = line.find(":");
				if (colon > 0) {
					let key = line.substr(0, colon).trim().to_lower();
					let value = line.substr(colon + 1, line.length - colon - 1).trim();
					headers[key] = value;
				}
			}

			// Extract body
			let body = "";
			if (body_start > 0 && body_start < lines.length) {
				let body_lines = [];
				for (let j = body_start; j < lines.length; j++) {
					body_lines.push(lines[j]);
				}
				body = body_lines.join("\r\n");
			}

			return { method, path, version, headers, body };
		},
		_handle_request: fn(req) {

			// Internal: Find route and call handler
			for (route in self._routes) {
				if (route.method == req.method && route.path == req.path) {
					return route.handler(req);
				}
			}

			// No route found - return 404
			return {
				status: 404,
				body: `{"error": "Not Found", "path": "` + req.path + `"}`,
				content_type: "application/json",
			};
		},
		_build_response: fn(response) {

			// Internal: Build HTTP response string
			let status = response.status ?? 200;
			let body = response.body ?? "";
			let content_type = response.content_type ?? "text/plain";

			let status_text = "OK";
			if (status == 201) {
				status_text = "Created";
			} else if (status == 204) {
				status_text = "No Content";
			} else if (status == 400) {
				status_text = "Bad Request";
			} else if (status == 401) {
				status_text = "Unauthorized";
			} else if (status == 403) {
				status_text = "Forbidden";
			} else if (status == 404) {
				status_text = "Not Found";
			} else if (status == 405) {
				status_text = "Method Not Allowed";
			} else if (status == 500) {
				status_text = "Internal Server Error";
			}

			let resp = "HTTP/1.1 " + status + " " + status_text + "\r\n";
			resp = resp + ("Content-Type: " + content_type + "\r\n");
			resp = resp + ("Content-Length: " + body.length + "\r\n");
			resp = resp + "Connection: close\r\n";
			resp = resp + "\r\n";
			resp = resp + body;

			return resp;
		},
	};
}

// ========== NOTES ==========
//
// This module uses libwebsockets via FFI for production HTTP/HTTPS support.
//
// Features:
// - Native HTTP and HTTPS support
// - SSL/TLS via libwebsockets
// - No dependency on curl binary
// - Production performance
// - Simple HTTP server for testing and lightweight use cases
//
// Requirements:
// - libwebsockets-dev package installed
// - Compiled lws_wrapper.so (run: make stdlib)
//
// Current limitations:
// - Custom headers partially supported (Content-Type works)
// - Response headers not yet parsed (returns empty string)
// - download() only checks status, doesn't write to file (needs file I/O)
// - url_encode() only encodes common characters (not RFC 3986 compliant)
// - HttpServer is single-threaded and handles one request at a time
//