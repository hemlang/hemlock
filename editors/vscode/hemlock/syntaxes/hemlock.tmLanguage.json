{
  "name": "Hemlock",
  "scopeName": "source.hemlock",
  "fileTypes": ["hml"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#template-strings" },
    { "include": "#strings" },
    { "include": "#runes" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.hemlock",
          "match": "//.*$"
        },
        {
          "name": "comment.block.hemlock",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.hemlock",
          "match": "\\b(if|else|while|for|in|return|break|continue|switch|case|default)\\b"
        },
        {
          "name": "keyword.control.async.hemlock",
          "match": "\\b(async|await|spawn|join|detach)\\b"
        },
        {
          "name": "keyword.control.exception.hemlock",
          "match": "\\b(try|catch|finally|throw|panic)\\b"
        },
        {
          "name": "keyword.control.defer.hemlock",
          "match": "\\b(defer)\\b"
        },
        {
          "name": "keyword.control.import.hemlock",
          "match": "\\b(import|from|export)\\b"
        },
        {
          "name": "storage.type.function.hemlock",
          "match": "\\b(fn)\\b"
        },
        {
          "name": "storage.type.hemlock",
          "match": "\\b(let|define|const)\\b"
        },
        {
          "name": "storage.type.enum.hemlock",
          "match": "\\b(enum)\\b"
        },
        {
          "name": "variable.language.hemlock",
          "match": "\\b(self|args)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.numeric.hemlock",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64)\\b"
        },
        {
          "name": "storage.type.primitive.hemlock",
          "match": "\\b(bool|string|rune|ptr|buffer|array|object|void|null|file|task|channel)\\b"
        },
        {
          "name": "storage.type.alias.hemlock",
          "match": "\\b(integer|number|byte)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.hemlock",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "constant.language.signal.hemlock",
          "match": "\\b(SIGINT|SIGTERM|SIGQUIT|SIGHUP|SIGABRT|SIGUSR1|SIGUSR2|SIGALRM|SIGCHLD|SIGCONT|SIGSTOP|SIGTSTP|SIGPIPE|SIGTTIN|SIGTTOU)\\b"
        },
        {
          "name": "constant.language.math.hemlock",
          "match": "\\b(PI|E|TAU|INF|NAN)\\b"
        },
        {
          "name": "constant.language.socket.hemlock",
          "match": "\\b(AF_INET|AF_INET6|SOCK_STREAM|SOCK_DGRAM|IPPROTO_TCP|IPPROTO_UDP|SOL_SOCKET|SO_REUSEADDR|SO_KEEPALIVE|SO_RCVTIMEO|SO_SNDTIMEO|POLLIN|POLLOUT|POLLERR|POLLHUP|POLLNVAL|POLLPRI)\\b"
        },
        {
          "name": "constant.language.regex.hemlock",
          "match": "\\b(REG_ICASE)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hemlock",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.hemlock",
              "match": "\\\\(n|t|r|\\\\|\"|'|0|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.hemlock",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "runes": {
      "patterns": [
        {
          "name": "string.quoted.single.hemlock",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.hemlock",
              "match": "\\\\(n|t|r|\\\\|\"|'|0|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.hemlock",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "template-strings": {
      "patterns": [
        {
          "name": "string.template.hemlock",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.template.expression.hemlock",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.template-expression.begin.hemlock" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.definition.template-expression.end.hemlock" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            },
            {
              "name": "constant.character.escape.hemlock",
              "match": "\\\\(n|t|r|\\\\|\"|'|0|`|\\$|u\\{[0-9a-fA-F]{1,6}\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.hemlock",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hemlock",
          "match": "\\b[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.hex.hemlock",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.hemlock",
          "match": "\\b0[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.hemlock",
          "match": "\\b0[oO][0-7][0-7_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.hemlock",
          "match": "\\+|\\-|\\*|\\/|%"
        },
        {
          "name": "keyword.operator.comparison.hemlock",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.hemlock",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.hemlock",
          "match": "&|\\||\\^|<<|>>|~"
        },
        {
          "name": "keyword.operator.assignment.hemlock",
          "match": "="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.hemlock",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.hemlock",
          "match": "\\b(print|write|eprint|read_line|typeof|alloc|free|memset|memcpy|realloc|talloc|sizeof|buffer|channel|open|exec|exec_argv|panic|assert|apply)\\b"
        },
        {
          "name": "support.function.async.hemlock",
          "match": "\\b(spawn|spawn_with|join|detach|select)\\b"
        },
        {
          "name": "support.function.stdlib.math.hemlock",
          "match": "\\b(sin|cos|tan|asin|acos|atan|atan2|sqrt|pow|exp|log|log10|log2|floor|ceil|round|trunc|floori|ceili|roundi|trunci|div|divi|abs|min|max|clamp|rand|rand_range|seed)\\b"
        },
        {
          "name": "support.function.stdlib.signal.hemlock",
          "match": "\\b(signal|raise)\\b"
        },
        {
          "name": "support.function.stdlib.time.hemlock",
          "match": "\\b(now|sleep|time_ms|clock|localtime|gmtime|mktime|strftime)\\b"
        },
        {
          "name": "support.function.stdlib.env.hemlock",
          "match": "\\b(getenv|setenv|unsetenv|get_pid)\\b"
        },
        {
          "name": "support.function.stdlib.net.hemlock",
          "match": "\\b(socket_create|dns_resolve|poll)\\b"
        },
        {
          "name": "support.function.memory.hemlock",
          "match": "\\b(ptr_read_i8|ptr_read_i16|ptr_read_i32|ptr_read_i64|ptr_read_u8|ptr_read_u16|ptr_read_u32|ptr_read_u64|ptr_read_f32|ptr_read_f64|ptr_read_ptr|ptr_write_i8|ptr_write_i16|ptr_write_i32|ptr_write_i64|ptr_write_u8|ptr_write_u16|ptr_write_u32|ptr_write_u64|ptr_write_f32|ptr_write_f64|ptr_write_ptr|ptr_offset|ptr_null|ptr_to_buffer|buffer_ptr|ffi_sizeof)\\b"
        },
        {
          "name": "support.function.atomic.hemlock",
          "match": "\\b(atomic_load_i32|atomic_store_i32|atomic_add_i32|atomic_sub_i32|atomic_and_i32|atomic_or_i32|atomic_xor_i32|atomic_cas_i32|atomic_exchange_i32|atomic_load_i64|atomic_store_i64|atomic_add_i64|atomic_sub_i64|atomic_and_i64|atomic_or_i64|atomic_xor_i64|atomic_cas_i64|atomic_exchange_i64|atomic_fence)\\b"
        }
      ]
    }
  }
}
