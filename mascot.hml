        "           " + FLOWER + "* * *" + RESET + "       " + LEAF + "/" + RESET + "         ",
        "          " + FLOWER + "* * * *" + RESET + "                ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + EYE + "^" + RESET + "   " + EYE + "^" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + YELLOW + "\\v/" + RESET + "   " + LEAF + "@@" + RESET + "             ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@@@@" + RESET + " " + LEAF + "@@@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "   " + STEM + "|||" + RESET + "   " + LEAF + "@@" + RESET + "            ",
        "           " + STEM + "|||" + RESET + "                 ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

fn frame_wave_2(): array {
    return [
        "                       " + LEAF + "__/" + RESET + "          ",
        "           " + FLOWER + "* * *" + RESET + "    " + LEAF + "/" + RESET + "            ",
        "          " + FLOWER + "* * * *" + RESET + "                ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
