// Hemlock Mascot Animation
// A friendly (but slightly mischievous) hemlock plant character

import {
    GREEN, BRIGHT_GREEN, YELLOW, CYAN, MAGENTA, WHITE, RED,
    BOLD, DIM, RESET, HIDE_CURSOR, SHOW_CURSOR,
    clear, move_to, rgb
} from "@stdlib/terminal";
import { sleep } from "@stdlib/time";

// ============================================================================
// HEMLOCK - The Mascot
// ============================================================================
// A cute hemlock plant with personality. Slightly toxic, very helpful.

// Color palette
let LEAF = BRIGHT_GREEN;
let STEM = GREEN;
let FLOWER = WHITE;
let EYE = YELLOW;
let PUPIL = CYAN;
let TOXIC = MAGENTA;

// ASCII Art Frames - Idle animation (breathing/swaying)
fn frame_idle_1(): array {
    return [
        "                                    ",
        "           " + FLOWER + "* * *" + RESET + "                 ",
        "          " + FLOWER + "* * * *" + RESET + "                ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + EYE + "o" + RESET + "   " + EYE + "o" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + RED + "\\-/" + RESET + "   " + LEAF + "@@" + RESET + "             ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@@@@" + RESET + " " + LEAF + "@@@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "   " + STEM + "|||" + RESET + "   " + LEAF + "@@" + RESET + "            ",
        "           " + STEM + "|||" + RESET + "                 ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

fn frame_idle_2(): array {
    return [
        "                                    ",
        "          " + FLOWER + " * * *" + RESET + "                 ",
        "         " + FLOWER + "* * * *" + RESET + "                 ",
        "        " + LEAF + ",@@@@@@@@@," + RESET + "              ",
        "       " + LEAF + "@@@" + RESET + "       " + LEAF + "@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "  " + EYE + "O" + RESET + "     " + EYE + "O" + RESET + "  " + LEAF + "@@" + RESET + "            ",
        "      " + LEAF + "@@" + RESET + "     " + STEM + "^" + RESET + "     " + LEAF + "@@" + RESET + "            ",
        "      " + LEAF + "@@" + RESET + "    " + RED + "\\-/" + RESET + "    " + LEAF + "@@" + RESET + "            ",
        "       " + LEAF + "@@@" + RESET + "       " + LEAF + "@@@" + RESET + "             ",
        "      " + LEAF + "@@@@@@" + RESET + " " + LEAF + "@@@@@@" + RESET + "            ",
        "     " + LEAF + "@@" + RESET + "    " + STEM + "|||" + RESET + "    " + LEAF + "@@" + RESET + "           ",
        "           " + STEM + "|||" + RESET + "                 ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

// Waving animation frames
