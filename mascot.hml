// Toxic/mischievous animation (for errors or unsafe operations)
fn frame_toxic_1(): array {
    return [
        "                                    ",
        "        " + TOXIC + "~" + RESET + "  " + FLOWER + "* * *" + RESET + "  " + TOXIC + "~" + RESET + "            ",
        "       " + TOXIC + "~" + RESET + "  " + FLOWER + "* * * *" + RESET + "  " + TOXIC + "~" + RESET + "           ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + TOXIC + ">" + RESET + "   " + TOXIC + "<" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + TOXIC + ":P" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@@@@" + RESET + " " + LEAF + "@@@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "   " + STEM + "|||" + RESET + "   " + LEAF + "@@" + RESET + "            ",
        "           " + STEM + "|||" + RESET + "                 ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

fn frame_toxic_2(): array {
    return [
        "      " + TOXIC + "~" + RESET + "                  " + TOXIC + "~" + RESET + "       ",
        "           " + FLOWER + "* * *" + RESET + "                 ",
        "       " + TOXIC + "~" + RESET + " " + FLOWER + "* * * *" + RESET + " " + TOXIC + "~" + RESET + "            ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + TOXIC + "<" + RESET + "   " + TOXIC + ">" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + TOXIC + ":P" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@@@@" + RESET + " " + LEAF + "@@@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "   " + STEM + "|||" + RESET + "   " + LEAF + "@@" + RESET + "            ",
        "           " + STEM + "|||" + RESET + "                 ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

// Speech bubble
fn speech_bubble(text: string): array {
    let padding = 2;
    let width = len(text) + padding * 2;
    let top = " " + "_".repeat(width) + " ";
    let middle = "| " + text + " |";
    let bottom = " " + "-".repeat(width) + " ";
    let pointer = "        \\/";

    return [top, middle, bottom, pointer];
}

// Render a frame to the terminal
fn render_frame(frame: array, start_row: i32) {
    let row = start_row;
    for (line in frame) {
        print("\x1b[" + row + ";1H" + line);
        row = row + 1;
    }
}

// Render speech bubble above mascot
fn render_speech(text: string, row: i32) {
    let bubble = speech_bubble(text);
    let r = row;
    for (line in bubble) {
        print("\x1b[" + r + ";5H" + CYAN + line + RESET);
        r = r + 1;
    }
}

// Main animation loop
fn animate() {
    print(HIDE_CURSOR);
    clear();

    let messages = [
        "Hello, I'm Hemlock!",
        "A small unsafe language...",
        "...for writing unsafe things safely!",
        "Manual memory? No problem!",
        "free() responsibly!",
        "Pointers are friends, not food!",
        "*slightly toxic*",
        "Type annotations? Optional!",
        "Semicolons REQUIRED though ;)",
        "Let's write some code!",
        "alloc() all the things!",
        "Runtime errors are features!",
        "Explicit > Implicit!",
        "I believe in you!"
    ];

    let frame_count = 0;
    let message_index = 0;
    let message_timer = 0;

    // Title
    print("\x1b[1;1H" + BOLD + GREEN + "  ╔═══════════════════════════════════════════╗" + RESET);
    print("\x1b[2;1H" + BOLD + GREEN + "  ║" + RESET + "     " + BRIGHT_GREEN + "HEMLOCK" + RESET + " - The Mascot               " + BOLD + GREEN + "║" + RESET);
    print("\x1b[3;1H" + BOLD + GREEN + "  ╚═══════════════════════════════════════════╝" + RESET);

    // Instructions
    print("\x1b[22;1H" + DIM + "  Press Ctrl+C to exit" + RESET);

    // Animation loop
    loop {
        let phase = frame_count % 100;

        // Choose animation based on phase
        if (phase < 20) {
            // Idle breathing
            if (phase % 10 < 5) {
                render_frame(frame_idle_1(), 8);
            } else {
                render_frame(frame_idle_2(), 8);
            }
        } else if (phase < 30) {
            // Blink
            if (phase == 20 || phase == 22) {
                render_frame(frame_blink(), 8);
            } else {
                render_frame(frame_idle_1(), 8);
            }
        } else if (phase < 50) {
            // Wave
            if (phase % 4 < 2) {
                render_frame(frame_wave_1(), 8);
            } else {
                render_frame(frame_wave_2(), 8);
            }
        } else if (phase < 60) {
            // Thinking
            if (phase % 6 < 3) {
                render_frame(frame_think_1(), 8);
            } else {
                render_frame(frame_think_2(), 8);
            }
        } else if (phase < 75) {
            // Excited
            if (phase % 4 < 2) {
                render_frame(frame_excited_1(), 8);
            } else {
                render_frame(frame_excited_2(), 8);
            }
        } else if (phase < 90) {
            // Toxic/mischievous
            if (phase % 6 < 3) {
                render_frame(frame_toxic_1(), 8);
            } else {
                render_frame(frame_toxic_2(), 8);
            }
        } else {
            // Back to idle
            render_frame(frame_idle_1(), 8);
        }

        // Update speech bubble
        message_timer = message_timer + 1;
        if (message_timer >= 25) {
            message_timer = 0;
            message_index = (message_index + 1) % len(messages);
        }
        render_speech(messages[message_index], 4);

        frame_count = frame_count + 1;
        sleep(0.1);
    }

    print(SHOW_CURSOR);
}

// Run the animation!
animate();
