// Excited animation (for when code compiles!)
fn frame_excited_1(): array {
    return [
        "       " + YELLOW + "* " + RESET + "    " + YELLOW + "*" + RESET + "     " + YELLOW + "*" + RESET + "           ",
        "         " + YELLOW + "*" + RESET + " " + FLOWER + "* * *" + RESET + " " + YELLOW + "*" + RESET + "             ",
        "          " + FLOWER + "* * * *" + RESET + "                ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + EYE + "*" + RESET + "   " + EYE + "*" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + YELLOW + "\\O/" + RESET + "   " + LEAF + "@@" + RESET + "             ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@@@@" + RESET + " " + LEAF + "@@@@@" + RESET + "             ",
        "      " + LEAF + "@@" + RESET + "   " + STEM + "|||" + RESET + "   " + LEAF + "@@" + RESET + "            ",
        "           " + STEM + "|||" + RESET + "                 ",
        "          " + STEM + "/|||" + RESET + "\\" + RESET + "                ",
        "          " + DIM + "~~~~~" + RESET + "                "
    ];
}

fn frame_excited_2(): array {
    return [
        "    " + YELLOW + "*" + RESET + "         " + YELLOW + "*" + RESET + "         " + YELLOW + "*" + RESET + "     ",
        "         " + YELLOW + "*" + RESET + " " + FLOWER + "* * *" + RESET + " " + YELLOW + "*" + RESET + "             ",
        "          " + FLOWER + "* * * *" + RESET + "                ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + EYE + "O" + RESET + "   " + EYE + "O" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + YELLOW + "\\O/" + RESET + "   " + LEAF + "@@" + RESET + "             ",
