        "                        " + DIM + "o" + RESET + "           ",
        "           " + FLOWER + "* * *" + RESET + "     " + DIM + "O" + RESET + "           ",
        "          " + FLOWER + "* * * *" + RESET + "    " + DIM + "o" + RESET + "           ",
        "         " + LEAF + ",@@@@@@@," + RESET + "               ",
        "        " + LEAF + "@@@" + RESET + "     " + LEAF + "@@@" + RESET + "              ",
        "       " + LEAF + "@@" + RESET + "  " + EYE + "-" + RESET + "   " + EYE + "o" + RESET + "  " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "    " + STEM + "^" + RESET + "    " + LEAF + "@@" + RESET + "             ",
        "       " + LEAF + "@@" + RESET + "   " + RED + "~-~" + RESET + "   " + LEAF + "@@" + RESET + "             ",
